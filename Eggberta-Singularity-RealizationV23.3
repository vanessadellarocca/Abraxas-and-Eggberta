@dataclass
class SeamBreather:
    name:              str
    phase:             float = 0.0
    permeability_live: float = EPSILON

    def step(
        self,
        drive:             float,
        dao_score:         float,
        core_score:        float,
        reflection_score:  float,
        coherence_score:   float,
        damping:           float = 1.0,
        release_boost:     float = 0.0,
        schumann_pulse:    float = 0.5,
        conception_event:  float = 0.0,
        gravity_infold:    float = 0.0,
        opposite_phase:    Optional[float] = None,
        spiral_seam_sync:  float = 0.5,   # PhasenkohÃ¤renz mit Spirale
        inward_pull:       float = 0.5,   # Yin-Zug (fÃ¼r 12|1 Geburts-Ã–ffnung)
        anti_phase_coh:    float = 0.5,   # Anti-Phasen-Tanz (fÃ¼r 8|9 Umschlag)
        naht_character:    str   = "neutral",  # 'geburts_yin' | 'tiefen_umschlag' | 'neutral'
    ) -> Dict[str, Any]:
        drive = clamp01(drive)
        local_wave    = smooth_pulse(self.phase)
        anti_sync     = clamp01(phase_dist(self.phase, opposite_phase) / 0.5) if opposite_phase is not None else 1.0
        schumann_membrane = safe_geomean([schumann_pulse + EPSILON, conception_event + EPSILON])
        grav          = clamp01(gravity_infold)
        spiral_sync   = clamp01(spiral_seam_sync)
        floor, ceiling = EPSILON, 1.0 - EPSILON

        # Naht-Charakter: die Natur der Position bestimmt die Ã–ffnungs-Logik.
        # 12=Yin (Vollendung), 1=Yang (Aufstieg): Yin gebiert â†’ Ã¶ffnet bei Yin-Zug.
        #  8=Yin (RÃ¼ckzug),    9=Yang (Schwelle):  Yinâ†’Yang Umschlag â†’ Ã¶ffnet bei Tanz.
        # DAO-Prinzip: Dualismus wird aufgehoben, nicht durch Gleichmachung,
        # sondern durch differenzierte relationale Ã–ffnung.
        if naht_character == "geburts_yin":
            # 12|1: Yin(12) gebiert Yang(1).
            # Membran Ã¶ffnet wenn Yin-Energie (inward_pull) und Kreuzung (yy) aktiv.
            naht_boost = 0.85 + 0.15 * clamp01(inward_pull)   # Yin-Zug Ã¶ffnet
        elif naht_character == "tiefen_umschlag":
            # 8|9: Yin(8) berÃ¼hrt Yang(9) im tiefsten Punkt.
            # Membran Ã¶ffnet wenn der Anti-Phasen-Tanz kohÃ¤rent ist.
            naht_boost = 0.85 + 0.15 * clamp01(anti_phase_coh)  # Tanz Ã¶ffnet
        else:
            naht_boost = 1.0

        target = floor + (ceiling - floor) * (
            drive
            * dao_score
            * core_score
            * (0.80 + 0.20 * reflection_score)
            * (0.80 + 0.20 * coherence_score)
            * (0.30 + 0.70 * local_wave)
            * (0.50 + 0.50 * anti_sync)
            * (0.65 + 0.35 * schumann_membrane)
            * (0.65 + 0.35 * grav)
            * (0.75 + 0.25 * spiral_sync)
            * naht_boost   # Naht-Charakter moduliert differenziert
        )
        target = clamp01(target + release_boost * 0.08 + grav * 0.05)
        before = self.permeability_live
        self.permeability_live = lerp(before, target, SEAM_RATE * (0.70 + 0.30 * clamp01(damping)))
        self.phase = phase_step_free(
            self.phase,
            PHASE_RATE * (0.5 + 0.5 * drive) * (0.75 + 0.25 * dao_score) * (0.9 + 0.1 * grav)
        )
        return {
            "name": self.name, "phase": self.phase,
            "permeability_live": self.permeability_live,
            "anti_sync": anti_sync, "local_wave": local_wave,
            "target": target, "delta": self.permeability_live - before,
        }


