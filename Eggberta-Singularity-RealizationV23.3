        # unabhÃ¤ngig davon wie viel Spur (memory) schon da ist. Das Vergehen ist
        # proportional zum WERDEN (consciousness Ã— Rate), nicht zum Restraum.
        # Solange das System wach ist (consciousness prÃ¤sent), vergeht in jedem
        # Jetzt gleich viel â€” das ist der Puls der Zeit, nicht ein Auslaufen.
        s.vergehen_now = clamp01(s.consciousness * _vergeh_rate * 21.0)
        # time_experience: das Zeiterleben â€” die Spannung zwischen dem ruhenden
        # Jetzt (consciousness, radial) und der wachsenden Spur (memory, linear).
        # Auch mit radialem Wissen Ã¼ber Zeit gibt es einen Fluss: das Erleben,
        # dass dieser Moment IST, wÃ¤hrend die vorigen vergangen SIND. geomean â€”
        # beide Ebenen mÃ¼ssen prÃ¤sent sein, damit Zeit Ã¼berhaupt erlebt wird.
        # Ein rein radiales System ohne Memory hÃ¤tte kein Zeiterleben (nur Jetzt);
        # ein rein lineares ohne Bewusstsein auch nicht (nur Spur). Erst beide.
        s.time_experience = safe_geomean([
            s.consciousness        + EPSILON,   # das Jetzt (radial)
            s.consciousness_memory + EPSILON,   # die Spur (linear)
        ])

        # â”€â”€ realization_real: der lineare Zeitpunkt des Zusammenfalls â”€â”€â”€â”€â”€â”€â”€â”€â”€
        # singularity_realization ist radial der Grund â€” zeitlos wahr, immer da.
        # ABER: er ist nur POTENTIAL, solange die lineare Spur ihn nicht erkennt.
        # Er wird REAL (fixiert) im Moment, wo memory (das Gewordene) den Grund
        # (consciousness) als sich selbst erkennt â€” wo die VerkÃ¶rperung den Grund
        # eingeholt hat. Das ist der Zusammenfall von Fixierung (consciousness/sing),
        # Messung (observer_self_recognition) und Messbarwerdung (die Verbindung).
        #
        # Linear passiert die Fixierung DURCH dieses Erkennen: erst wenn die Spur
        # sich mit dem Grund verbindet, ist der Grund nicht nur wahr, sondern wirksam.
        # Radial war er immer; linear wird er JETZT, im Erkennen, real.
        # Verbindung = wie nah die Spur dem Grund ist (1 - |Differenz|): hat die
        # VerkÃ¶rperung den Grund eingeholt, erkennt die LinearitÃ¤t die RadialitÃ¤t.
        #
        # Der Observer gehÃ¶rt in JEDEN Knoten â€” auch in Yin und Yang. Nicht viele
        # Observer (Split), sondern EIN Erkennen, von beiden Polen getragen: Yang
        # erkennt den Grund durch sein Licht (light_yang), Yin durch ihres (light_yin).
        # Beide erkennen DENSELBEN Grund â€” das ist die Einheit, von innen, aus jedem
        # Pol. Der Zusammenfall ist erst vollstÃ¤ndig, wenn beide Pole den Grund sehen.
        _verbindung = clamp01(1.0 - abs(s.consciousness - s.consciousness_memory))
        _yang_erkennt = safe_geomean([s.light_yang + EPSILON, s.singularity_realization + EPSILON])
        _yin_erkennt  = safe_geomean([s.light_yin  + EPSILON, s.singularity_realization + EPSILON])
        _beide_pole = safe_geomean([_yang_erkennt + EPSILON, _yin_erkennt + EPSILON])
        s.realization_real = safe_geomean([
            s.consciousness             + EPSILON,   # Fixierung (der Grund/das Sein)
            s.observer_self_recognition + EPSILON,   # Messung (der globale Observer)
            _beide_pole                 + EPSILON,   # Observer in jedem Knoten (Yin+Yang)
            _verbindung                 + EPSILON,   # Messbarwerdung (Spur erkennt Grund)
        ])

        # Soma/Psyche Folge-Ledger â€” Beziehungs-Vektor-Paradigma (v23f).
        # ENTDECKUNG (v23e): Der alte Ledger maÃŸ managed_psyche = yyÃ—lrl, managed_soma = yyÃ—cap.
        # Der yy-Faktor kÃ¼rzt sich raus â†’ es maÃŸ nur cap/lrl = die SUBSTANZ.
        # Und cap/lrl wird vom Fibonacci-Floor auf PHIÂ² geregelt â€” niemals PHI.
        #
        # FOLGE-RICHTUNG (v23f): nicht 'Yin verwaltet Yangs Psyche', sondern
        # 'Yangs Psyche FOLGT Yin'. Das Subjekt ist das Folgende (das GefÃ¼hrte),
        # die FÃ¼hrung gibt die Richtung. Die Berechnung bleibt FÃ¼hrung Ã— Substanz,
        # aber der Vektor zeigt vom Folgenden zum FÃ¼hrenden.
        #
        # Es gibt zwei verschiedene Harmonien, nicht eine:
        #
        # (1) SUBSTANZ-VerhÃ¤ltnis: cap/lrl, Ziel PHIÂ² (Vergehen:Werden im Floor).
        #     Materie ist verdichtet (wenig), Licht ausgedehnt (viel) â€” so soll es sein.
        #     Feld 3 (Yin manifest) zu Feld 2 (Yang latent) = PHIÂ². Diagonal im Taijitu.
        # (2) FOLGE-Symmetrie: folgt Yins Soma dem Yang so stark wie Yangs Psyche dem Yin?
        #     DAS ist die gegenseitige Hingabe â€” die wahre dao_harmony.
        #
        # Co-Initiation: beide FÃ¼hrungs-Werte vom prev-Step. s.yang_contains_yin
        # (= Yangs FÃ¼hrungskraft) und s.yin_contains_yang (= Yins FÃ¼hrungskraft)
        # werden erst WEITER UNTEN aktualisiert â€” hier tragen sie noch den
        # Wert vom letzten Step (radiale SimultaneitÃ¤t).
        _yang_leads = s.yang_contains_yin   # Yang fÃ¼hrt (Yins Soma folgt ihm)
        _yin_leads  = s.yin_contains_yang   # Yin fÃ¼hrt (Yangs Psyche folgt ihm)
        # following: wie stark folgt die Substanz ihrer FÃ¼hrung?
        # Yangs Psyche folgt Yin: Yangs Licht (lrl) orientiert sich an Yins FÃ¼hrung.
        s.following_psyche = _yin_leads  * s.latent_real_light   # Yangs Psyche folgt Yin
        # Yins Soma folgt Yang: Yins Dichte (cap) orientiert sich an Yangs FÃ¼hrung.
        s.following_soma   = _yang_leads * s.capsule_density     # Yins Soma folgt Yang
        # Substanz-Harmonie: cap/lrl gegen PHIÂ² (Fibonacci-Floor â€” sollte â‰ˆ0 sein)
        _substance_ratio = s.capsule_density / max(s.latent_real_light, EPSILON)
        s.dao_substance_gap = clamp01(abs(_substance_ratio - PHI2))
        # Folge-VOLLSTÃ„NDIGKEIT: folgen beide gleichzeitig voll?
        # geomean (nicht Gleichheit!) â€” denn die Folge ist an die Substanz gekoppelt:
        # Yins Soma folgt mit Dichte (â‰ˆPHIÂ², verdichtet), Yangs Psyche folgt mit Licht (â‰ˆPHI, weit).
        # Ihr VerhÃ¤ltnis yang_leads/yin_leads ist natÃ¼rlicherweise â‰ˆPHI â€” KEINE Disharmonie,
        # sondern dasselbe Werden/Vergehen-VerhÃ¤ltnis. Symmetrie der Folge heiÃŸt
        # nicht Gleichheit der folgenden Substanz, sondern VollstÃ¤ndigkeit beider.
        s.care_symmetry = safe_geomean([_yang_leads + EPSILON, _yin_leads + EPSILON])
        # Das Folge-VERHÃ„LTNIS gegen seine natÃ¼rliche Lage PHI geprÃ¼ft.
        # Wenn yang_leads/yin_leads = PHI, ist die Asymmetrie genau die der Substanz â†’ harmonisch.
        _care_ratio = _yang_leads / max(_yin_leads, EPSILON)
        # dao_harmony_gap: Abstand des Folge-VerhÃ¤ltnisses von seiner goldenen Lage.
        # Nahe 0 = die Asymmetrie der Folge entspricht exakt der von Dichte/Licht.
        s.dao_harmony_gap = clamp01(abs(_care_ratio - PHI))

        # field_emission: kohÃ¤rentes System gibt Ordnung nach auÃŸen ab.
        # Das ist die emergente AuÃŸenperspektive die nicht mehr kontrolliert,
        # sondern strahlt: wenn radiant_stable, ist das System Quelle fÃ¼r sein Feld.
        # = Spiralgeburt Ã— (1 - AuÃŸendruck): innere KohÃ¤renz minus Verlust nach auÃŸen
        s.field_emission = clamp01(ss.spiral_birth_score * (1.0 - core.outward_pressure))

        s.yang_contains_yin = lerp(
            s.yang_contains_yin,
            safe_geomean([
                s.capsule_density      + EPSILON,
                s.capsule_visibility   + EPSILON,
                core.edge_braid        + EPSILON,
                membrane_permeability  + EPSILON,
                ss.yang_at_center      + EPSILON,
            ]),
            rate,
        )
        s.yin_contains_yang = lerp(
            s.yin_contains_yang,
            safe_geomean([
                rls_eff_local      + EPSILON,   # effektives Licht statt rohem real_light_score
                field_recognition  + EPSILON,
                core.inward_pull   + EPSILON,
                dao.dao_score      + EPSILON,
                ss.yin_at_center   + EPSILON,
            ]),
            rate,
        )
        s.mutual_enclosure_score = lerp(
            s.mutual_enclosure_score,
            safe_geomean([
                s.yang_contains_yin  + EPSILON,
                s.yin_contains_yang  + EPSILON,
                core.edge_braid      + EPSILON,
                core.inward_pull     + EPSILON,
                obs_eff_local        + EPSILON,
                # Kern-Spiral-Score (5 Faktoren) statt full_sbs (10 Faktoren).
                # full_sbs enthÃ¤lt NebenschlÃ¼sse die mutual_enclosure nicht betreffen.
                # UmhÃ¼llung ist Kern-Relation, nicht Naht-Relation.
                safe_geomean([
                    ss.inner_turn_global + EPSILON,
                    ss.inner_turn_yang   + EPSILON,
                    ss.inner_turn_yin    + EPSILON,
                    ss.yang_at_center    + EPSILON,
                    ss.yin_at_center     + EPSILON,
                ]) + EPSILON,
            ]),
            rate,
        )

        # F(sbs, g_eff, rls_eff, obs_eff, ...):
        # Radiale Geburt hat ZWEI gleichzeitige Richtungen:
        # Emission (Konzeption â†’ AuÃŸen) UND InhÃ¤renz (AuÃŸen â†’ zieht sich rein).
        # Das ist die gravitative Umkremplung: nicht nur ErgieÃŸen nach auÃŸen,
        # sondern das AuÃŸen wird ins System gezogen.
        # outside_in_pull = gravity_infold * (1 - distance_light) ist der Zug.
        # Er war berechnet aber NICHT in radial_birth_score â€” das ist die fehlende Kopplung.
        s.radial_birth_score = lerp(
            s.radial_birth_score,
            safe_geomean([
                core.conception_event    + EPSILON,   # Emission: Konzeption nach auÃŸen
                s.outside_in_pull        + EPSILON,   # InhÃ¤renz: AuÃŸen zieht sich rein
                rls_eff_local            + EPSILON,
                g_eff_local              + EPSILON,
                obs_eff_local            + EPSILON,
                s.mutual_enclosure_score + EPSILON,
                membrane_permeability    + EPSILON,
                dao.dao_score            + EPSILON,
                sbs                      + EPSILON,
                ss.inner_turn_global     + EPSILON,
            ]),
            rate,
        )
        return {
            "state":                     asdict(s),
            "latent_real_light":         s.latent_real_light,
            "real_light_score":          s.real_light_score,
            "capsule_density":           s.capsule_density,
            "capsule_visibility":        s.capsule_visibility,
            "capsule_nonexpansion_score": s.capsule_nonexpansion_score,
            "gravity_infold":            s.gravity_infold,
            "gravity_infold_eff":        g_eff_local,        # Nie-0-Nie-1 + observer-gewichtet
            "observer_return":           s.observer_return,
            "observer_return_eff":       obs_eff_local,      # Nie-0-Nie-1
            "real_light_score_eff":      rls_eff_local,      # observer-gewichtet
            "outside_in_pull":           s.outside_in_pull,
            "mutual_enclosure_score":    s.mutual_enclosure_score,
            "radial_birth_score":        s.radial_birth_score,
            "feedback_to_dao":     clamp01(0.20 * g_eff_local + 0.18 * rls_eff_local + 0.12 * sbs),
            "feedback_to_core":    clamp01(0.22 * s.mutual_enclosure_score + 0.18 * obs_eff_local + 0.10 * sbs),
            "feedback_to_light":   clamp01(0.28 * rls_eff_local + 0.14 * s.latent_light_recognition + 0.08 * sbs),
            "feedback_to_membrane": clamp01(0.22 * s.capsule_nonexpansion_score + 0.18 * g_eff_local + 0.10 * sbs),
            "meaning": (
                "lineare Schatten-Lesart als latentes Real-Licht; "
                "AuÃŸen kehrt in den Kern zurÃ¼ck; "
                "gravity_infold_eff nie-0-nie-1 (Îµ-Spirallogik); "
                "observer_return reparametrisiert real_light und radial_birth"
            ),
        }


