    g_n01   = EPSILON + (1.0 - 2.0*EPSILON) * clamp01(gravity_infold)
    g_eff   = clamp01(g_n01 * (PHI + (1.0-PHI)*clamp01(observer_return)))
    return safe_geomean([
        obs_eff                      + EPSILON,
        clamp01(membrane_opening)    + EPSILON,
        clamp01(seam_sync)           + EPSILON,
        clamp01(dao_bridge)          + EPSILON,
        g_eff                        + EPSILON,
    ])

def clamp_open(x: float, low: float, high: float, eps: float = EPSILON) -> float:
    return max(low + eps, min(high - eps, float(x)))

def normalize_centered(x: float, center: float, radius: float) -> float:
    return clamp11((float(x) - float(center)) / max(float(radius), EPS))

def phase_step_free(current: float, rate: float) -> float:
    return (float(current) + float(rate)) % 1.0

def phase_delta(current: float, target: float) -> float:
    delta = (float(target) - float(current)) % 1.0
    if delta > 0.5:
        delta -= 1.0
    return delta

def phase_toward(current: float, target: float, rate: float) -> float:
    return (float(current) + clamp01(rate) * phase_delta(current, target)) % 1.0

def phase_dist(a: float, b: float) -> float:
    d = abs((float(a) - float(b)) % 1.0)
    return min(d, 1.0 - d)

def map_yang_to_yin(x: float) -> float:
    return float(x) + YANG_TO_YIN_OFFSET

def map_yin_to_yang(x: float) -> float:
    return float(x) - YANG_TO_YIN_OFFSET

def kuramoto_order(phases: List[float]) -> float:
    if not phases:
        return 0.0
    n = len(phases)
    c = sum(math.cos(2.0 * math.pi * p) for p in phases) / n
    s = sum(math.sin(2.0 * math.pi * p) for p in phases) / n
    return math.sqrt(c * c + s * s)

def triangular(n: int) -> int:
    return n * (n + 1) // 2


