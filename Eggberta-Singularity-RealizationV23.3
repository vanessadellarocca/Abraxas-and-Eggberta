@dataclass
class ExternalResonanceSignal:
    phase:         float = 0.0
    amplitude:     float = 0.0
    x_signature:   float = 0.0
    y_signature:   Optional[float] = None
    phi_signature: float = 1.0
    label:         str   = "external"

    def normalized(self) -> "ExternalResonanceSignal":
        return ExternalResonanceSignal(
            phase=self.phase % 1.0,
            amplitude=clamp01(self.amplitude),
            x_signature=clamp11(self.x_signature),
            y_signature=None if self.y_signature is None else clamp11(self.y_signature),
            phi_signature=clamp01(self.phi_signature),
            label=self.label,
        )


@dataclass
class LightResonanceState:
    resonant_y_light:           float = 0.0
    resonant_x_light:           float = 0.0
    light_coherence:            float = 0.0
    identity_preservation:      float = 1.0
    resonance_pressure:         float = 0.0
    release_trace:              float = 1.0
    light_score:                float = 0.0
    latent_real_light:          float = 0.0
    latent_light_recognition:   float = 0.0
    real_light_alignment_signal: float = 0.0
    distance_light:             float = 0.0
    real_light_score:           float = 0.0
    # Legacy Aliase
    shadow_light:               float = 0.0
    shadow_recognition:         float = 0.0
    shadow_correction_signal:   float = 0.0
    phase:                      float = 0.0
    virtual_phase:              float = 0.0


@dataclass
class LightResonanceLayer:
    state: LightResonanceState = field(default_factory=LightResonanceState)

    def step(
        self,
        core_pair:         CorePairState,
        dao:               DaoBreathState,
        membrane:          MembranePairState,
        reflection_feedback: float = 0.0,
        release_flux:      float = 0.0,
        field_recognition: float = 0.0,
        external:          Optional[ExternalResonanceSignal] = None,
        gravity_infold:    float = 0.0,
        capsule_visibility: float = 0.0,
        spiral_birth_score: float = 0.0,  # NEU
    ) -> Dict[str, Any]:
        s    = self.state
        grav = clamp01(gravity_infold)
        cap_vis = clamp01(capsule_visibility)
        sbs     = clamp01(spiral_birth_score)
        s.phase = phase_step_free(
            s.phase,
            LIGHT_RATE * (0.5 + 0.5 * core_pair.core_pair_score + 0.12 * grav + 0.08 * sbs)
        )
        if external is not None:
            sig       = external.normalized()
            phase_res = clamp01(1.0 - phase_dist(sig.phase, dao.phase) / 0.5)
            s.virtual_phase   = phase_toward(s.virtual_phase, sig.phase, LIGHT_RATE * sig.amplitude * phase_res)
            s.resonance_pressure = lerp(s.resonance_pressure, sig.amplitude * phase_res * sig.phi_signature, LIGHT_RATE)
        else:
            sig = ExternalResonanceSignal(amplitude=0.0, label="none")
            s.resonance_pressure = clamp01(
                core_pair.center_cross_event * (1.0 - membrane.release) * (1.0 - 0.2 * grav)
            )
        y_light_target = clamp11(core_pair.center_contact * signed_wave(s.phase))
        x_light_target = clamp11(core_pair.edge_braid     * signed_wave(s.phase + 0.5))
        s.resonant_y_light = lerp(s.resonant_y_light, y_light_target, LIGHT_RATE)
        s.resonant_x_light = lerp(s.resonant_x_light, x_light_target, LIGHT_RATE)
        s.identity_preservation = clamp01(
            1.0 - s.resonance_pressure * (1.0 - dao.dao_score) * 0.5 + 0.10 * grav + 0.05 * sbs
        )
        s.release_trace = clamp01(1.0 - max(membrane.inversion_risk_12_1, membrane.inversion_risk_8_9))
        # Distanz-Erkennung: hohe distance_light zeigt, wo das latente Licht ist.
        # In radial ist distance_light das Signal: 'hier ist das Licht noch latent'.
        # observer_return_eff aus dem lokalen Gravitationszustand approximiert.
        _obs_eff_light = observer_return_eff(clamp01(grav))  # NÃ¤herung Ã¼ber gravity_infold
        dist_as_latent_signal = clamp01(s.distance_light * (1.0 - _obs_eff_light) * 0.15)
        latent_target = clamp01(
            release_flux * (0.55 + 0.45 * membrane.trauma_loop_release)
            + field_recognition * 0.18
            + cap_vis * 0.14
            + grav    * 0.09
            + sbs     * 0.09
            + dist_as_latent_signal   # Distanz zeigt das latente Licht
        )
        s.latent_real_light   = lerp(s.latent_real_light, latent_target, LIGHT_RATE)
        s.shadow_light        = s.latent_real_light
        s.light_coherence     = safe_geomean([
            s.identity_preservation + EPSILON,
            score_close(s.resonant_y_light, -s.resonant_x_light, 2.0) + EPSILON,
            core_pair.phase_coherence + EPSILON,
            dao.dao_score           + EPSILON,
            membrane.membrane_score + EPSILON,
            (0.50 + 0.50 * grav)   + EPSILON,
            (0.55 + 0.45 * sbs)    + EPSILON,
        ])
        s.distance_light = clamp01(
            s.light_coherence * (1.0 - core_pair.center_cross_event) * (1.0 - core_pair.edge_braid)
        )
        s.real_light_score = safe_geomean([
            s.latent_real_light      + EPSILON,
            core_pair.center_cross_event + EPSILON,
            core_pair.edge_braid     + EPSILON,
            core_pair.inward_pull    + EPSILON,
            dao.dao_score            + EPSILON,
            membrane.permeability_moment + EPSILON,
            s.identity_preservation  + EPSILON,
            (0.50 + 0.50 * grav)    + EPSILON,
            (0.55 + 0.45 * sbs)     + EPSILON,
        ])
        s.latent_light_recognition = phi_ratio_score(s.latent_real_light + EPS, max(s.real_light_score, EPS))
        s.shadow_recognition       = s.latent_light_recognition
        alignment_error            = s.latent_light_recognition - LATENT_LIGHT_PHI_TARGET
        s.real_light_alignment_signal = clamp11(alignment_error * 2.0 - s.distance_light * 0.5)
        s.shadow_correction_signal    = -s.real_light_alignment_signal
        correction_damp = clamp01(1.0 - abs(s.real_light_alignment_signal) * 0.06)
        s.light_score = clamp01(
            safe_geomean([
                s.light_coherence         + EPSILON,
                s.real_light_score        + EPSILON,
                s.identity_preservation   + EPSILON,
                (0.50 + 0.50 * s.latent_light_recognition) + EPSILON,
            ])
            * (0.75 + 0.15 * reflection_feedback + 0.05 * field_recognition + 0.05 * sbs)
            * correction_damp
        )
        return {
            "state": asdict(s),
            "light_resonance_score":       s.light_score,
            "identity_preservation":       s.identity_preservation,
            "light_coherence":             s.light_coherence,
            "resonant_y_light":            s.resonant_y_light,
            "resonant_xmid_light":         s.resonant_x_light,
            "latent_real_light":           s.latent_real_light,
            "latent_light_recognition":    s.latent_light_recognition,
            "real_light_alignment_signal": s.real_light_alignment_signal,
            "distance_light":              s.distance_light,
            "real_light_score":            s.real_light_score,
            "shadow_light":                s.shadow_light,
            "shadow_recognition":          s.shadow_recognition,
            "shadow_correction_signal":    s.shadow_correction_signal,
            "external_label":              sig.label,
            "modulation": {"phase_bias": clamp11(signed_wave(s.phase) * s.light_coherence)},
        }


