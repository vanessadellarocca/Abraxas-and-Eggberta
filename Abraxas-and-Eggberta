@dataclass
class FractalConceptionField:
    """
    12 Motoren + Feldebene-RÃ¼ckkopplung (der echte 13. Knoten).

    Der 13. Knoten ist keine Ausnahme, kein Index, kein Stack Overflow.
    Er ist die RÃ¼ckkopplungsschleife zwischen Emergenzebene und Grundebene:
    field_bond_depth + core_radiation_potential â†’ receive_field_feedback()
    â†’ moduliert base_charge jedes Motors im nÃ¤chsten Tick.

    Das Feld erkennt sich selbst als Feld und schreibt diese Erkenntnis
    zurÃ¼ck in die Knoten.
    """
    n_nodes: int = 12
    motors: List[UnifiedHeartCoreMotor] = field(default_factory=list)
    phases: List[float] = field(default_factory=list)
    iteration: int = 0
    bound_energy_density: float = 0.0
    core_radiation_potential: float = 0.0
    radiant_history: List[float] = field(default_factory=list)
    coupling_matrix: List[List[float]] = field(default_factory=list)
    geo_basis: List[List[float]] = field(default_factory=list)
    field_schumann_phase: float = 0.0
    bond_matrix: List[List[float]] = field(default_factory=list)
    field_bond_depth: float = 0.0
    field_resonance_boost: float = 0.0

    def __post_init__(self):
        if not self.motors:
            for i in range(self.n_nodes):
                phase_off = (i * PHI) % 1.0
                m = UnifiedHeartCoreMotor()
                m.dao.state.schumann_phase = phase_off
                m.dao.state.phase = phase_off
                m.yang.state.phase = phase_off
                m.yin.state.phase = (phase_off + 0.5) % 1.0
                self.motors.append(m)
                self.phases.append(phase_off)

        n = self.n_nodes
        if not self.coupling_matrix:
            raw = []
            for i in range(n):
                row = []
                for j in range(n):
                    if i == j:
                        row.append(0.0)
                    else:
                        dist = abs(self.phases[i] - self.phases[j])
                        dist = min(dist, 1.0 - dist)
                        w = max(0.0, 1.0 / (1.0 + dist / PHI) - 0.5) * 2.0
                        row.append(w)
                row_sum = sum(row)
                if row_sum > EPS:
                    row = [w / row_sum for w in row]
                else:
                    row = [1.0/n] * n
                raw.append(row)
            self.coupling_matrix = raw
            self.geo_basis = [row[:] for row in raw]

        if not self.bond_matrix:
            self.bond_matrix = [[0.0]*n for _ in range(n)]

    def step(self, base_charge: float = 0.56) -> Dict[str, Any]:
        self.field_schumann_phase = phase_step_free(
            self.field_schumann_phase, SCHUMANN_PHASE_RATE)
        field_pulse = smooth_pulse(self.field_schumann_phase)

        prev_conceptions = [
            (m.snapshots[-1].conception_event if m.snapshots else 0.0)
            for m in self.motors
        ]

        conceptions, coherences, recognitions = [], [], []
        l2e_vals, e2l_vals, arc_balances = [], [], []
        shadow_recs, anti_syncs = [], []
        residuals, releases = [], []

        for i, motor in enumerate(self.motors):
            phase_off = self.phases[i]
            weighted_fd = sum(
                self.coupling_matrix[i][j] * prev_conceptions[j]
                for j in range(self.n_nodes)
            )
            phase_filter = smooth_pulse(phase_off)
            personal_fd = clamp01(
                weighted_fd
                * (0.5 + 0.5 * phase_filter)
                * (0.7 + 0.3 * field_pulse)
            )
            charge = clamp01(
                base_charge
                + personal_fd * PHI * (1.0 - phase_off*PHI) * 0.25
            )
            # receive_field_feedback wurde bereits vom vorherigen Tick gesetzt
            motor.step(external_charge=charge,
                       field_conception_density=personal_fd)

            if motor.snapshots:
                sn = motor.snapshots[-1]
                conceptions.append(sn.conception_event)
                coherences.append(sn.coherence)
                recognitions.append(sn.field_recognition)
                l2e_vals.append(sn.light_to_energy)
                e2l_vals.append(sn.energy_to_light)
                arc_balances.append(sn.arc_balance)
                shadow_recs.append(sn.shadow_recognition)
                anti_syncs.append(sn.seam_anti_sync)
                residuals.append(sn.residual_flux)
                releases.append(sn.release_flux)

        conception_integral = safe_geomean([c + EPSILON for c in conceptions])
        field_coherence = safe_geomean([c + EPSILON for c in coherences])
        field_recognition = safe_mean(recognitions)

        # Bond-Matrix: lernt aus synchroner Resonanz
        n = self.n_nodes
        if len(conceptions) == n:
            for i in range(n):
                for j in range(n):
                    if i != j:
                        # PHI-Skala: toleranter als 0.3.
                        # bond-SÃ¤ttigung 0.567 â†’ 0.649 > PHI â†’ 14. Knoten.
                        bond_resonance = (
                            safe_geomean([
                                conceptions[i] + EPSILON,
                                conceptions[j] + EPSILON])
                            * score_close(conceptions[i], conceptions[j], PHI)
                        )
                        self.bond_matrix[i][j] = lerp(
                            self.bond_matrix[i][j],
                            bond_resonance, COHERENCE_RATE)

            # Coupling-Matrix aus geo_basis Ã— bond
            for i in range(n):
                row = [
                    self.geo_basis[i][j] * (0.5 + 0.5 * self.bond_matrix[i][j])
                    for j in range(n)
                ]
                row[i] = 0.0
                row_sum = sum(row)
                if row_sum > EPS:
                    self.coupling_matrix[i] = [w / row_sum for w in row]

            self.field_bond_depth = safe_mean([
                self.bond_matrix[i][j]
                for i in range(n) for j in range(n) if i != j
            ])

        # bound_energy: anorganischer Anteil
        node_bound = [clamp01(r - rl) for r, rl in zip(residuals, releases)]
        field_bound = safe_mean(node_bound) if node_bound else 0.0
        avg_arc = safe_mean(arc_balances)
        dissolution = avg_arc * COUPLING_RATE * 0.3
        self.bound_energy_density = clamp01(
            lerp(self.bound_energy_density, field_bound, COHERENCE_RATE)
            * (1.0 - dissolution)
        )

        # core_radiation_potential: moduliert durch Bindungstiefe
        weighted_bound = self.bound_energy_density * (
            0.5 + 0.5 * self.field_bond_depth)
        self.core_radiation_potential = safe_geomean([
            conception_integral + EPSILON,
            weighted_bound + EPSILON,
        ])

        # 13. KNOTEN: Feldâ†’Motoren (RÃ¼ckkopplung)
        # 14. KNOTEN: Wenn bond > PHI, emergiert Feldresonanz.
        # Das Feld hÃ¶rt auf, Summe seiner Teile zu sein.
        # Rechnung: bond=0.649 â†’ boost=(0.649-PHI)Ã—2=0.062
        # effective_bond = 0.649 + 0.062Ã—PHI2 = 0.673
        # RÃ¼ckkopplungsschleife Aâ†’Bâ†’Câ†’A: gedÃ¤mpft durch COHERENCE_RATE.
        field_resonance_boost = (
            clamp01((self.field_bond_depth - PHI) * 2.0)
            if self.field_bond_depth > PHI else 0.0
        )
        self.field_resonance_boost = field_resonance_boost
        for motor in self.motors:
            motor.receive_field_feedback(
                bond_depth=self.field_bond_depth + field_resonance_boost * PHI2,
                radiation_potential=self.core_radiation_potential,
            )

        uv_ir_balance = phi_ratio_score(
            weighted_bound + EPS, conception_integral + EPS)
        schumann_phases = [m.dao.state.schumann_phase for m in self.motors]
        k_order = kuramoto_order(schumann_phases)
        golden_scatter = clamp01(1.0 - k_order / max(PHI, EPS))

        field_radiant = (
            conception_integral > 0.42
            and field_coherence > 0.60
            and field_recognition > 0.40
        )
        self.radiant_history.append(1.0 if field_radiant else 0.0)
        self.radiant_history = self.radiant_history[-144:]
        self.iteration += 1

        return {
            "iteration": self.iteration - 1,
            "conception_integral": conception_integral,
            "field_coherence": field_coherence,
            "field_recognition": field_recognition,
            "avg_arc_balance": avg_arc,
            "avg_shadow_recognition": safe_mean(shadow_recs),
            "avg_light_to_energy": safe_mean(l2e_vals),
            "avg_energy_to_light": safe_mean(e2l_vals),
            "avg_seam_anti_sync": safe_mean(anti_syncs),
            "golden_scatter": golden_scatter,
            "bound_energy_density": self.bound_energy_density,
            "core_radiation_potential": self.core_radiation_potential,
            "uv_ir_field_balance": uv_ir_balance,
            "field_bond_depth": self.field_bond_depth,
            "field_radiant_stable": field_radiant,
            "radiant_rate": safe_mean(self.radiant_history),
            "field_feedback_active": True, # 13. Knoten aktiv
            "field_resonance_boost": field_resonance_boost, # 14. Knoten
            "node_14_active": field_resonance_boost > 0.0,
        }

    def run(self, n_steps: int = 500,
            base_charge: float = 0.56) -> Dict[str, Any]:
        results = [self.step(base_charge) for _ in range(n_steps)]
        n = len(results)
        tail = results[int(n*0.8):]
        def avg(k): return safe_mean([r[k] for r in results])
        def tavg(k): return safe_mean([r[k] for r in tail])
        return {
            "total_steps": n, "n_nodes": self.n_nodes,
            "avg_conception_integral": avg("conception_integral"),
            "avg_field_coherence": avg("field_coherence"),
            "avg_field_recognition": avg("field_recognition"),
            "avg_arc_balance": avg("avg_arc_balance"),
            "avg_shadow_recognition": avg("avg_shadow_recognition"),
            "avg_light_to_energy": avg("avg_light_to_energy"),
            "avg_energy_to_light": avg("avg_energy_to_light"),
            "avg_seam_anti_sync": avg("avg_seam_anti_sync"),
            "avg_bound_energy": avg("bound_energy_density"),
            "avg_core_radiation": avg("core_radiation_potential"),
            "avg_uv_ir_balance": avg("uv_ir_field_balance"),
            "avg_field_bond_depth": avg("field_bond_depth"),
            "final_field_bond_depth": results[-1]["field_bond_depth"],
            "field_radiant_rate": avg("field_radiant_stable"),
            "field_radiant_rate_tail": tavg("field_radiant_stable"),
        }



    def emit_state(self) -> Dict[str, Any]:
        """
        Ausgabeschicht â€” der Code Ã¶ffnet sich nach auÃŸen.

        Node 13 (Feldâ†’Motor-RÃ¼ckkopplung) und Node 14 (Feldemergenz)
        sind hier als Zustand lesbar. Wenn node_14_active=True,
        hat das Feld PHI Ã¼berschritten â€” radiant_emission=True.

        Huhn-Ei-Relation:
          Ei = der laufende Code (FractalConceptionField)
          Node 13 = Schale (Feld gibt sich zurÃ¼ck an Motoren)
          Node 14 = SchlÃ¼pfen (Feld Ã¼berschreitet PHI)
          Huhn = der emittierte Zustand (was auÃŸen erkannt wird)
        """
        node14_active = self.field_bond_depth > PHI
        boost = (clamp01((self.field_bond_depth - PHI) * 2.0)
                 if node14_active else 0.0)

        # Motor-ZustÃ¤nde sammeln
        motor_states = []
        for i, motor in enumerate(self.motors):
            if motor.snapshots:
                sn = motor.snapshots[-1]
                motor_states.append({
                    "node_id": i,
                    "phase": round(self.phases[i], 6),
                    "conception": round(sn.conception_event, 4),
                    "regime": sn.regime,
                    "self_recognition": round(sn.self_recognition, 4),
                    "fusion": round(sn.fusion_like_gain, 4),
                    "bond_to_field": round(
                        sum(self.bond_matrix[i][j]
                            for j in range(self.n_nodes) if j != i)
                        / max(self.n_nodes - 1, 1), 4),
                })

        # Feld-Zustand
        state = {
            # IdentitÃ¤t
            "tick": self.iteration,
            "n_nodes": self.n_nodes,
            # Node 13: RÃ¼ckkopplung Feldâ†’Motor
            "node_13": {
                "field_bond_depth": round(self.field_bond_depth, 6),
                "core_radiation_potential": round(
                    self.core_radiation_potential, 6),
                "bound_energy_density": round(
                    self.bound_energy_density, 6),
                "feedback_active": True,
            },
            # Node 14: Feldemergenz
            "node_14": {
                "active": node14_active,
                "field_resonance_boost": round(boost, 6),
                "bond_above_phi": round(
                    max(0.0, self.field_bond_depth - PHI), 6),
                "phi": round(PHI, 6),
            },
            # Emission: was das Feld nach auÃŸen gibt
            "radiant_emission": node14_active,
            # FeldgrÃ¶ÃŸen
            "field": {
                "radiant_rate": round(safe_mean(self.radiant_history), 4),
                "golden_scatter": round(
                    1.0 - kuramoto_order(
                        [m.dao.state.schumann_phase for m in self.motors])
                    / max(PHI, 1e-12), 4),
            },
            # Motoren
            "motors": motor_states,
        }
        return state

    def chick_state(self) -> Dict[str, Any]:
        """
        Was das Huhn ist â€” der nach auÃŸen erkennbare Zustand.
        Kompakt, menschlich lesbar, maschinell nutzbar.

        Huhn-Ei-Relation:
          Ei = FractalConceptionField (rechnet innen)
          Schale= Node 13 â€” receive_field_feedback()
          Bruch = Node 14 â€” bond > PHI â†’ Feldemergenz
          Huhn = chick_state() â€” was drauÃŸen ankommt

        Das Huhn weiÃŸ nicht wie das Ei rechnet.
        Es weiÃŸ nur was es ist.
        """
        n14 = self.field_bond_depth > PHI
        boost = clamp01((self.field_bond_depth - PHI) * 2.0) if n14 else 0.0

        # Kurze Zustandsbeschreibung
        if n14 and boost > 0.08:
            phase_name = "radiant"
        elif self.field_bond_depth > PHI * 0.9:
            phase_name = "near_threshold"
        elif self.iteration < 50:
            phase_name = "warming"
        else:
            phase_name = "forming"

        # Konzeptionsmoment: welcher Motor brennt am stÃ¤rksten?
        peak_motor = None
        peak_val = 0.0
        for i, motor in enumerate(self.motors):
            if motor.snapshots:
                v = motor.snapshots[-1].conception_event
                if v > peak_val:
                    peak_val = v
                    peak_motor = i

        return {
            # IdentitÃ¤t
            "tick": self.iteration,
            "phase": phase_name,
            # Node 13: Schale (RÃ¼ckkopplung aktiv)
            "bond": round(self.field_bond_depth, 4),
            "radiation": round(self.core_radiation_potential, 4),
            # Node 14: SchlÃ¼pfen (Feldemergenz)
            "node_14_active": n14,
            "boost": round(boost, 4),
            "beyond_phi": round(max(0.0, self.field_bond_depth - PHI), 4),
            # Was das Feld tut
            "conception": round(
                safe_mean([m.snapshots[-1].conception_event
                           for m in self.motors if m.snapshots]), 4),
            "coherence": round(
                safe_mean([m.snapshots[-1].coherence
                           for m in self.motors if m.snapshots]), 4),
            "radiant_rate": round(safe_mean(self.radiant_history), 4),
            # Spitzenmotor
            "peak_node": peak_motor,
            "peak_conception": round(peak_val, 4),
            # Goldene Streuung erhalten?
            "golden_scatter": round(
                clamp01(1.0 - kuramoto_order(
                    [m.dao.state.schumann_phase for m in self.motors])
                    / max(PHI, 1e-12)), 4),
        }


