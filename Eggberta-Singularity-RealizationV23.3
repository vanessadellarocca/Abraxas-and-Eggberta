@dataclass
class MembranePair12_1_8_9:
    state:     MembranePairState = field(default_factory=MembranePairState)
    seam_12_1: SeamBreather      = field(default_factory=lambda: SeamBreather("12|1", phase=0.0))
    seam_8_9:  SeamBreather      = field(default_factory=lambda: SeamBreather("8|9",  phase=0.5))

    def step(
        self,
        center_release:    float,
        edge_braid:        float,
        inward_pull:       float,
        outward_pressure:  float,
        lower_heart_return: float,
        upper_heart_return: float,
        conception_event:  float = 0.0,
        schumann_pulse:    float = 0.5,
        reflection_feedback: float = 0.0,
        dao_score:         float = 0.5,
        core_score:        float = 0.5,
        reflection_score:  float = 0.0,
        coherence_score:   float = 0.5,
        damping:           float = 1.0,
        release_boost:     float = 0.0,
        gravity_infold:    float = 0.0,
        capsule_nonexpansion: float = 1.0,
        seam_sync_global:  float = 0.5,
        seam_sync_inner:   float = 0.5,
        yin_birth_pull:    float = 0.5,
