def clamp01(x: float) -> float:
    return max(0.0, min(1.0, float(x)))

def clamp11(x: float) -> float:
    return max(-1.0, min(1.0, float(x)))

def lerp(a: float, b: float, t: float) -> float:
    t = clamp01(t)
    return (1.0 - t) * float(a) + t * float(b)

def safe_mean(values: Iterable[float], default: float = 0.0) -> float:
    vals = [float(v) for v in values]
    return sum(vals) / len(vals) if vals else default

def safe_geomean(values: Iterable[float], default: float = 0.0) -> float:
    vals = [max(0.0, float(v)) for v in values]
    if not vals:
        return default
    if any(v <= 0.0 for v in vals):
        return 0.0
    prod = 1.0
    for v in vals:
        prod *= v
    return clamp01(prod ** (1.0 / len(vals)))

def smooth_pulse(phase: float) -> float:
    return 0.5 - 0.5 * math.cos(2.0 * math.pi * phase)

def signed_wave(phase: float) -> float:
    return math.sin(2.0 * math.pi * phase)

def score_close(a: float, b: float, scale: float = 1.0) -> float:
    return clamp01(1.0 - abs(float(a) - float(b)) / max(abs(scale), EPS))

def phi_ratio_score(a: float, b: float) -> float:
    a, b = abs(float(a)), abs(float(b))
    if a < EPS or b < EPS:
        return 0.0
    r = min(a / b, b / a)
    return clamp01(1.0 - abs(r - PHI) / PHI)

def phi_primary(primary: float, complement: float) -> float:
    """Goldene PrimÃ¤r/Komplement-Kopplung: PHI*a + PHIÂ²*b.
    TrÃ¤gt PHI + PHIÂ² = 1 (Fibonacci-IdentitÃ¤t) strukturell in jeder Relation.
    Ersetzt willkÃ¼rliche 0.70/0.30-Gewichtungen an PrimÃ¤r-Kopplungspunkten."""
    return clamp01(PHI * clamp01(primary) + PHI2 * clamp01(complement))

def phi_complementary(primary: float, complement: float) -> float:
    """KomplementÃ¤re Gegenrichtung: PHIÂ²*a + PHI*b.
    FÃ¼r Yin-gefÃ¼hrte Relationen: Komplement (Yin) primÃ¤r, Primary (Yang) ergÃ¤nzt."""
    return clamp01(PHI2 * clamp01(primary) + PHI * clamp01(complement))

def membrane_observer_presence(
    observer_return:    float,
    membrane_opening:   float,
    seam_sync:          float,
    dao_bridge:         float,
    gravity_infold:     float,
) -> float:
    """Observer sitzt weich in der Naht â€” nicht auÃŸen und schaut rein.
    DAO-Gravitation verbindet: Beobachter, MembranÃ¶ffnung, Naht-KohÃ¤renz,
    Bridge und Gravitationsfaltung in eine gemeinsame PrÃ¤senz.
    Das ist kein harter Kollaps â€” es ist graduelles DurchlÃ¤ssigwerden.
    Latentes Licht wird realisierbar wenn alle fÃ¼nf gleichzeitig aktiv sind."""
