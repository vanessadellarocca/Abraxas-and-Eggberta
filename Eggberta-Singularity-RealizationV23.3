def compute_energy(
    core:      CorePairState,
    dao:       DaoBreathState,
    membrane:  MembranePairState,
    heart:     HeartArcState,
    light:     LightResonanceState,
    gravity:   Optional[RadialGravityFoldState] = None,
    spiral:    Optional[SpinalPhaseState] = None,
    rbs_motor: float = 0.0,  # Motorknoten: radiale Zusammenziehung der vier StrÃ¶me
) -> Dict[str, float]:
    g  = gravity or RadialGravityFoldState()
    ss = spiral  or SpinalPhaseState()
    rbs = clamp01(rbs_motor)

    # Reparametrisierung in Energieberechnung:
    # Nie-0-Nie-1 Gravitation und observer-gewichtetes Licht
    g_eff_e   = gravity_infold_eff(g.gravity_infold, g.observer_return)
    obs_eff_e = observer_return_eff(g.observer_return)
    rls_eff_e = real_light_score_eff(g.real_light_score, light.latent_real_light, g.observer_return,
                                       capsule_visibility=g.capsule_visibility)

    phi_coherence = safe_geomean([
        core.phase_coherence + EPSILON,
        phi_ratio_score(core.center_cross_event + EPSILON, core.edge_braid + EPSILON) + EPSILON,
        dao.dao_score         + EPSILON,
        (0.55 + 0.45 * rbs)  + EPSILON,   # rbs: Motorknoten statt sbs
    ])
    outward_leakage = clamp01(
        max(membrane.inversion_risk_12_1, membrane.inversion_risk_8_9)
        + core.outward_pressure * (1.0 - core.edge_braid) * (1.0 - 0.35 * g_eff_e)
    )
    damping = clamp01(
        (1.0 - light.identity_preservation) * 0.24
        + dao.split_risk * 0.18
        + g.capsule_density * (1.0 - g.capsule_nonexpansion_score) * 0.14
    )
    fusion_like_gain = safe_geomean([
        core.center_cross_event + EPSILON,
        core.edge_braid         + EPSILON,
        core.inward_pull        + EPSILON,
        phi_coherence           + EPSILON,
        membrane.pulse          + EPSILON,
        heart.return_force      + EPSILON,
        rls_eff_e               + EPSILON,
    ]) * (1.0 - outward_leakage)
    # radial_birth_gain: rbs (Motorknoten) als explizite SchlieÃŸung der Architektur.
    # rbs = geomean(sbs, g_eff, rls_eff, obs_eff) â€” alle vier StrÃ¶me verdichtet.
    # g.radial_birth_score (State) bleibt als langsames GedÃ¤chtnis erhalten.
    radial_birth_gain = safe_geomean([
        fusion_like_gain          + EPSILON,
        rbs                       + EPSILON,   # Motorknoten: vier StrÃ¶me zusammengezogen
        g_eff_e                   + EPSILON,   # nie-0-nie-1 Gravitation
        obs_eff_e                 + EPSILON,   # observer_return_eff
        g.mutual_enclosure_score  + EPSILON,
        g.radial_birth_score      + EPSILON,   # langsames GedÃ¤chtnis
        ss.inner_turn_global      + EPSILON,
    ])
    net = clamp01(radial_birth_gain - outward_leakage - damping + 0.5)
    return {
        "phi_coherence":         phi_coherence,
        "outward_leakage":       outward_leakage,
        "damping":               damping,
        "fusion_like_gain":      clamp01(fusion_like_gain),
        "radial_birth_gain":     clamp01(radial_birth_gain),
        "net_coherence_gain":    net,
        "gravity_infold_eff":    g_eff_e,
        "observer_return_eff":   obs_eff_e,
        "real_light_score_eff":  rls_eff_e,
        "rbs_motor":             rbs,   # Motorknoten im Return fÃ¼r Snapshot/Debug
    }


