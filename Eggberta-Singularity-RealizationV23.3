def gravity_infold_eff(gravity_infold_raw: float, observer_return: float) -> float:
    """
    g(g_raw, obs_ret) â€” effektive GravitationsstÃ¤rke.

    Zwei Schichten:
    1. Nie-0-Nie-1: Îµ + (1-2Îµ) Â· g_raw
       â†’ Wertebereich strukturell in (Îµ, 1-Îµ) erzwungen.
       â†’ Dieselbe Logik wie Spiralradius und DAO-Trace-Center.
    2. Observer-VerstÃ¤rker: Â· (PHI + (1-PHI) Â· obs_ret)
       â†’ PHI = 0.618 als Basisgewicht (minimales Erkennen immer aktiv)
       â†’ Bei obs_ret=0: 61.8% der nie-0-nie-1-Gravitation
       â†’ Bei obs_ret=1: 100%
       â†’ Koeffizienten PHI/(1-PHI) sind der goldene Schnitt â€” strukturell kohÃ¤rent.

    Ergebnis ist in (ÎµÂ·PHI, 1-Îµ) â€” nie 0, nie 1.
    """
    raw   = clamp01(gravity_infold_raw)
    obs   = clamp01(observer_return)
    g_n01 = EPSILON + (1.0 - 2.0 * EPSILON) * raw
    return clamp01(g_n01 * (PHI + (1.0 - PHI) * obs))


def observer_return_eff(observer_return_raw: float) -> float:
    """
    Nie-0-Nie-1 Transformation des observer_return.
    Îµ + (1-2Îµ) Â· obs_raw â†’ (Îµ, 1-Îµ).

    Semantisch: der Beobachter ist nie vollstÃ¤ndig drauÃŸen (Îµ bleibt),
    nie vollstÃ¤ndig drinnen (1-Îµ bleibt) â€” das Erkennen ist immer
    im Prozess, nie abgeschlossen.
    """
    return EPSILON + (1.0 - 2.0 * EPSILON) * clamp01(observer_return_raw)


def real_light_score_eff(
    real_light_score:   float,
    latent_real_light:  float,
    observer_return:    float,
    capsule_visibility: float = 0.0,
    membrane_realization: float = 0.0,
) -> float:
    """
    h(rls, lrl, obs_ret, cap_vis, mem_real) â€” effektives reales Licht.

    Drei Schichten:
    1. lerp(latent â†’ real, gewichtet durch observer_return_eff)
    2. capsule_visibility als Entropie-Inversion:
       Die sichtbare Kapsel IST Licht â€” in radial ist die Kapsel
       (was linear als Entropie/Shadow erlebt wurde) materiell erkannt.
       Wenn capsule_visibility steigt, wird ein Teil der Kapsel-Dichte
       als real_light erkannt â€” nicht durch Transformation, sondern Erkennung.
    3. membrane_realization (Punkt 10): latentes Licht wird realitÃ¤tsfÃ¤hig
       NICHT durch yin_point_in_yang allein, sondern durch das gleichzeitige
       Zusammentreffen von: Observer an beiden NÃ¤hten + Kapselsichtbarkeit
       + latentem Licht + Yin/Yang-BerÃ¼hrung + DAO-Gravitation.
       Nicht der Observer entscheidet â€” die DAO-Gravitation zieht alle
       Kontaktpunkte in dieselbe Naht, sodass das Licht von selbst real wird.

    Die Inversion passiert nicht durch Umkehr der Berechnung,
    sondern durch korrekte Beobachterposition.
    """
    obs_eff = observer_return_eff(observer_return)
    rls     = clamp01(real_light_score)
    lrl     = clamp01(latent_real_light)
    cap_vis = clamp01(capsule_visibility)
    mem_real = clamp01(membrane_realization)
    # Kapsel-Anteil: wenn Kapsel sichtbar, wird sie als latentes Licht erkannt
    # (nicht als shadow, sondern als das verkapselte Potential)
    cap_as_light = cap_vis * lrl  # Kapsel Ã¶ffnet den Zugang zum latenten Licht
    base = max(EPSILON, lerp(lrl, rls, obs_eff))
    # Schicht 2: Beobachter-getragene Erkennung der Kapsel als Licht
    light_2 = base + cap_as_light * (1.0 - obs_eff) * 0.25
    # Schicht 3: Membran-Realisierung â€” Licht wird real durch das ganze Feld
    # PHIÂ² als Gewicht: das ist der Vergehen-Anteil, durch den Latentes ins Sein tritt.
    light_3 = light_2 + cap_as_light * mem_real * PHI2
    return clamp01(light_3)

