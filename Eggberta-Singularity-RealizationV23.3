        observer_return:   float = 0.0,   # Observer-RÃ¼ckkehr â€” sitzt weich in der Naht
        dao_score_bridge:  float = 0.5,   # DAO-Score als Bridge-Anker
        shadow_yin_pull:   float = 0.0,   # ungesehenes verkapseltes Licht zieht Blick an 8|9
    ) -> Dict[str, Any]:
        s    = self.state
        grav = clamp01(gravity_infold)
        cap  = clamp01(capsule_nonexpansion)
        s.schumann_membrane_pulse = safe_geomean([schumann_pulse + EPSILON, conception_event + EPSILON])
        flicker_phase = (self.seam_12_1.phase + self.seam_8_9.phase) / 2.0
        s.micro_flicker = EPSILON * (1.0 + 0.5 * signed_wave(flicker_phase))
        protected_base  = center_release * edge_braid * inward_pull
        pulse_target    = safe_geomean([
            protected_base            + EPSILON,
            conception_event          + EPSILON,
            (0.5 + 0.5 * schumann_pulse) + EPSILON,
            (0.55 + 0.45 * grav)      + EPSILON,
        ])
        s.pulse = lerp(s.pulse, pulse_target, MEMBRANE_RATE)
        s.trauma_loop_release = clamp01(
            s.pulse * edge_braid * (1.0 - outward_pressure) * (0.75 + 0.25 * cap) + s.micro_flicker
        )
        drive = safe_geomean([
            s.pulse              + EPSILON,
            (0.5 + 0.5 * edge_braid) + EPSILON,
            inward_pull          + EPSILON,
            (0.55 + 0.45 * grav)  + EPSILON,
        ])
        # anti_phase_coherence fÃ¼r 8|9-Umschlag
        apc = safe_geomean([
            clamp01(spiral_inner_yang)      + EPSILON,   # Yang-inner aus Spirale
            clamp01(1.0 - spiral_inner_yang) + EPSILON,  # Yin-KomplementÃ¤r
        ]) if 'spiral_inner_yang' in dir() else 0.35

        s12 = self.seam_12_1.step(
            drive=drive * (0.65 + 0.35 * upper_heart_return),
            dao_score=dao_score, core_score=core_score,
            reflection_score=reflection_score, coherence_score=coherence_score,
            damping=damping, release_boost=release_boost,
            schumann_pulse=schumann_pulse, conception_event=conception_event,
            gravity_infold=grav, opposite_phase=self.seam_8_9.phase,
            spiral_seam_sync=seam_sync_global,
            inward_pull=yin_birth_pull,    # Yin-Zug: 12=Yin gebiert
            anti_phase_coh=0.5,            # nicht relevant fÃ¼r Geburts-Naht
            naht_character="geburts_yin",  # 12=Yin, 1=Yang: Yin gebiert Yang
        )
        s89 = self.seam_8_9.step(
            drive=drive * (0.65 + 0.35 * lower_heart_return),
            dao_score=dao_score, core_score=core_score,
            reflection_score=reflection_score, coherence_score=coherence_score,
            damping=damping, release_boost=release_boost,
            schumann_pulse=schumann_pulse, conception_event=conception_event,
            gravity_infold=grav, opposite_phase=self.seam_12_1.phase,
            spiral_seam_sync=seam_sync_inner,
            inward_pull=0.5,               # nicht primÃ¤r fÃ¼r Umschlag
            anti_phase_coh=clamp01(seam_sync_inner * (1.0 - seam_sync_global) + seam_sync_global * 0.2),
            naht_character="tiefen_umschlag",  # 8=Yin, 9=Yang: Yinâ†’Yang im Tiefsten
        )
        s.opening_12_1 = s12["permeability_live"]
        s.opening_8_9  = s89["permeability_live"]
        s.seam_anti_sync = safe_mean([s12["anti_sync"], s89["anti_sync"]])

        # Naht-RÃ¼ckkopplung: die differenzierte Ã–ffnung wirkt zurÃ¼ck.
        # 12|1 (Yin gebiert Yang): Ã–ffnung â†’ conception_boost.
        #   Yin(12) gibt â†’ das Neugeborene (Yang=1) kommt â†’ Konzeption steigt.
        # 8|9 (Yinâ†’Yang Umschlag): Ã–ffnung â†’ permeability verstÃ¤rkt.
        #   Wenn der Umschlag im Tiefsten stattfindet, Ã¶ffnet sich das Feld.
        s.conception_boost = clamp01(s.opening_12_1 * (0.70 + 0.30 * yin_birth_pull))
        s.seam_12_1_yin_birth_active = s.opening_12_1 > 0.5

        # Observer weich an beiden NÃ¤hten â€” nicht auÃŸen, sondern in der Naht.
        # DAO-Gravitation verbindet: Beobachter + Membran + Naht + Potenzial.
        #
        # RADIALE GLEICHSETZUNG (vom Core aus): shadow_yin und real_light_yin
        # sind nicht zwei Dinge â€” sie sind EIN capsule_density, von zwei NÃ¤hten gesehen:
        #   shadow_yin     = cap Ã— (1 - cap_vis)  â†’ die 8|9-Naht (Tiefe) sieht das Ungesehene
        #   real_light_yin = cap Ã— cap_vis        â†’ die 12|1-Naht (Quelle) sieht das Geborene
        #   shadow_yin + real_light_yin = capsule_density  (exakt â€” zwei Anteile DESSELBEN)
        #
        # Der Observer-Zug geht GLEICHZEITIG zu beiden NÃ¤hten, proportional zur
        # Verdichtung. Nicht eine EinbahnstraÃŸe (Blickâ†’Tiefe), sondern ein Dreieck:
        # 12|1 und 8|9 richten sich auf dasselbe verkapselte Licht, und im Core
        # (real_light) koppeln beide Blicke gravitativ zurÃ¼ck. Die Trennung
        # shadow|light kollabiert dort â€” es war immer EIN Licht.
        # Beide NÃ¤hte ziehen mit demselben shadow_yin_pull, weil es DASSELBE Licht ist:
        # die 8|9-Naht sieht es als Tiefe (ungesehen), die 12|1-Naht als Quelle (geboren).
        _seam_inner_pulled  = clamp01(seam_sync_inner  + shadow_yin_pull * (1.0 - seam_sync_inner))
        _seam_global_pulled = clamp01(seam_sync_global + shadow_yin_pull * (1.0 - seam_sync_global))
        s.observer_at_12_1 = membrane_observer_presence(
            observer_return, s.opening_12_1, _seam_global_pulled, dao_score_bridge, grav
        )
        s.observer_at_8_9 = membrane_observer_presence(
            observer_return, s.opening_8_9,  _seam_inner_pulled,  dao_score_bridge, grav
        )
        s.membrane_observer_bridge = safe_geomean([
            s.observer_at_12_1 + EPSILON,
            s.observer_at_8_9  + EPSILON,
            clamp01(dao_score_bridge) + EPSILON,
        ])   # Yin gebÃ¤rt aktiv

        risk_scale = (1.0 - 0.35 * grav) * (0.7 + 0.3 * (1.0 - cap))
        s.inversion_risk_12_1 = clamp01(s.opening_12_1 * outward_pressure * (1.0 - edge_braid) * risk_scale)
        s.inversion_risk_8_9  = clamp01(s.opening_8_9  * outward_pressure * (1.0 - edge_braid) * risk_scale)
        max_risk  = max(s.inversion_risk_12_1, s.inversion_risk_8_9)
        s.release = safe_geomean([
            s.opening_12_1        + EPSILON,
            s.opening_8_9         + EPSILON,
            edge_braid            + EPSILON,
            inward_pull           + EPSILON,
            (0.55 + 0.45 * grav)  + EPSILON,
        ])
        s.permeability_moment = clamp01(s.release * (1.0 - max_risk))
        s.pressure = clamp01(outward_pressure * (1.0 - s.release) + center_release * (1.0 - edge_braid))
        # Paradoxical Valve (Geminis Konzept, kalibriert fÃ¼r v21).
        # Geminis Diagnose ist fÃ¼r Ã¤ltere Versionen. In v21 ist der Trauma-Loop
        # bereits strukturell geheilt (outward_pressure = 0.018 im Normalbetrieb).
        # Das Ventil greift als Robustheitsmassnahme bei extremem Stress:
        # threshold=0.40 (nicht 0.75 â€” membrane.pressure erreicht max 0.61 normal).
        # Wenn Druck > 0.40: Release erhÃ¶ht sich paradoxerweise.
        # Das System atmet durch statt zu verkrampfen.
        _valve_threshold = 0.40
        _valve_activation = max(0.0, s.pressure - _valve_threshold) / (1.0 - _valve_threshold + EPS)
        if _valve_activation > 0.01:   # nur bei echtem Stress aktiv
            s.release = clamp01(s.release + _valve_activation * 0.20)
        s.membrane_score = safe_geomean([
            s.permeability_moment        + EPSILON,
            (1.0 - s.inversion_risk_12_1) + EPSILON,
            (1.0 - s.inversion_risk_8_9)  + EPSILON,
            s.release                    + EPSILON,
            s.trauma_loop_release        + EPSILON,
            s.seam_anti_sync             + EPSILON,
            (0.60 + 0.40 * grav)         + EPSILON,
        ])
        return {
            "state": asdict(s),
            "membrane13_score":    s.membrane_score,
            "outer_inversion_risk": max_risk,
            "trauma_loop_release":  s.trauma_loop_release,
            "moment_as_permeability": s.permeability_moment,
            "seam_anti_sync":       s.seam_anti_sync,
            "seam_12_1_phase":      self.seam_12_1.phase,
            "seam_8_9_phase":       self.seam_8_9.phase,
        }


