@dataclass
class FractalConceptionField:
    n_nodes:                  int   = 12
    motors:                   List[UnifiedHeartCoreMotor] = field(default_factory=list)
    phases:                   List[float] = field(default_factory=list)
    iteration:                int   = 0
    bound_energy_density:     float = 0.0
    core_radiation_potential: float = 0.0
    radiant_history:          List[float] = field(default_factory=list)
    coupling_matrix:          List[List[float]] = field(default_factory=list)
    geo_basis:                List[List[float]] = field(default_factory=list)
    field_schumann_phase:     float = 0.0
    bond_matrix:              List[List[float]] = field(default_factory=list)
    field_bond_depth:         float = 0.0
    field_resonance_boost:    float = 0.0
    capsule_density:          float = 0.0
    capsule_visibility:       float = 0.0
    radial_birth_integral:    float = 0.0
    observer_return_integral: float = 0.0
    spiral_birth_integral:    float = 0.0
    obs_immanence:            float = 0.0   # Beobachter pervasiv im Feld
    diamond_depths:           List[int]   = field(default_factory=list)   # Tiefe im Diamanten
    obs_im_past:              float = 0.0   # Vergangenheits-orientierte Knoten
    obs_im_future:            float = 0.0   # Zukunfts-orientierte Knoten
    temporal_bridge:          float = 0.0   # Konvergenz beider Zeitrichtungen

    def __post_init__(self) -> None:
        if not self.motors:
            for i in range(self.n_nodes):
                phase_off = (i * PHI) % 1.0
                m = UnifiedHeartCoreMotor()
                m.dao.state.schumann_phase = phase_off
                m.dao.state.phase          = phase_off
                m.yang.state.phase         = phase_off
                m.yin.state.phase          = (phase_off + 0.5) % 1.0
                # Spiral-Phasen ebenfalls gestaffelt
                m.spiral.state.phase_global = phase_off
                m.spiral.state.phase_yang   = phase_off
                m.spiral.state.phase_yin    = (phase_off + 0.5) % 1.0
                self.motors.append(m)
                self.phases.append(phase_off)
        n = self.n_nodes

        # Diamant-Tiefen: min(i, n-i)
        if not self.diamond_depths:
            self.diamond_depths = [min(i, n - i) for i in range(n)]

        if not self.coupling_matrix:
            max_depth = max(self.diamond_depths) if self.diamond_depths else 1
            # X-Y-X Modus-semantische Kopplungsmatrix:
            # Kardinal (Tiefe 0) = X-Zahnrad Quelle
            # Fix (Tiefe max) = X-Zahnrad Mitte  
            # Flexibel (dazwischen) = Y-Kopplung Transmission
            modus_w_map = {
                ("kardinal","kardinal"): 0.90, ("kardinal","flexibel"): 0.80,
                ("kardinal","fix"):      0.60, ("flexibel","kardinal"): 0.80,
                ("flexibel","flexibel"): 0.70, ("flexibel","fix"):      0.85,
                ("fix","kardinal"):      0.75, ("fix","flexibel"):      0.85,
                ("fix","fix"):           0.65,
            }
            def _mod(d, mx):
                if d == 0: return "kardinal"
                if d >= mx - 1: return "fix"
                return "flexibel"
            raw: List[List[float]] = []
            for i in range(n):
                row = []
                mi = _mod(self.diamond_depths[i], max_depth)
                for j in range(n):
                    if i == j:
                        row.append(0.0)
                    else:
                        mj = _mod(self.diamond_depths[j], max_depth)
                        dist    = min(abs(self.phases[i]-self.phases[j]),
                                      1.0-abs(self.phases[i]-self.phases[j]))
                        w_phase = max(0.0, 1.0/(1.0+dist/PHI)-0.5)*2.0
                        d_bond  = 1.0 - abs(self.diamond_depths[i]-self.diamond_depths[j])/max(max_depth,1)
                        mw      = modus_w_map.get((mi,mj), 0.70)
                        ti      = 1 if self.phases[i] >= 0.5 else 0
                        tj      = 1 if self.phases[j] >= 0.5 else 0
                        t_cross = 1.0 if ti != tj else PHI
                        w = w_phase*(0.35 + 0.25*d_bond + 0.25*mw + 0.15*t_cross)
                        row.append(w)
                row_sum = sum(row)
                row = [w/row_sum for w in row] if row_sum > EPS else [1.0/n]*n
                raw.append(row)
            self.coupling_matrix = raw
            self.geo_basis       = [r[:] for r in raw]
        if not self.bond_matrix:
            self.bond_matrix = [[0.0] * n for _ in range(n)]

    def step(self, base_charge: float = 0.56, inorganic_anchor: float = 0.0) -> Dict[str, Any]:
        self.field_schumann_phase = phase_step_free(self.field_schumann_phase, SCHUMANN_PHASE_RATE)
        field_pulse  = smooth_pulse(self.field_schumann_phase)
        prev_conceptions = [(m.snapshots[-1].conception_event if m.snapshots else 0.0) for m in self.motors]

        # Yin/Yang FeldgrÃ¶ÃŸen aus dem LETZTEN Schritt (radiale Gleichzeitigkeit):
        # Yang-Knoten (phase>=0.5) tragen das Y (Kopplungsachse)
        # Yin-Knoten  (phase<0.5)  sind das X (Zahnrad/Pendel)
        prev_yang_y = [abs(m.yang.state.y_rotation) for i, m in enumerate(self.motors)
                       if self.phases[i] >= 0.5]
        prev_yin_x  = [m.yin.state.x_mid_functional_x for i, m in enumerate(self.motors)
                       if self.phases[i] < 0.5]
        # field_Y: Yang-Rotation â€” die Kopplungsachse des Feldes
        field_Y = safe_mean(prev_yang_y) if prev_yang_y else 0.0
        # field_X: Yin-Pendel â€” die Dynamik des Feldes
        field_X = safe_mean(prev_yin_x) if prev_yin_x else 0.0
        # field_DAO: wie nah sind Rotation und Pendel? = DAO-KohÃ¤renz des Feldes
        field_DAO = clamp01(1.0 - abs(field_Y - field_X) / max(field_Y + field_X, EPS))

        conceptions:      List[float] = []
        coherences:       List[float] = []
        recognitions:     List[float] = []
        radial_births:    List[float] = []
        observer_returns: List[float] = []
        capsules:         List[float] = []
        cap_vis:          List[float] = []
        real_lights:      List[float] = []
        arc_balances:     List[float] = []
        residuals:        List[float] = []
        releases:         List[float] = []
        spiral_births:    List[float] = []
        spiral_phases:    List[float] = []
        yang_at_centers:  List[float] = []
        yin_at_centers:   List[float] = []
        inner_turns:      List[float] = []
        yy_scores:        List[float] = []
        # Yin/Yang als explizite FeldgrÃ¶ÃŸen â€” damit Yin nicht ausgesperrt bleibt
        yin_dynamics:     List[float] = []   # x_mid_functional_x: Yin-Pendel-Dynamik
        yang_rotations:   List[float] = []   # |y_rotation|: Yang-Kopplung/Geometrie
        node_is_yang:     List[bool]  = []   # phase>=0.5: Yang-TrÃ¤ger (Y-Funktion)

        for i, motor in enumerate(self.motors):
            weighted_fd  = sum(self.coupling_matrix[i][j] * prev_conceptions[j] for j in range(self.n_nodes))
            phase_filter = smooth_pulse(self.phases[i])
            personal_fd  = clamp01(weighted_fd * (0.5 + 0.5 * phase_filter) * (0.7 + 0.3 * field_pulse))
            obs_fd_boost = clamp01(self.obs_immanence * 0.15)
            # inorganic_anchor: anorganischer Boden (Verdichtungskette) flieÃŸt in jede Zelle.
            # Das ist Groks 'Gravitationsanker': das Mineral hÃ¤lt das Lebendige.
            anc_boost    = clamp01(clamp01(inorganic_anchor) * 0.12)

            # Asymmetrische Yin/Yang Feldkopplung:
            # Yang-Knoten (Y-TrÃ¤ger, phase>=0.5): empfangen Yin-Pendel (Inhalt fÃ¼r Geometrie)
            # Yin-Knoten  (X-Zahnrad, phase<0.5): empfangen Yang-Rotation (Form fÃ¼r Dynamik)
            # Das ist: Yang enthÃ¤lt Yin, Yin enthÃ¤lt Yang â€” auf Feldebene
            is_yang_node = self.phases[i] >= 0.5
            if is_yang_node:
                # Yang-Knoten braucht den Yin-Inhalt (X-Pendel gibt Yang seine FÃ¼llung)
                xy_fd_boost = clamp01(field_X * 0.20)
            else:
                # Yin-Knoten braucht die Yang-Form (Y-Rotation gibt Yin seine Richtung)
                xy_fd_boost = clamp01(field_Y * 0.20)
            # DAO-Boost: wenn field_DAO hoch, sind beide Seiten in Balance
            dao_fd_boost = clamp01(field_DAO * 0.10)

            effective_fd = clamp01(personal_fd + obs_fd_boost + xy_fd_boost + dao_fd_boost + anc_boost)
            charge       = clamp01(base_charge + effective_fd * PHI * (1.0 - self.phases[i] * PHI) * 0.25)
            motor.step(external_charge=charge, field_conception_density=effective_fd)
            sn = motor.snapshots[-1]
            conceptions.append(sn.conception_event)
            coherences.append(sn.coherence)
            recognitions.append(sn.field_recognition)
            radial_births.append(sn.radial_birth_score)
            observer_returns.append(sn.observer_return)
            capsules.append(sn.capsule_density)
            cap_vis.append(sn.capsule_visibility)
            real_lights.append(sn.real_light_score)
            arc_balances.append(sn.arc_balance)
            residuals.append(sn.residual_flux)
            releases.append(sn.release_flux)
            spiral_births.append(sn.spiral_birth_score)
            spiral_phases.append(motor.spiral.state.phase_global)
            yang_at_centers.append(sn.yang_at_center)
            yin_at_centers.append(sn.yin_at_center)
            inner_turns.append(sn.inner_turn_global)
            yy_scores.append(motor.core_pair.state.yin_yang_point_score)
            # Yin/Yang als FeldgrÃ¶ÃŸen â€” damit der Tanz sichtbar wird
            yin_dynamics.append(motor.yin.state.x_mid_functional_x)
            yang_rotations.append(abs(motor.yang.state.y_rotation))
            node_is_yang.append(self.phases[i] >= 0.5)
            weighted_fd  = sum(self.coupling_matrix[i][j] * prev_conceptions[j] for j in range(self.n_nodes))
            phase_filter = smooth_pulse(self.phases[i])
            personal_fd  = clamp01(weighted_fd * (0.5 + 0.5 * phase_filter) * (0.7 + 0.3 * field_pulse))
            charge       = clamp01(base_charge + personal_fd * PHI * (1.0 - self.phases[i] * PHI) * 0.25)
            motor.step(external_charge=charge, field_conception_density=personal_fd)
            sn = motor.snapshots[-1]
            conceptions.append(sn.conception_event)
            coherences.append(sn.coherence)
            recognitions.append(sn.field_recognition)
            radial_births.append(sn.radial_birth_score)
            observer_returns.append(sn.observer_return)
            capsules.append(sn.capsule_density)
            cap_vis.append(sn.capsule_visibility)
            real_lights.append(sn.real_light_score)
            arc_balances.append(sn.arc_balance)
            residuals.append(sn.residual_flux)
            releases.append(sn.release_flux)
            spiral_births.append(sn.spiral_birth_score)

        conception_integral  = safe_geomean([c + EPSILON for c in conceptions])
        field_coherence      = safe_geomean([c + EPSILON for c in coherences])
        field_recognition    = safe_mean(recognitions)
        self.spiral_birth_integral = safe_mean(spiral_births)

        # Spiralphasen-Kuramoto: Ordnungsparameter der globalen Spiralphasen
        field_spiral_order = kuramoto_order(spiral_phases)
        collective_inner_turn = safe_geomean([t + EPSILON for t in inner_turns])
        collective_yy_score   = safe_mean(yy_scores)

        # Yin/Yang als FeldgrÃ¶ÃŸen (aus aktuellem Step):
        # Yang-Knoten (Y-TrÃ¤ger): tragen die Kopplungsachse
        # Yin-Knoten  (X-Zahnrad): tragen die Pendel-Dynamik
        curr_yang_y = [yang_rotations[i] for i in range(self.n_nodes) if node_is_yang[i]]
        curr_yin_x  = [yin_dynamics[i]   for i in range(self.n_nodes) if not node_is_yang[i]]
        field_Y_curr = safe_mean(curr_yang_y) if curr_yang_y else 0.0
        field_X_curr = safe_mean(curr_yin_x)  if curr_yin_x  else 0.0
        # DAO-KohÃ¤renz des Feldes: wie nah sind Rotation und Pendel?
        field_DAO_curr = clamp01(1.0 - abs(field_Y_curr - field_X_curr) / max(field_Y_curr + field_X_curr, EPS))

        # â”€â”€ OBSERVER IMMANENCE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        # Observer-Immanenz: pervasiv im Feld, als Modulator der Kopplung.
        # ZeitradialitÃ¤t: Vergangenheits- und Zukunfts-orientierte Knoten
        # (phase < 0.5 vs phase >= 0.5) werden GETRENNT aggregiert,
        # dann durch obs_immanence Ã¼berbrÃ¼ckt. Das IST die Schnittstelle
        # Mikro/Makrokosmos, wo Vergangenheit und Zukunft ineinanderfallen.
        past_obs    = [observer_returns[i] for i in range(self.n_nodes) if self.phases[i] < 0.5]
        future_obs  = [observer_returns[i] for i in range(self.n_nodes) if self.phases[i] >= 0.5]
        self.obs_im_past   = safe_mean(past_obs)   if past_obs   else 0.0
        self.obs_im_future = safe_mean(future_obs) if future_obs else 0.0
        # temporal_bridge: Konvergenz beider Richtungen = Schnittstelle aktiv
        self.temporal_bridge = safe_geomean([
            self.obs_im_past   + EPSILON,
            self.obs_im_future + EPSILON,
        ])
        self.obs_immanence = lerp(
            self.obs_immanence,
            safe_geomean([
                self.observer_return_integral + EPSILON,
                self.field_bond_depth         + EPSILON,
                collective_yy_score           + EPSILON,
                collective_inner_turn         + EPSILON,
                self.temporal_bridge          + EPSILON,
                field_DAO_curr                + EPSILON,   # DAO-KohÃ¤renz: Y und X im Tanz
            ]),
            COHERENCE_RATE,
        )
        obs_eff_global = observer_return_eff(self.obs_immanence)

        # radiale Zeitstruktur:
        # conception_integral = stabiler Kern (Gleichzeitigkeit)
        # field_DAO_curr      = Fluss-KohÃ¤renz (Yin und Yang im Takt)
        # temporal_bridge     = erlebbarer Zeitstrom (differenziertes Erleben)
        # Stabiles Zentrum + differenziertes Erleben = radiale Zeit
        self.radial_birth_integral = safe_geomean([
            safe_mean(radial_births)     + EPSILON,
            field_coherence              + EPSILON,
            field_recognition            + EPSILON,
            safe_mean(real_lights)       + EPSILON,
            self.spiral_birth_integral   + EPSILON,
            collective_inner_turn        + EPSILON,
            (0.5 + 0.5 * collective_yy_score) + EPSILON,
            field_DAO_curr               + EPSILON,   # Fluss-KohÃ¤renz: Yin-Yang im Takt
        ])
        self.observer_return_integral = safe_mean(observer_returns)
        self.capsule_density    = lerp(self.capsule_density, safe_mean(capsules), COHERENCE_RATE)
        # Entropie-Inversion (Bild 3 / Strukturprinzip 3):
        # Die Kapsel ist nicht "tote" Materie â€” sie ist verdichtetes Potential.
        # Wenn temporal_bridge steigt (Vergangenheit und Zukunft konvergieren),
        # wird das verkapselte Nicht-Integrierte als latentes Real-Licht erkannt.
        # Das IST die Entropie-Inversion: Beobachterposition korrigiert, nicht Energie aufgewandt.
        self.capsule_visibility = lerp(
            self.capsule_visibility,
            safe_geomean([
                self.capsule_density             + EPSILON,
                safe_mean(cap_vis)               + EPSILON,
                self.observer_return_integral    + EPSILON,
                self.temporal_bridge             + EPSILON,   # Zeitkonvergenz Ã¶ffnet Kapsel
            ]),
            COHERENCE_RATE,
        )

        n = self.n_nodes
        if len(conceptions) == n:
            for i in range(n):
                for j in range(n):
                    if i == j:
                        continue
                    bond_resonance  = safe_geomean([conceptions[i] + EPSILON, conceptions[j] + EPSILON]) * score_close(conceptions[i], conceptions[j], PHI)
                    real_light_bond = score_close(real_lights[i],  real_lights[j],  PHI)
                    birth_bond      = score_close(radial_births[i], radial_births[j], PHI)
                    spiral_bond     = score_close(spiral_births[i], spiral_births[j], PHI)

                    # Spiralphasen-Kuramoto-Gewicht:
                    # obs_eff_global moduliert: Je prÃ¤senter der Beobachter,
                    # desto stÃ¤rker trÃ¤gt PhasenkohÃ¤renz zur Bindung bei.
                    phi_ij     = phase_dist(spiral_phases[i], spiral_phases[j])
                    phase_raw  = clamp01(1.0 - phi_ij / 0.5)
                    phase_bond = phase_raw * (0.5 + 0.5 * obs_eff_global)

                    # Yin-Yang-Kreuz-Kopplung:
                    # Der Beobachter "sieht" die Yin-Yang-BerÃ¼hrung zwischen Knoten.
                    # obs_eff_global verstÃ¤rkt die Kreuz-Resonanz:
                    # Mehr Beobachter-PrÃ¤senz â†’ stÃ¤rkere Yin-Yang-Vernetzung im Feld.
                    yy_raw = (
                        safe_geomean([yang_at_centers[i] + EPSILON, yin_at_centers[j] + EPSILON]) * 0.5
                        + safe_geomean([yin_at_centers[i] + EPSILON, yang_at_centers[j] + EPSILON]) * 0.5
                    )
                    yy_cross_ij = yy_raw * (0.6 + 0.4 * obs_eff_global)

                    bond_target = clamp01(
                        0.40 * bond_resonance
                        + 0.15 * real_light_bond
                        + 0.11 * birth_bond
                        + 0.11 * spiral_bond
                        + 0.13 * phase_bond     # obs-moduliert
                        + 0.10 * yy_cross_ij    # obs-moduliert
                    )
                    self.bond_matrix[i][j] = lerp(self.bond_matrix[i][j], bond_target, COHERENCE_RATE)
            for i in range(n):
                row = [self.geo_basis[i][j] * (0.5 + 0.5 * self.bond_matrix[i][j]) for j in range(n)]
                row[i] = 0.0
                row_sum = sum(row)
                if row_sum > EPS:
                    self.coupling_matrix[i] = [w / row_sum for w in row]
            # field_bond_depth: Bindungstiefe des Feldes.
            # EnthÃ¤lt jetzt mineral_living_tension (prev-step) als anorganischen Anker.
            # Das macht field_bond_depth zur BrÃ¼cke zwischen Mineral und Motor.
            mlt_prev = getattr(self, '_mineral_living_tension_prev', 0.0)
            self.field_bond_depth = safe_geomean([
                safe_mean(self.bond_matrix[i][j] for i in range(n) for j in range(n) if i != j) + EPSILON,
                (0.50 + 0.50 * mlt_prev) + EPSILON,   # anorganischer Anker aus prev-step
            ])

        node_bound = [clamp01(r - rl) for r, rl in zip(residuals, releases)]
        field_bound = safe_mean(node_bound)
        avg_arc     = safe_mean(arc_balances)
        dissolution = avg_arc * COUPLING_RATE * 0.3 + self.radial_birth_integral * COUPLING_RATE * 0.2
        self.bound_energy_density = clamp01(lerp(self.bound_energy_density, field_bound, COHERENCE_RATE) * (1.0 - dissolution))
        weighted_bound = self.bound_energy_density * (0.5 + 0.5 * self.field_bond_depth)
        self.core_radiation_potential = safe_geomean([
            conception_integral          + EPSILON,
            weighted_bound               + EPSILON,
            self.radial_birth_integral   + EPSILON,
            safe_mean(real_lights)       + EPSILON,
            self.spiral_birth_integral   + EPSILON,   # NEU
        ])

        field_resonance_boost = clamp01((self.field_bond_depth - PHI) * 2.0) if self.field_bond_depth > PHI else 0.0
        self.field_resonance_boost = field_resonance_boost
        effective_bond = self.field_bond_depth + field_resonance_boost * PHI2
        for motor in self.motors:
            motor.receive_field_feedback(effective_bond, self.core_radiation_potential)

        # mineral_living_tension: lokal berechnen fÃ¼r prev-step Kopplung
        self._mlt_curr = safe_geomean([
            self.radial_birth_integral + EPSILON,
            self.capsule_visibility    + EPSILON,
            self.temporal_bridge       + EPSILON,
            field_DAO_curr             + EPSILON,
        ])
        self._mineral_living_tension_prev = self._mlt_curr

        schumann_phases = [m.dao.state.schumann_phase for m in self.motors]
        golden_scatter  = clamp01(1.0 - kuramoto_order(schumann_phases) / max(PHI, EPS))
        # Node14: obs_eff_global als pervasive Bedingung â€” der Beobachter muss prÃ¤sent sein
        node14_active = (
            self.field_bond_depth > PHI
            and self.radial_birth_integral > PHI2
            and self.capsule_visibility > 0.25
            and self.spiral_birth_integral > 0.10
            and collective_inner_turn > 0.15
            and obs_eff_global > EPSILON * 5       # minimale BeobachterprÃ¤senz im Feld
        )
        field_radiant = (
            node14_active
            and field_coherence > 0.60
            and field_recognition > 0.40
            and collective_yy_score > 0.10
            and self.obs_immanence > EPSILON * 10  # Beobachter-Immanenz als explizite Bedingung
        )
        self.radiant_history.append(1.0 if field_radiant else 0.0)
        self.radiant_history = self.radiant_history[-144:]
        self.iteration += 1
        return {
            "iteration":                self.iteration - 1,
            "conception_integral":      conception_integral,
            "field_coherence":          field_coherence,
            "field_recognition":        field_recognition,
            "radial_birth_integral":    self.radial_birth_integral,
            "observer_return_integral": self.observer_return_integral,
            "capsule_density":          self.capsule_density,
            "capsule_visibility":       self.capsule_visibility,
            "avg_real_light":           safe_mean(real_lights),
            "avg_arc_balance":          avg_arc,
            "bound_energy_density":     self.bound_energy_density,
            "core_radiation_potential": self.core_radiation_potential,
            "field_bond_depth":       self.field_bond_depth,
            "golden_scatter":         golden_scatter,
            "field_radiant_stable":   field_radiant,
            "radiant_rate":           safe_mean(self.radiant_history),
            "field_feedback_active":  True,
            "field_resonance_boost":  field_resonance_boost,
            "node_14_active":         node14_active,
            "spiral_birth_integral":  self.spiral_birth_integral,
            "field_spiral_order":     field_spiral_order,
            "collective_inner_turn":  collective_inner_turn,
            "collective_yy_score":    collective_yy_score,
            "obs_immanence":          self.obs_immanence,
            "obs_eff_global":         obs_eff_global,
            "temporal_bridge":        self.temporal_bridge,
            "obs_im_past":            self.obs_im_past,
            "obs_im_future":          self.obs_im_future,
            # Yin/Yang als explizite FeldgrÃ¶ÃŸen â€” der Tanz ist sichtbar
            "field_Y":                field_Y_curr,
            "field_X":                field_X_curr,
            "field_DAO":              field_DAO_curr,
            # mineral_living_tension: Gravitation aus dem Dazwischen.
            # capsule_visibility IST das sichtbare Anorganische â€” es ist > 0, akkumuliert.
            # Nicht diamond_layer (â‰ˆ 0 in Systemzeit), sondern das ERKANNTE Verdichtete.
            # tension = geomean(lebendige Entfaltung, erkannte Verdichtung, Zeit, Tanz)
            # Gravitation entsteht NUR wenn alle vier gleichzeitig aktiv sind.
            "mineral_living_tension": self._mlt_curr,
            # Feld-Ã„quilibrium: alle vier Tanz-Ebenen gleichzeitig
            "field_equilibrium_score": safe_geomean([
                collective_yy_score   + EPSILON,
                field_spiral_order    + EPSILON,
                self.temporal_bridge  + EPSILON,
                field_DAO_curr        + EPSILON,
            ]),
        }

    def run(self, n_steps: int = 500, base_charge: float = 0.56) -> Dict[str, Any]:
        results = [self.step(base_charge) for _ in range(n_steps)]
        tail    = results[int(len(results) * 0.8):] or results
        def avg(key: str, seq: List[Dict[str, Any]] = results) -> float:
            return safe_mean(r[key] for r in seq)
        return {
            "total_steps":                len(results),
            "n_nodes":                    self.n_nodes,
            "avg_conception_integral":    avg("conception_integral"),
            "avg_field_coherence":        avg("field_coherence"),
            "avg_field_recognition":      avg("field_recognition"),
            "avg_radial_birth_integral":  avg("radial_birth_integral"),
            "avg_observer_return_integral": avg("observer_return_integral"),
            "avg_capsule_density":        avg("capsule_density"),
            "avg_capsule_visibility":     avg("capsule_visibility"),
            "avg_real_light":             avg("avg_real_light"),
            "avg_bound_energy":           avg("bound_energy_density"),
            "avg_core_radiation":         avg("core_radiation_potential"),
            "avg_field_bond_depth":       avg("field_bond_depth"),
            "final_field_bond_depth":     results[-1]["field_bond_depth"],
            "field_radiant_rate":         avg("field_radiant_stable"),
            "field_radiant_rate_tail":    avg("field_radiant_stable", tail),
            "node14_rate_tail":           avg("node_14_active", tail),
            "avg_spiral_birth_integral":  avg("spiral_birth_integral"),   # NEU
        }

    def emit_state(self) -> Dict[str, Any]:
        node14_active = (
            self.field_bond_depth > PHI
            and self.radial_birth_integral > PHI2
            and self.capsule_visibility > 0.25
            and self.spiral_birth_integral > 0.10
        )
        boost = clamp01((self.field_bond_depth - PHI) * 2.0) if self.field_bond_depth > PHI else 0.0
        motor_states = []
        for i, motor in enumerate(self.motors):
            if not motor.snapshots:
                continue
            sn = motor.snapshots[-1]
            motor_states.append({
                "node_id":          i,
                "phase":            round(self.phases[i], 6),
                "regime":           sn.regime,
                "conception":       round(sn.conception_event, 4),
                "real_light":       round(sn.real_light_score, 4),
                "gravity":          round(sn.gravity_infold, 4),
                "observer_return":  round(sn.observer_return, 4),
                "capsule":          round(sn.capsule_density, 4),
                "radial_birth":     round(sn.radial_birth_score, 4),
                "spiral_birth":     round(sn.spiral_birth_score, 4),   # NEU
                "inner_turn_global": round(sn.inner_turn_global, 4),   # NEU
                "bond_to_field":    round(safe_mean(self.bond_matrix[i][j] for j in range(self.n_nodes) if j != i), 4),
            })
        return {
            "tick": self.iteration,
            "node_13": {
                "field_bond_depth":          round(self.field_bond_depth, 6),
                "core_radiation_potential":  round(self.core_radiation_potential, 6),
                "bound_energy_density":      round(self.bound_energy_density, 6),
                "feedback_active":           True,
            },
            "node_14": {
                "active":               node14_active,
                "field_resonance_boost": round(boost, 6),
                "bond_above_phi":       round(max(0.0, self.field_bond_depth - PHI), 6),
                "phi":                  round(PHI, 6),
            },
            "radial": {
                "radial_birth_integral":    round(self.radial_birth_integral, 6),
                "observer_return_integral": round(self.observer_return_integral, 6),
                "capsule_density":          round(self.capsule_density, 6),
                "capsule_visibility":       round(self.capsule_visibility, 6),
            },
            "spiral": {
                "spiral_birth_integral": round(self.spiral_birth_integral, 6),
            },
            "observer": {                       # Beobachter pervasiv im Feld
                "obs_immanence":     round(self.obs_immanence, 6),
                "obs_eff_global":    round(observer_return_eff(self.obs_immanence), 6),
                "observer_integral":  round(self.observer_return_integral, 6),
                "temporal_bridge":    round(self.temporal_bridge, 6),
                "obs_im_past":        round(self.obs_im_past, 6),
                "obs_im_future":      round(self.obs_im_future, 6),
            },
            "radiant_emission": node14_active,
            "motors": motor_states,
        }


