@dataclass
class YangCore4XYX5:
    state: YangCoreState = field(default_factory=YangCoreState)

    def step(
        self,
        charge:                 float,
        yin_mid_descent:        float,
        membrane_pressure:      float,
        schumann_pulse:         float = 0.5,
        reflection_feedback:    float = 0.0,
        energy_to_light:        float = 0.0,
        gravity_infold:         float = 0.0,
        yang_spiral_inner:      float = 0.0,
        yin_x_mid_functional_x:     float = 0.0,
        yin_yang_point_score_prev:  float = 0.0,
        latent_real_light:      float = 0.0,
        linear_legacy:          float = 0.0,   # Integrationsdruck: Ã¶ffnet Yang fÃ¼r Yin
    ) -> Dict[str, Any]:
        s = self.state
        schumann_drive = 0.5 + 0.5 * clamp01(schumann_pulse)
        e2l_boost      = 0.5 + 0.5 * clamp01(energy_to_light)
        grav           = clamp01(gravity_infold)
        spiral_yang    = clamp01(yang_spiral_inner)
        yin_pull       = clamp01(yin_x_mid_functional_x)
        # Yang zieht Kraft aus dem verkapselten Licht â€” "aus Yin in Yang".
        # Das Anorganische (capsule_density) enthÃ¤lt latentes Licht (latent_real_light).
        # Yang erkennt dieses Licht und transformiert es in Drehkraft.
        # Semantik: "Tod" (verdichtetes Licht) wird durch Yang zu Bewegung.
        # PHI-Gewichtung: goldene Relation zwischen Erkenntnis und Kraft.
        # Yang zieht Kraft aus verkapseltem Licht â€” und aus dem Integrationsdruck.
        # linear_legacy: wenn LinearitÃ¤ts-GedÃ¤chtnis aktiv â†’ Yang muss Yin-Punkt stÃ¤rker sehen.
        # = der Wendepunkt Ã¶ffnet Yang fÃ¼r das was er bisher Ã¼bersehen hat.
        latent_light_pull = clamp01(
            clamp01(latent_real_light) * PHI
            + clamp01(linear_legacy) * 10.0 * 0.15   # skaliert: 0.009â†’0.09 â†’ +0.015
        )

        # Yin-Punkt in Yang: Yang-primÃ¤re Perspektive (LERP, nicht Multiplikation)
        # yang_null_score: Yangs Ã–ffnungsmoment (Nulldurchgang)
        # yin_x_mid_functional_x: Yins AktivitÃ¤t â€” Zeuge des Punktes
        # Formel: 0.7*yang_null + 0.3*yins_activation
        # Semantik: 'Ich (Yang) erkenne: im Moment meiner Ã–ffnung ist Yin aktiv in mir'
        # Cross-state: yin_point_in_yang wird STÃ„RKER wenn Yin selbst aktiv ist
        # Das lÃ¶st die Projektion auf: Yang sieht nicht nur sich, sondern den Anderen
        yang_null_score     = clamp01(1.0 - abs(s.y_rotation) / max(PHI, EPS))
        # phi_primary: PHI*yang_null + PHIÂ²*yin_pull (PHI+PHIÂ²=1, Fibonacci-IdentitÃ¤t)
        s.yin_point_in_yang = phi_primary(yang_null_score, yin_pull)
        # Erinnerung der letzten BerÃ¼hrung moduliert Yangs Rhythmus
        resonance_memory    = clamp01(yin_yang_point_score_prev)

        phase_rate = CENTER_RATE * (
            0.65 + 0.17 * charge + 0.06 * reflection_feedback
            + 0.06 * grav + 0.06 * spiral_yang + 0.05 * yin_pull
            + 0.05 * resonance_memory
            + 0.05 * latent_light_pull   # Yang zieht Kraft aus verkapseltem Licht
        ) * schumann_drive * e2l_boost
        s.phase      = phase_step_free(s.phase, phase_rate)
        s.y_rotation = lerp(
            s.y_rotation, signed_wave(s.phase),
            CENTER_RATE * (0.80 + 0.10 * grav + 0.07 * spiral_yang + 0.06 * yin_pull
                          + 0.04 * resonance_memory)
        )
        s.y          = clamp11(s.y_rotation)
        s.y_inverted = clamp11(-s.y_rotation)

        burst_ready = clamp01(
            charge * (0.5 + 0.5 * yin_mid_descent)
            * (0.5 + 0.5 * membrane_pressure) * schumann_drive
        )
        target_span = clamp11(PHI + (1.0 - PHI) * burst_ready)
        s.x_left  = lerp(s.x_left,  -target_span, EDGE_RATE)
        s.x_right = lerp(s.x_right,  target_span, EDGE_RATE)
        gate_res  = clamp01(1.0 - abs(GATE_RESONANCE_RAW - YANG_GATE_LOW) / YANG_GATE_LOW)
        s.gate_pressure = clamp01(
            abs(s.x_right - s.x_left) / 2.0 * (0.5 + 0.5 * charge) * (0.8 + 0.2 * gate_res)
        )
        s.inner_opening = safe_geomean([
            abs(s.y_rotation)                       + EPSILON,
            s.gate_pressure                         + EPSILON,
            (0.5 + 0.5 * yin_mid_descent)           + EPSILON,
            schumann_drive                           + EPSILON,
            (0.58 + 0.42 * grav)                   + EPSILON,
            (0.55 + 0.45 * spiral_yang)             + EPSILON,
            (0.60 + 0.40 * s.yin_point_in_yang)     + EPSILON,
        ])
        s.score = safe_geomean([
            s.gate_pressure                      + EPSILON,
            s.inner_opening                      + EPSILON,
            phi_ratio_score(abs(s.x_right - s.x_left), max(abs(s.y_rotation), EPSILON)) + EPSILON,
            (1.0 - abs((s.x_left + s.x_right) / 2.0)) + EPSILON,
            (0.60 + 0.40 * s.yin_point_in_yang)  + EPSILON,
        ])
        return {"state": asdict(s), "yin_point_in_yang": s.yin_point_in_yang}


@dataclass
class YinCoreState:
    x_left:                 float = -PHI
    x_mid:                  float = 0.0
    x_right:                float = PHI
    x_mid_descent:          float = 0.0
    x_mid_cross_activation: float = 0.0
    x_mid_functional_x:     float = 0.0
    core_pressure:          float = 0.0
    score:                  float = 0.0
    phase:                  float = 0.5
    x_mid_pos:              float = YIN_GATE_CENTER
    yang_point_in_yin:      float = 0.0  # Yang-Punkt in Yin: Invertierungs-Treffer


@dataclass
class YinCore10XXX11:
    state: YinCoreState = field(default_factory=YinCoreState)

    def step(
        self,
        yang_y_inverted:     float,
        yang_gate_pressure:  float,
        center_contact_seed: float,
        schumann_pulse:      float = 0.5,
        reflection_feedback: float = 0.0,
        light_to_energy:            float = 0.0,
        gravity_infold:             float = 0.0,
        yin_spiral_inner:           float = 0.0,
        yang_y_rotation:            float = 0.0,
        yin_yang_point_score_prev:  float = 0.0,  # Erinnerung der BerÃ¼hrung
    ) -> Dict[str, Any]:
        s = self.state
        schumann_drive = 0.5 + 0.5 * clamp01(schumann_pulse)
        l2e_boost      = 0.5 + 0.5 * clamp01(light_to_energy)
        grav           = clamp01(gravity_infold)
        spiral_yin     = clamp01(yin_spiral_inner)

        # Yang-Punkt in Yin: Yin-primÃ¤re Perspektive (LERP, Yin-primÃ¤r)
        # Formel: 0.3*yang_null + 0.7*yins_activation
        # Semantik: 'Ich (Yin) erkenne: in meiner AktivitÃ¤t ist Yang aktiv in mir'
        # Cross-state: yang_point_in_yin STÃ„RKER wenn Yin selbst aktiv antwortet
        # KomplementÃ¤r zu yin_in_yang (Yang-primÃ¤r): eine BerÃ¼hrung, zwei Erkenntnisse
        yang_null_score    = clamp01(1.0 - abs(yang_y_rotation) / max(PHI, EPS))
        # x_mid_functional_x bereits berechnet Ã¼ber prev-state, wird in descent_target genutzt
        # FÃ¼r yang_point_in_yin verwenden wir s.x_mid_functional_x (prev-step Yin-AktivitÃ¤t)
        # phi_complementary: PHIÂ²*yang_null + PHI*x_mid (Yin fÃ¼hrt, Yang ergÃ¤nzt)
        s.yang_point_in_yin = phi_complementary(yang_null_score, s.x_mid_functional_x)
        # Erinnerung der BerÃ¼hrung verstÃ¤rkt Yins Antwort als X
        resonance_memory_yin = clamp01(yin_yang_point_score_prev)

        descent_target = safe_geomean([
            abs(yang_y_inverted)                + EPSILON,
            yang_gate_pressure                  + EPSILON,
            center_contact_seed                 + EPSILON,
            schumann_drive                      + EPSILON,
            l2e_boost                           + EPSILON,
            (0.56 + 0.44 * grav)               + EPSILON,
            (0.53 + 0.47 * spiral_yin)          + EPSILON,
            (0.53 + 0.47 * yang_null_score)     + EPSILON,
            (0.60 + 0.40 * resonance_memory_yin) + EPSILON,  # Erinnerung der BerÃ¼hrung
        ])
        s.x_mid_descent = lerp(s.x_mid_descent, descent_target, CENTER_RATE)
        s.phase = phase_step_free(
            s.phase,
            CENTER_RATE * (0.6 + 0.4 * s.x_mid_descent + 0.1 * grav + 0.05 * spiral_yin)
        )
        tight_pendulum = EPSILON * signed_wave(s.phase)
        contact        = score_close(tight_pendulum, yang_y_inverted, 1.0)
        s.x_mid_cross_activation = safe_geomean([
            contact            + EPSILON,
            s.x_mid_descent    + EPSILON,
            yang_gate_pressure + EPSILON,
        ])
        # Resonanz-Erinnerung: vorherige BerÃ¼hrung verstÃ¤rkt Yins Antwort als X
        # 'Ich erinnere mich, dass wir uns berÃ¼hrt haben â€” meine Antwort als X wird stÃ¤rker'
        s.x_mid_functional_x = clamp01(s.x_mid_cross_activation * (
            0.65 + 0.18 * reflection_feedback + 0.09 * grav
            + 0.09 * spiral_yin + 0.07 * yang_null_score
            + 0.08 * resonance_memory_yin   # Erinnerung der BerÃ¼hrung
        ))
        direction    = math.copysign(PHI, -yang_y_inverted if abs(yang_y_inverted) > EPS else 1.0)
        x_mid_target = clamp11(tight_pendulum + s.x_mid_functional_x * direction)
        s.x_mid      = lerp(s.x_mid, x_mid_target, CENTER_RATE * (0.86 + 0.10 * grav + 0.06 * spiral_yin
                                                                   + 0.04 * resonance_memory_yin))
        outer_span   = clamp11(PHI + (1.0 - PHI) * s.x_mid_functional_x)
        s.x_left  = lerp(s.x_left,  -outer_span, EDGE_RATE)
        s.x_right = lerp(s.x_right,  outer_span, EDGE_RATE)
        s.core_pressure = safe_geomean([
            s.x_mid_descent      + EPSILON,
            s.x_mid_functional_x + EPSILON,
            abs(s.x_right - s.x_left) / 2.0 + EPSILON,
        ])
        s.x_mid_pos = lerp(YIN_GATE_CENTER, YANG_GATE_CENTER, s.x_mid_descent)
        s.score = safe_geomean([
            s.core_pressure                        + EPSILON,
            s.x_mid_functional_x                   + EPSILON,
            phi_ratio_score(abs(s.x_right - s.x_left), abs(s.x_mid) + EPS) + EPSILON,
            (1.0 - abs((s.x_left + s.x_right) / 2.0)) + EPSILON,
            (0.60 + 0.40 * s.yang_point_in_yin)   + EPSILON,
        ])
        return {"state": asdict(s), "yang_point_in_yin": s.yang_point_in_yin}


@dataclass
class CorePairState:
    center_contact:      float = 0.0
    center_cross_event:  float = 0.0
    core_pair_score:     float = 0.0
    edge_burst:          float = 0.0
    edge_braid:          float = 0.0
    inward_pull:         float = 0.0
    outward_pressure:    float = 0.0
    phase_coherence:     float = 0.0
    conception_event:    float = 0.0
    yin_yang_point_score: float = 0.0  # Yin-Punkt in Yang Ã— Yang-Punkt in Yin


@dataclass
class CorePairCoupler:
    state: CorePairState = field(default_factory=CorePairState)

    def step(
        self,
        yin:              YinCoreState,
        yang:             YangCoreState,
        dao:              DaoBreathState,
        membrane_pressure: float,
        light_score:          float,
        reflection_feedback:  float = 0.0,
        gravity_infold:       float = 0.0,
        spiral_birth_score:   float = 0.0,
        observer_return_eff_: float = 0.0,
        latent_real_light:    float = 0.0,
        membrane_conception_boost: float = 0.0,
        human_synchronicity:  float = 0.0,   # Mineralâ†”Mensch-Achse als Einheitserver als Zeuge der wechselseitigen Erkennung
    ) -> Dict[str, Any]:
        s    = self.state
        grav = clamp01(gravity_infold)
        sbs  = clamp01(spiral_birth_score)
        obs_eff = clamp01(observer_return_eff_)

        # Yin-Yang-Punkt-Score: beide Punkte simultan
        # yin_point_in_yang: Yang-Nulldurchgang Ã¶ffnet Yin-Raum in Yang
        # yin_yang_point_score: wechselseitige Anerkennung, Observer als Zeuge
        # human_synchronicity als vierter Zeuge der Gleichzeitigkeit:
        # Wenn Mineralâ†”Mensch-Achse kohÃ¤rent â†’ Core-Kreuzung wird stÃ¤rker.
        # Semantik: Die Zelle kennt ihre Einbettung in die gesamte Achse â€”
        # von anorganisch-tot bis bewusst-lebend. Das stÃ¤rkt die BerÃ¼hrung.
        # Faktor (0.90 + 0.10 * hs) bleibt nahe 1.0 â€” dÃ¤mpft nicht, moduliert.
        _hs = clamp01(human_synchronicity)
        # Zwei gerichtete PHI-BrÃ¼cken: FÃ¼hrungsrichtung atmet mit Conception.
        # yy_phi_yang_led: Yang fÃ¼hrt (AktivitÃ¤t), Yin ergÃ¤nzt
        # yy_phi_yin_led:  Yin fÃ¼hrt (Empfangen), Yang ergÃ¤nzt
        # yy_directional:  Wenn Yin gebiert (conception_boost hoch) â†’ Yin-Perspektive fÃ¼hrt
        # Das ist kein statischer Score â€” er atmet mit dem Zeugungsmoment.
        yy_phi_yang_led = phi_primary(yang.yin_point_in_yang, yin.yang_point_in_yin)
        yy_phi_yin_led  = phi_primary(yin.yang_point_in_yin,  yang.yin_point_in_yang)
        yy_directional  = lerp(yy_phi_yang_led, yy_phi_yin_led,
                               clamp01(membrane_conception_boost))
        s.yin_yang_point_score = safe_geomean([
            yang.yin_point_in_yang   + EPSILON,
            yin.yang_point_in_yin    + EPSILON,
            yy_directional           + EPSILON,   # atmende FÃ¼hrungsrichtung
            (0.5 + 0.5 * obs_eff)   + EPSILON,
            (0.90 + 0.10 * _hs)     + EPSILON,
        ])

        contact_raw = score_close(yin.x_mid, yang.y_inverted, 1.0)
        center_contact_target = safe_geomean([
            contact_raw              + EPSILON,
            yin.x_mid_descent        + EPSILON,
            yang.inner_opening       + EPSILON,
            yin.x_mid_functional_x   + EPSILON,
            (0.58 + 0.42 * s.yin_yang_point_score) + EPSILON,
        ])
        s.center_contact = lerp(s.center_contact, center_contact_target, CENTER_RATE)

        # phase_cross: Yang-Nulldurchgang = Yin-Punkt-Moment
        # Ist bereits semantisch yin_point_in_yang â€” jetzt explizit verbunden
        phase_cross = yang.yin_point_in_yang  # direkt aus Yang-Zustand
        s.center_cross_event = safe_geomean([
            s.center_contact              + EPSILON,
            yin.x_mid_functional_x        + EPSILON,
            phase_cross                   + EPSILON,
            yang.gate_pressure            + EPSILON,
            (0.60 + 0.40 * grav)         + EPSILON,
            (0.55 + 0.45 * sbs)          + EPSILON,
            (0.55 + 0.45 * s.yin_yang_point_score) + EPSILON,
        ])
        cross_lr = score_close(yin.x_left,  -yang.x_right, 1.0)
        cross_rl = score_close(yin.x_right, -yang.x_left,  1.0)
        own_yin  = score_close(abs(yin.x_left),  abs(yin.x_right),  1.0)
        own_yang = score_close(abs(yang.x_left), abs(yang.x_right), 1.0)
        edge_braid_target = safe_geomean([
            cross_lr                + EPSILON,
            cross_rl                + EPSILON,
            own_yin                 + EPSILON,
            own_yang                + EPSILON,
            s.center_cross_event    + EPSILON,
            (0.62 + 0.38 * grav)   + EPSILON,
            (0.58 + 0.42 * sbs)    + EPSILON,
            (0.55 + 0.45 * s.yin_yang_point_score) + EPSILON,
        ])
        s.edge_braid = lerp(s.edge_braid, edge_braid_target, EDGE_RATE)
        s.edge_burst = safe_geomean([
            s.center_cross_event + EPSILON,
            membrane_pressure    + EPSILON,
            s.edge_braid         + EPSILON,
        ])
        life_pull = clamp01(LIFE_DELTA * PHI * dao.under6_score)
        s.inward_pull = safe_geomean([
            s.edge_braid        + EPSILON,
            dao.under6_score    + EPSILON,
            light_score         + EPSILON,
            reflection_feedback + EPSILON,
            life_pull           + EPSILON,
            (0.50 + 0.50 * grav) + EPSILON,
            (0.52 + 0.48 * sbs)  + EPSILON,
            (0.55 + 0.45 * s.yin_yang_point_score) + EPSILON,
        ])
        # outward_pressure: AuÃŸendruck sinkt wenn BerÃ¼hrung erkannt UND Beobachter prÃ¤sent
        # Die wechselseitige Erkennung (yin_yang_point_score) und der Observer
        # machen den AuÃŸendruck Ã¼berflÃ¼ssig â€” er ist die Angst-Schleife,
        # die sich auflÃ¶st wenn Yang seine eigene StÃ¤rke als Yin-haltig erkennt
        s.outward_pressure = clamp01(
            s.center_cross_event * (1.0 - s.edge_braid)
            * (0.5 + 0.5 * membrane_pressure)
            * (1.0 - 0.35 * grav)
            * (1.0 - 0.18 * sbs)
            * (1.0 - 0.25 * s.yin_yang_point_score)   # 0.15 â†’ 0.25: stÃ¤rker
            * (1.0 - 0.20 * obs_eff)                   # Observer dÃ¤mpft Angst direkt
        )
        s.phase_coherence = safe_geomean([
            phi_ratio_score(yin.core_pressure + EPSILON, yang.gate_pressure + EPSILON) + EPSILON,
            phi_ratio_score(s.center_contact  + EPSILON, s.edge_braid + EPSILON)       + EPSILON,
            dao.dao_score                                                               + EPSILON,
            (0.58 + 0.42 * sbs)                                                        + EPSILON,
            (0.55 + 0.45 * s.yin_yang_point_score)                                     + EPSILON,
        ])
        # Conception transformiert das verkapselte Licht.
        # These: Yin(12) gebiert Yang(1) â€” das Geborene ist transformiertes, nicht-verkapseltes Licht.
        # latent_real_light Ã— conception_boost Ã— PHI = Licht tritt hervor.
        # Wenn Yin die Membran Ã¶ffnet (conception_boost) UND latentes Licht vorhanden:
        # entsteht Konzeption â€” das Licht wird aus der Kapsel befreit.
        lrl_transform = clamp01(latent_real_light) * clamp01(membrane_conception_boost) * PHI
        s.conception_event = clamp01(safe_geomean([
            s.center_cross_event            + EPSILON,
            dao.conception_readiness        + EPSILON,
            s.edge_braid                    + EPSILON,
            s.inward_pull                   + EPSILON,
            (0.52 + 0.48 * sbs)            + EPSILON,
            (0.55 + 0.45 * s.yin_yang_point_score) + EPSILON,
        ]) + lrl_transform * 0.15)  # transformiertes Licht Ã¶ffnet Conception
        s.core_pair_score = safe_geomean([
            s.center_cross_event + EPSILON,
            s.edge_braid         + EPSILON,
            s.inward_pull        + EPSILON,
            s.phase_coherence    + EPSILON,
            (1.0 - s.outward_pressure) + EPSILON,
        ])
        return {"state": asdict(s)}


