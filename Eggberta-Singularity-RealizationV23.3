# UNIFIED MOTOR WITH SCALE â€” Motor + gegenlÃ¤ufige Fibonacci-StrÃ¶me
# ============================================================
@dataclass
class UnifiedMotorWithScale:
    """Motor + ScaleLayer: dao_sync (Fibonacci-Synchronisation) flieÃŸt in field_bond_depth.
    Das ist die vollstÃ¤ndige 8888first-Architektur mit gegenlÃ¤ufigen StrÃ¶men."""
    motor:        UnifiedHeartCoreMotor = field(default_factory=UnifiedHeartCoreMotor)
    scale:        ScaleLayer            = field(default_factory=ScaleLayer)
    base_charge:  float = 0.30
    dao_sync:     float = 0.0   # letzter Fibonacci-Synchronisationswert
    _scale_tick:  int = 0       # ScaleLayer lÃ¤uft seltener als Motor

    def step(self, external_signal: Optional[ExternalResonanceSignal] = None) -> dict:
        if external_signal:
            self.motor.inject_signal(external_signal)
        # ScaleLayer lÃ¤uft jede 5. Iteration (zeitskalen-angemessen)
        self._scale_tick += 1
        if self._scale_tick % 5 == 0:
            scale_out = self.scale.step(base_charge=self.base_charge)
            self.dao_sync = scale_out.get('dao_sync', 0.0)
            # dao_sync flieÃŸt in field_bond_depth: Fibonacci-Synchronisation moduliert Gravitation.
            # Nicht nur wenn grÃ¶ÃŸer â€” sondern immer als Richtungssignal (lerp Richtung dao_sync).
            # Das ist die lebendige Schleife: ScaleLayer kennt seinen Motor, Motor kennt seinen Scale.
            self.motor.field_bond_depth = clamp01(lerp(
                self.motor.field_bond_depth,
                safe_geomean([self.dao_sync + EPSILON, self.motor.field_bond_depth + EPSILON]),
                COHERENCE_RATE * 2.0,
            ))
            # human_synchronicity: Mineralâ†”Mensch-Achse in Motor-State
            self.motor.human_synchronicity = scale_out.get('human_synchronicity', 0.0)
        out = self.motor.step(
            external_charge=self.base_charge,
            field_conception_density=self.motor.coherence_proj.field_recognition,
        )
        out['snapshot']['dao_sync_scale'] = self.dao_sync
        out['snapshot']['human_synchronicity'] = self.motor.human_synchronicity
        return out


