        4:  "Yang-Core left gate / water side of 4|5",
        5:  "Yang-Core right gate / fire side of 4|5",
        6:  "DAO touchpoint â€” contact, not static being",
        7:  "dynamic Venus / cardinal air / Y-switch upper pole",
        8:  "depth boundary / fixed water / lower_overlay_1|8 target",
        9:  "lower-total closure / fire horizon / depth_seam_8|9 upper",
        10: "Yin-Core left gate / earth side of 10|11",
        11: "Yin-Core right gate / air side of 10|11",
        12: "source return / water membrane / birth_seam_12|1 upper",
    })
    source_birth_seam:    Tuple[int, int] = (12, 1)
