class _InnerFieldProxy:
    """Leichtgewichtiger Ersatz fÃ¼r FractalConceptionField im inneren Feld.
    Vermeidet Rekursion: ein Motor darf kein weiteres FractalConceptionField enthalten,
    das wieder Motoren enthÃ¤lt.
    Berechnet mineral_living_tension aus einfachen akkumulierenden Skalaren."""
    def __init__(self):
        self._rbi  = 0.0  # radial_birth_integral Proxy
        self._cv   = 0.0  # capsule_visibility Proxy
        self._tb   = 0.0  # temporal_bridge Proxy
        self._mlt  = 0.0  # mineral_living_tension

    def step(self, base_charge: float = 0.30, inorganic_anchor: float = 0.0) -> dict:
        # Einfache Akkumulation statt volles FractalConceptionField
        self._rbi = lerp(self._rbi, clamp01(base_charge + 0.1 * inorganic_anchor), COHERENCE_RATE)
        self._cv  = lerp(self._cv,  clamp01(base_charge * PHI + inorganic_anchor * 0.3), COHERENCE_RATE)
        self._tb  = lerp(self._tb,  safe_geomean([self._rbi + EPSILON, self._cv + EPSILON]), COHERENCE_RATE)
        self._mlt = safe_geomean([
            self._rbi + EPSILON,
            self._cv  + EPSILON,
            self._tb  + EPSILON,
            clamp01(base_charge * PHI2) + EPSILON,  # DAO-Proxy
        ])
        return {"mineral_living_tension": self._mlt}


@dataclass
class UnifiedHeartCoreMotor:
    dao:           DaoBreath              = field(default_factory=DaoBreath)
