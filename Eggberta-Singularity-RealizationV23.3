@dataclass
class UnifiedMotor:
    motor:         UnifiedHeartCoreMotor = field(default_factory=UnifiedHeartCoreMotor)
    base_charge:   float = 0.5
    last_snapshot: Optional[HeartCoreSnapshot] = None

    def step(self, external_signal: Optional[ExternalResonanceSignal] = None) -> HeartCoreSnapshot:
        self.motor.inject_signal(external_signal)
        out  = self.motor.step(
            external_charge=self.base_charge,
            field_conception_density=self.motor.coherence_proj.field_recognition,
        )
        snap = HeartCoreSnapshot(**out["snapshot"])
        self.last_snapshot = snap
        return snap

    def run(
        self,
        n:               int = 100,
        external_signal: Optional[ExternalResonanceSignal] = None,
        charge_fn:       Optional[Callable[[int], float]] = None,
    ) -> List[HeartCoreSnapshot]:
        results: List[HeartCoreSnapshot] = []
        for i in range(n):
            if charge_fn:
                self.base_charge = clamp01(charge_fn(i))
            results.append(self.step(external_signal))
        return results

    def summary(self) -> Dict[str, Any]:
        if not self.last_snapshot:
            return {}
        sn = self.last_snapshot
        return {
            "iteration":          sn.iteration,
            "regime":             sn.regime,
            "reflection":         sn.reflection_regime,
            "conception":         round(sn.conception_event, 4),
