@dataclass
class HeartArcs:
    state: HeartArcState = field(default_factory=HeartArcState)

    def step(
        self,
        center_cross_event:     float,
        edge_braid:             float,
        membrane_release:       float,
        dao_score:              float,
        schumann_pulse:         float = 0.5,
        field_conception_density: float = 0.0,
        core_pair_score:        float = 0.0,
        gravity_infold:         float = 0.0,
        spiral_birth_score:     float = 0.0,  # NEU
    ) -> Dict[str, Any]:
        s    = self.state
        grav = clamp01(gravity_infold)
        sbs  = clamp01(spiral_birth_score)
        l2e_target = safe_geomean([
            center_cross_event                 + EPSILON,
            edge_braid                         + EPSILON,
            dao_score                          + EPSILON,
            (schumann_pulse * SCHUMANN_ARC_18) + EPSILON,
            (0.5 + 0.5 * field_conception_density) + EPSILON,
            (0.55 + 0.45 * grav)              + EPSILON,
            (0.60 + 0.40 * sbs)               + EPSILON,
        ])
        s.light_to_energy = lerp(s.light_to_energy, l2e_target, EDGE_RATE)
        e2l_target = safe_geomean([
            membrane_release                   + EPSILON,
            edge_braid                         + EPSILON,
            phi_ratio_score(center_cross_event + EPSILON, membrane_release + EPSILON) + EPSILON,
            (schumann_pulse * SCHUMANN_ARC_81) + EPSILON,
            (0.5 + 0.5 * core_pair_score)     + EPSILON,
            (0.55 + 0.45 * grav)              + EPSILON,
            (0.55 + 0.45 * sbs)               + EPSILON,
        ])
        s.energy_to_light = lerp(s.energy_to_light, e2l_target, EDGE_RATE)
        s.lower_arc_1_8   = safe_geomean([s.light_to_energy + EPSILON, s.energy_to_light + EPSILON])
        s.mars_pluto_transform = s.lower_arc_1_8
        s.arc_balance     = phi_ratio_score(s.light_to_energy + EPS, s.energy_to_light + EPS)
        upper_target = safe_geomean([
            membrane_release      + EPSILON,
            edge_braid            + EPSILON,
            s.arc_balance         + EPSILON,
            (0.55 + 0.45 * grav)  + EPSILON,
            (0.55 + 0.45 * sbs)   + EPSILON,
        ])
        s.upper_arc_2_7      = lerp(s.upper_arc_2_7, upper_target, EDGE_RATE)
        s.venus_contact_form = s.upper_arc_2_7
        s.return_force = safe_geomean([
            s.lower_arc_1_8   + EPSILON,
            s.upper_arc_2_7   + EPSILON,
            edge_braid        + EPSILON,
            (0.60 + 0.40 * grav) + EPSILON,
            (0.55 + 0.45 * sbs)  + EPSILON,
        ])
        s.arc_score = safe_geomean([
            s.return_force         + EPSILON,
            s.arc_balance          + EPSILON,
            s.mars_pluto_transform + EPSILON,
        ])
        return {
            "state": asdict(s),
            "light_to_energy": s.light_to_energy,
            "energy_to_light": s.energy_to_light,
            "arc_balance":     s.arc_balance,
        }


