@dataclass
class UnifiedMotor:
    """
    Schlanker Einzelmotor. Alle Komponenten direkt als Attribute.
    Kein FractalField-Overhead â€” fÃ¼r direkte Nutzung und Integration.
    """
    iteration: int = 0
    dao: DaoBreath = field(default_factory=DaoBreath)
    yang: YangCore4XYX5 = field(default_factory=YangCore4XYX5)
    yin: YinCore10XXX11 = field(default_factory=YinCore10XXX11)
    coupler: CorePairCoupler = field(default_factory=CorePairCoupler)
    arcs: HeartArcs = field(default_factory=HeartArcs)
    membranes: MembranePair12_1_8_9 = field(default_factory=MembranePair12_1_8_9)
    light: LightResonanceLayer = field(default_factory=LightResonanceLayer)
    reflection: BarbeloReflectionLayer = field(default_factory=BarbeloReflectionLayer)
    projection: CoherenceProjectionLayer = field(default_factory=CoherenceProjectionLayer)
    diamond: RelationalDiamond921 = field(default_factory=RelationalDiamond921)
    base_charge: float = 0.5
    last_snapshot: Optional[HeartCoreSnapshot] = None

    def step(self,
             external_signal: Optional[ExternalResonanceSignal] = None
             ) -> HeartCoreSnapshot:

        damping = self.projection.instability.damping_factor()
        rel_boost = self.projection.instability.release_boost()

        # DAO â€” shadow_light flieÃŸt in conception_readiness
        dao_out = self.dao.step(
            core_feedback=self.projection.core_feedback,
            reflection_feedback=self.projection.reflection_feedback,
            instability_damping=damping,
            release_boost=rel_boost,
            shadow_light_feedback=self.light.state.shadow_light,
        )
        schumann = dao_out["schumann_pulse"]

        # Effektive Ladung mit Feld-Feedback (Node 13 vereinfacht)
        eff_charge = clamp01(
            self.base_charge
            + self.projection.field_recognition * FIELD_BOND_CHARGE_WEIGHT
        )

        # Yang & Yin
        self.yang.step(
            charge=eff_charge,
            yin_mid_descent=self.yin.state.x_mid_descent,
            membrane_pressure=self.membranes.state.pressure,
            schumann_pulse=schumann,
            reflection_feedback=self.projection.reflection_feedback,
            energy_to_light=self.arcs.state.energy_to_light,
        )
        self.yin.step(
            yang_y_inverted=self.yang.state.y_inverted,
            yang_gate_pressure=self.yang.state.gate_pressure,
            center_contact_seed=self.coupler.state.center_contact,
            schumann_pulse=schumann,
            reflection_feedback=self.projection.reflection_feedback,
            light_to_energy=self.arcs.state.light_to_energy,
        )

        # Zeugungsakt
        self.coupler.step(
            yin=self.yin.state, yang=self.yang.state,
            dao=self.dao.state,
            membrane_pressure=self.membranes.state.pressure,
            light_score=self.light.state.light_score,
            reflection_feedback=self.projection.reflection_feedback,
        )
        self.arcs.step(
            center_cross_event=self.coupler.state.center_cross_event,
            edge_braid=self.coupler.state.edge_braid,
            membrane_release=self.membranes.state.release,
            dao_score=self.dao.state.dao_score,
            schumann_pulse=schumann,
            field_conception_density=self.projection.field_recognition,
            core_pair_score=self.coupler.state.core_pair_score,
        )

        # Membran
        mem_out = self.membranes.step(
            center_release=self.coupler.state.center_cross_event,
            edge_braid=self.coupler.state.edge_braid,
            inward_pull=self.coupler.state.inward_pull,
            outward_pressure=self.coupler.state.outward_pressure,
            lower_heart_return=self.arcs.state.lower_arc_1_8,
            upper_heart_return=self.arcs.state.upper_arc_2_7,
            conception_event=self.coupler.state.conception_event,
            schumann_pulse=schumann,
            reflection_feedback=self.projection.reflection_feedback,
            dao_score=self.dao.state.dao_score,
            core_score=self.coupler.state.core_pair_score,
            reflection_score=self.reflection.state.self_recognition_score,
            coherence_score=clamp01(1.0 - self.projection.residual_flux),
            damping=damping,
            release_boost=rel_boost,
        )

        # Licht
        self.light.step(
            core_pair=self.coupler.state,
            dao=self.dao.state,
            membrane=self.membranes.state,
            reflection_feedback=self.projection.reflection_feedback,
            release_flux=self.projection.release_flux,
            field_recognition=self.projection.field_recognition,
            external=external_signal,
        )

        # Barbelo
        self.reflection.step(
            yin=self.yin.state, yang=self.yang.state,
            core_pair=self.coupler.state, dao=self.dao.state,
            membrane=self.membranes.state, heart=self.arcs.state,
            light=self.light.state,
            field_recognition=self.projection.field_recognition,
            instability_pressure=self.projection.instability.pressure_live,
        )

        # KohÃ¤renzprojektion
        proj_out = self.projection.step(
            dao_score=self.dao.state.dao_score,
            dao_under=self.dao.state.under6_score,
            dao_split=self.dao.state.split_risk,
            core_pair_score=self.coupler.state.core_pair_score,
            outer_cross=self.coupler.state.edge_braid,
            inward_pull=self.coupler.state.inward_pull,
            membrane_score=self.membranes.state.membrane_score,
            membrane_release=self.membranes.state.release,
            membrane_risk=mem_out["outer_inversion_risk"],
            moment_perm=self.membranes.state.permeability_moment,
            light_score=self.light.state.light_score,
            light_identity=self.light.state.identity_preservation,
            light_coherence=self.light.state.light_coherence,
            reflection_score=self.reflection.state.self_recognition_score,
            reflection_return=self.reflection.state.return_to_source,
            reflection_feedback_in=self.reflection.state.reflection_feedback,
            field_conception_density=self.projection.field_recognition,
            arc_balance=self.arcs.state.arc_balance,
            shadow_correction_signal=self.light.state.shadow_correction_signal,
        )

        # Diamond
        self.diamond.step(damping=damping, release_boost=rel_boost)

        # Energie
        energy = compute_energy(
            self.coupler.state, self.dao.state,
            self.membranes.state, self.arcs.state, self.light.state,
        )

        # Regime
        net = energy["net_coherence_gain"]
        fus = energy["fusion_like_gain"]
        risk = mem_out["outer_inversion_risk"]
        cps = self.coupler.state
        mem_s = self.membranes.state
        if risk > 0.35 and risk > fus:
            regime = "outer_inversion_risk"
        elif fus > 0.68 and cps.edge_braid > 0.62 and mem_s.membrane_score > 0.50:
            regime = "radiant_stable"
        elif cps.edge_braid > 0.55 and cps.inward_pull > 0.50:
            regime = "heart_folding"
        elif mem_s.release > 0.30:
            regime = "membrane_pulse"
        elif cps.center_cross_event > 0.30:
            regime = "center_contact"
        else:
            regime = "charging"

        dissolved = (self.projection.instability.ledger[-1].dissolved
                     if self.projection.instability.ledger else False)

        snap = HeartCoreSnapshot(
            iteration=self.iteration,
            regime=regime,
            reflection_regime=self.reflection.state.regime,
            dao_score=self.dao.state.dao_score,
            schumann_pulse=schumann,
            conception_readiness=self.dao.state.conception_readiness,
            conception_event=cps.conception_event,
            center_cross_event=cps.center_cross_event,
            edge_braid=cps.edge_braid,
            inward_pull=cps.inward_pull,
            outward_pressure=cps.outward_pressure,
            membrane_score=mem_s.membrane_score,
            seam_anti_sync=mem_s.seam_anti_sync,
            opening_12_1=mem_s.opening_12_1,
            opening_8_9=mem_s.opening_8_9,
            light_score=self.light.state.light_score,
            shadow_light=self.light.state.shadow_light,
            shadow_recognition=self.light.state.shadow_recognition,
            shadow_correction_signal=self.light.state.shadow_correction_signal,
            light_to_energy=self.arcs.state.light_to_energy,
            energy_to_light=self.arcs.state.energy_to_light,
            arc_balance=self.arcs.state.arc_balance,
            field_recognition=self.projection.field_recognition,
            self_recognition=self.reflection.state.self_recognition_score,
            coherence=proj_out["coherence"],
            release_flux=proj_out["release_flux"],
            residual_flux=proj_out["residual_flux"],
            fusion_like_gain=fus,
            net_coherence_gain=net,
            outer_inversion_risk=risk,
            # Erweiterte Felder
            membrane_release=mem_s.release,
            trauma_loop_release=mem_s.trauma_loop_release,
            fusion_gain=fus,
            instability_pressure=self.projection.instability.pressure_live,
            dissolved=dissolved,
            self_recognition_score=self.reflection.state.self_recognition_score,
        )
        self.last_snapshot = snap
        self.iteration += 1
        return snap

    def run(self, n: int = 100,
            external_signal: Optional[ExternalResonanceSignal] = None,
            charge_fn=None) -> List[HeartCoreSnapshot]:
        results = []
        for i in range(n):
            if charge_fn:
                self.base_charge = clamp01(charge_fn(i))
            results.append(self.step(external_signal))
        return results

    def summary(self) -> Dict[str, Any]:
        if not self.last_snapshot:
            return {}
        sn = self.last_snapshot
        return {
            "iteration": sn.iteration,
            "regime": sn.regime,
            "conception": round(sn.conception_event, 4),
            "fusion": round(sn.fusion_gain, 4),
            "net": round(sn.net_coherence_gain, 4),
            "shadow_rec": round(sn.shadow_recognition, 4),
            "self_rec": round(sn.self_recognition_score, 4),
            "field_rec": round(sn.field_recognition, 4),
            "instability": round(sn.instability_pressure, 4),
            "dissolved": sn.dissolved,
        }

