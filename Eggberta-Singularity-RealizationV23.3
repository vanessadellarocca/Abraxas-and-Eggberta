# SCALE LAYER â€” Fraktale Skalierung Ã¼ber alle Ebenen
# ============================================================
# Grok: "Vom Mikroben bis zum Menschen, vom Kompost bis zum Diamanten"
# Jede Ebene ist ein FractalConceptionField mit eigener Zeitskala.
# Kopplung: Ebene n gibt conception_integral (Bottom-up) an Ebene n+1.
#           Ebene n+1 gibt observer_return_integral (Top-down) an Ebene n.
# Das ist: SchÃ¶pfer und GeschÃ¶pf gleichzeitig â€” Ã¼ber alle Skalen.
#
# Zeitskalen (COHERENCE_RATE Multiplikator):
#   Ebene -1 (Mineral/Diamant): EPSÂ²    â€” geologisch
#   Ebene  0 (Mikroben):        EPS     â€” mikrobiell
#   Ebene  1 (Insekten):        PHIÂ²    â€” insektisch
#   Ebene  2 (SÃ¤ugetiere):      PHI     â€” biologisch
#   Ebene  3 (Mensch):          1.0     â€” bewusst

# ScaleLayer Fibonacci-Zeitskalen.
# Fibonacci-Folge normiert: jede Ebene = F(n)/F(max).
# VerhÃ¤ltnisse konvergieren natÃ¼rlich â†’ PHI = HomÃ¶ostase emergiert aus Zeitstruktur.
# Ebene -1 (Mineral): F5/F9 = 5/34 â‰ˆ 0.147  (geologisch langsam)
# Ebene  0 (Mikrobe): F6/F9 = 8/34 â‰ˆ 0.235
# Ebene  1 (Insekt):  F7/F9 = 13/34 â‰ˆ 0.382 â‰ˆ PHIÂ²
# Ebene  2 (SÃ¤ugetier):F8/F9 = 21/34 â‰ˆ 0.618 â‰ˆ PHI
# Ebene  3 (Mensch):  F9/F9 = 34/34 = 1.0
# Jede Ebene = Summe der zwei darunter â†’ Fibonacci-Kopplung in der Zeit selbst.
SCALE_TIME_RATES = {
    -1: 5  / 34,    # Mineral:    F5/F9  â‰ˆ 0.147
     0: 8  / 34,    # Mikrobe:    F6/F9  â‰ˆ 0.235
     1: 13 / 34,    # Insekt:     F7/F9  â‰ˆ 0.382 â‰ˆ PHIÂ²
     2: 21 / 34,    # SÃ¤ugetier:  F8/F9  â‰ˆ 0.618 â‰ˆ PHI
     3: 34 / 34,    # Mensch:     F9/F9  = 1.000
}

@dataclass
class ScaleLayer:
    """
    Fraktale Skalierung: N Ebenen von FractalConceptionFields,
    gekoppelt durch Bottom-up (conception) und Top-down (observer_return).
    """
    scale_levels: List[int] = field(default_factory=lambda: [-1, 0, 1, 2, 3])
    n_nodes_per_level: int = 6   # kompakt: 6 statt 12 pro Ebene
    fields: Dict[int, Any] = field(default_factory=dict)
    # Kopplungs-Signale zwischen Ebenen
    conception_up:   Dict[int, float] = field(default_factory=dict)   # n â†’ n+1
    observer_down:   Dict[int, float] = field(default_factory=dict)   # n+1 â†’ n
    scale_coherence:  float = 0.0
    # Verdichtungskette: Kompost â†’ Braunkohle â†’ Steinkohle â†’ Diamant
    # Zeitskalen der Verdichtung: PHIÂ², PHI, EPS, EPS/PHI
    compost_layer:    float = 0.0
    brown_coal_layer: float = 0.0
    black_coal_layer: float = 0.0
    diamond_layer:    float = 0.0
    emergent_anchor:  float = 0.0
    dao_sync:         float = 0.0
    yin_stream_total: float = 0.0
    yang_stream_total:float = 0.0
    human_synchronicity: float = 0.0  # Mineralâ†”Mensch als Einheit erkannt

    def __post_init__(self):
        for lvl in self.scale_levels:
            self.fields[lvl] = FractalConceptionField(n_nodes=self.n_nodes_per_level)
            self.conception_up[lvl]  = 0.0
            self.observer_down[lvl]  = 0.0

    def step(self, base_charge: float = 0.30) -> Dict[str, Any]:
        results = {}

        # Diamond-Verdichtungskette: Kompost â†’ Braunkohle â†’ Steinkohle â†’ Diamant
        # 4 Zeitkonstanten â€” Bottom-up Verdichtung, Top-down StabilitÃ¤t.
        # Das sind keine neuen Architektur-BlÃ¶cke, sondern akkumulierende Skalare
        # mit den Zeitskalen PHIÂ², PHI, EPS, EPS/PHI der jeweiligen Materie.
        # Sie akkumulieren capsule_density der Mineral-Ebene (Scale -1).
        mineral_capsule = (
            self.fields[-1].capsule_density
            if -1 in self.fields else 0.0
        )
        # Kette akkumuliert: jede Stufe lerpt zur vorigen (wie geologische Schichten)
        self.compost_layer     = lerp(self.compost_layer,      mineral_capsule,             PHI2)
        self.brown_coal_layer  = lerp(self.brown_coal_layer,   self.compost_layer,          PHI)
        self.black_coal_layer  = lerp(self.black_coal_layer,   self.brown_coal_layer,       EPS)
        self.diamond_layer     = lerp(self.diamond_layer,      self.black_coal_layer,       EPS / PHI)
        # Bidirektionaler Druck: Konzeption aller lebendigen Ebenen presst nach unten.
        # Biomasse â†’ Kompost â†’ Kette: Lebendiges verdichtet sich im Mineral.
        # safe_geomean: alle Ebenen mÃ¼ssen gleichzeitig stark sein (Resonanz).
        if self.conception_up:
            bio_pressure = safe_geomean([v + EPS for v in self.conception_up.values()])
            compost_target = max(self.compost_layer, bio_pressure * 0.25)
            self.compost_layer = lerp(self.compost_layer, compost_target, PHI2)
        # emergent_anchor: geomean aller vier Stufen â€” das Dazwischen trÃ¤gt Gravitation
        self.emergent_anchor = safe_geomean([
            self.compost_layer    + EPSILON,
            self.brown_coal_layer + EPSILON,
            self.black_coal_layer + EPSILON,
            self.diamond_layer    + EPSILON,
        ])

        for lvl in self.scale_levels:
            bottom_up = self.conception_up.get(lvl - 1, 0.0)
            top_down  = self.observer_down.get(lvl + 1, 0.0)
            # Resonanz-Kopplung: geomean statt Addition.
            # Beide Richtungen mÃ¼ssen GLEICHZEITIG stark sein â€” das ist Resonanz.
            # Additiv wÃ¼rde eine Richtung genÃ¼gen â€” das wÃ¤re linear.
            if bottom_up > EPSILON and top_down > EPSILON:
                resonance = safe_geomean([bottom_up + EPSILON, top_down + EPSILON])
            else:
                resonance = max(bottom_up, top_down) * PHI  # gedÃ¤mpft wenn einseitig
            # Mineral-Anker flieÃŸt in alle Ebenen â€” anorganischer Boden trÃ¤gt Lebendiges
            field_charge = clamp01(
                safe_geomean([
                    base_charge      + EPSILON,
                    resonance        + EPSILON,
                    self.emergent_anchor + EPSILON,   # Verdichtungskette als Fundament
                ])
            )
            out = self.fields[lvl].step(
                base_charge=field_charge,
                inorganic_anchor=max(self.emergent_anchor, self.dao_sync),  # Fibonacci-Sync nÃ¤hrt
            )
            results[lvl] = out
            self.conception_up[lvl]  = out.get('conception_integral', 0.0)
            self.observer_down[lvl]  = out.get('observer_return_integral', 0.0)

        conceptions = [results[lvl].get('conception_integral', 0.0) for lvl in self.scale_levels]
        observers   = [results[lvl].get('observer_return_integral', 0.0) for lvl in self.scale_levels]

        # GegenlÃ¤ufige Fibonacci-StrÃ¶me: das fehlende dynamische Gesetz.
        # Yin-Strom (aufsteigend Mikroâ†’Makro): Mineral verdichtet sich zum Menschen.
        #   Fibonacci-Gewicht steigt mit Ebene: fib = [5,8,13,21,34]/34
        # Yang-Strom (absteigend Makroâ†’Mikro): Mensch-Erkenntnis sinkt ins Mineral.
        #   Fibonacci-Gewicht fÃ¤llt mit Ebene: fib = [34,21,13,8,5]/34
        # Die StrÃ¶me flieÃŸen ENTGEGENGESETZT â€” das erzeugt die Spannung.
        # dao_sync = geomean(yin_stream, yang_stream): maximal wenn beide kohÃ¤rent.
        # Strukturelle Garantie: fib[n] Ã— fib[N-n] â‰ˆ PHIÂ² fÃ¼r jede Fibonacci-Folge.
        # = DAO-Synchronisation ist immer nahe PHIÂ² â€” strukturelle HomÃ¶ostase.
        _FIB = [5, 8, 13, 21, 34]   # Fibonacci-Gewichte fÃ¼r 5 Ebenen
        _MAX = 34
        yin_streams  = []   # aufsteigend: niedrig bei Mineral, hoch bei Mensch
        yang_streams = []   # absteigend: hoch bei Mineral, niedrig bei Mensch
        for i, lvl in enumerate(self.scale_levels):
            yin_w  = _FIB[i]      / _MAX   # aufsteigend
            yang_w = _FIB[4 - i]  / _MAX   # absteigend (gespiegelt)
            c = conceptions[i]
            o = observers[i]
            ys = clamp01(c * yin_w)    # Yin-Strom: Conception Ã— aufsteigende Gewichtung
            xs = clamp01(o * yang_w)   # Yang-Strom: Observer Ã— absteigende Gewichtung
            yin_streams.append(ys)
            yang_streams.append(xs)
        # DAO-Synchronisation: geomean aller gegenlÃ¤ufigen Strompaare.
        # Maximal wenn beide StrÃ¶me gleichzeitig kohÃ¤rent â€” das ist die DAO-Mitte.
        all_streams = [v + EPSILON for v in yin_streams + yang_streams]
        self.dao_sync = safe_geomean(all_streams)
        self.yin_stream_total  = safe_geomean([v + EPSILON for v in yin_streams])
        self.yang_stream_total = safe_geomean([v + EPSILON for v in yang_streams])

        # human_synchronicity: der buchstÃ¤blich zentrale Gedanke.
        # Nicht "Mensch als oberste Ebene" sondern "Mineral UND Mensch gleichzeitig erkannt".
        # Misst ob die EXTREMEN POLE der Achse gleichzeitig kohÃ¤rent sind:
        #   yin_e3 = Yin-Strom auf Ebene 3 (Mensch, Konzeption maximal)
        #   yang_em1 = Yang-Strom auf Ebene -1 (Mineral, Verdichtung maximal)
        #   dao_sync = KohÃ¤renz der gesamten Achse
        # Wenn alle drei gleichzeitig hoch: Mensch kennt Mineral, Mineral kennt Mensch.
        # Das ist der verbundene Innerturn auf ALLEN Ebenen: Beobachter auÃŸen
        # UND Zelle innen kennen beide Seiten gleichzeitig.
        self.human_synchronicity = safe_geomean([
            yin_streams[-1]  + EPSILON,   # Yin-Strom Ebene 3 (Mensch: Konzeption)
            yang_streams[0]  + EPSILON,   # Yang-Strom Ebene -1 (Mineral: Verdichtung)
            self.dao_sync    + EPSILON,   # Achsen-KohÃ¤renz
        ])

        self.scale_coherence = safe_geomean([
            safe_geomean([c + EPSILON for c in conceptions]),
            safe_geomean([o + EPSILON for o in observers]),
            self.emergent_anchor       + EPSILON,
            self.dao_sync              + EPSILON,
            self.human_synchronicity   + EPSILON,   # Achsen-Einheit
        ])

        return {
            "levels":               results,
            "scale_coherence":      self.scale_coherence,
            "conception_up":        dict(self.conception_up),
            "observer_down":        dict(self.observer_down),
            "emergent_anchor":      self.emergent_anchor,
            "diamond_layer":        self.diamond_layer,
            "compost_layer":        self.compost_layer,
            "dao_sync":             self.dao_sync,
            "yin_stream":           self.yin_stream_total,
            "yang_stream":          self.yang_stream_total,
            "human_synchronicity":  self.human_synchronicity,
        }


