@dataclass
class InstabilitySignature:
    iteration:            int
    instability_pressure: float
    residual_flux:        float
    release_flux:         float
    latent_real_light_flux: float
    capsule_flux:         float
    coherent_release_flux: float
    dao_component:        float
    core_component:       float
    light_component:      float
    membrane_component:   float
    reflection_component: float
    recurrence_pressure:  float
    release_route:        str
    dissolved:            bool


@dataclass
class InstabilityDissolutionState:
    pressure_live:   float = 0.0
    recurrence_live: float = 0.0
    last_release_flux: float = 0.0
    last_route:      str   = "none"
    ledger: List[InstabilitySignature] = field(default_factory=list)

    def register(self, sig: InstabilitySignature, rate: float = COHERENCE_RATE) -> None:
        self.pressure_live   = lerp(self.pressure_live,   sig.instability_pressure, rate)
        self.recurrence_live = lerp(self.recurrence_live, sig.recurrence_pressure,  rate)
        self.last_release_flux = sig.release_flux
        self.last_route = sig.release_route
        self.ledger.append(sig)
        self.ledger = self.ledger[-13:]

    def damping_factor(self) -> float:
        return clamp01(1.0 - 0.45 * self.pressure_live - 0.25 * self.recurrence_live)

    def release_boost(self) -> float:
        return clamp01(0.45 * self.pressure_live + 0.55 * self.recurrence_live)


@dataclass
class CoherenceProjectionLayer:
    instability:        InstabilityDissolutionState = field(default_factory=InstabilityDissolutionState)
    residual_flux:      float = 0.0
    release_flux:       float = 0.0
    latent_real_light_flux: float = 0.0
    capsule_flux:       float = 0.0
    coherent_release_flux: float = 0.0
    field_recognition:  float = 0.0
    iteration:          int   = 0
    dao_feedback:       float = 0.5
    core_feedback:      float = 0.5
    light_feedback:     float = 0.0
    membrane_feedback:  float = 0.5
    reflection_feedback: float = 0.0

    def step(
        self,
        dao_score:          float,
        dao_under:          float,
        dao_split:          float,
        core_pair_score:    float,
        outer_cross:        float,
        inward_pull:        float,
        membrane_score:     float,
        membrane_release:   float,
        membrane_risk:      float,
        moment_perm:        float,
        light_score:        float,
        light_identity:     float,
        light_coherence:    float,
        reflection_score:   float,
        reflection_return:  float,
        reflection_feedback_in: float,
        field_conception_density: float = 0.0,
        arc_balance:        float = 0.0,
        real_light_alignment_signal: float = 0.0,
        gravity_infold:     float = 0.0,
        capsule_nonexpansion: float = 1.0,
        spiral_birth_score: float = 0.0,  # NEU
    ) -> Dict[str, Any]:
        grav        = clamp01(gravity_infold)
        cap_nonexp  = clamp01(capsule_nonexpansion)
        sbs         = clamp01(spiral_birth_score)
        coherence = safe_geomean([
            dao_score         + EPSILON,
            dao_under         + EPSILON,
            core_pair_score   + EPSILON,
            outer_cross       + EPSILON,
            inward_pull       + EPSILON,
            membrane_score    + EPSILON,
            membrane_release  + EPSILON,
            moment_perm       + EPSILON,
            light_identity    + EPSILON,
            light_coherence   + EPSILON,
            (0.5 + 0.5 * reflection_score)  + EPSILON,
            (0.5 + 0.5 * reflection_return) + EPSILON,
            (0.50 + 0.50 * grav)            + EPSILON,
            (0.50 + 0.50 * cap_nonexp)      + EPSILON,
            (0.55 + 0.45 * sbs)             + EPSILON,
        ])
        risk = clamp01(
            0.22 * dao_split
            + 0.18 * membrane_risk
            + 0.13 * (1.0 - light_identity)
            + 0.13 * (1.0 - core_pair_score)
            + 0.09 * (1.0 - reflection_score)
            + 0.08 * (1.0 - arc_balance)
            + 0.09 * (1.0 - cap_nonexp)
            + 0.08 * (1.0 - sbs)
        )
        usable   = clamp01(coherence * (1.0 - risk))
        residual = clamp01(1.0 - usable)
        raw_release = clamp01(residual * safe_geomean([
            membrane_release    + EPSILON,
            moment_perm         + EPSILON,
            light_identity      + EPSILON,
            dao_score           + EPSILON,
            (0.5 + 0.5 * reflection_return) + EPSILON,
            (0.55 + 0.45 * sbs)            + EPSILON,
        ]))
        self.latent_real_light_flux = safe_geomean([
            residual         + EPSILON,
            raw_release      + EPSILON,
            membrane_release + EPSILON,
            light_identity   + EPSILON,
            dao_score        + EPSILON,
            (0.50 + 0.50 * grav) + EPSILON,
            (0.55 + 0.45 * sbs)  + EPSILON,
        ])
        self.capsule_flux = clamp01(
            residual * (1.0 - raw_release) * membrane_risk
            * (1.0 - outer_cross) * (1.0 - cap_nonexp + EPSILON)
        )
        self.coherent_release_flux = clamp01(
            raw_release * dao_score * membrane_release * light_identity
            * max(reflection_return, EPSILON)
            * (0.70 + 0.30 * sbs)
        )
        correction_mod = clamp01(1.0 + clamp11(real_light_alignment_signal) * LATENT_LIGHT_CORRECTION_RATE)
        release = clamp01(
            (0.50 * self.coherent_release_flux + 0.30 * self.latent_real_light_flux + 0.20 * raw_release)
            * correction_mod
        )
        dao_i  = clamp01(dao_split)
        core_i = clamp01(1.0 - safe_geomean([core_pair_score + EPSILON, outer_cross + EPSILON, inward_pull + EPSILON]))
        light_i  = clamp01(1.0 - light_identity)
        mem_i    = clamp01(membrane_risk)
        refl_i   = clamp01(1.0 - reflection_score)
        instab_pressure = safe_geomean([
            residual    + EPSILON,
            clamp01(1.0 - coherence) + EPSILON,
            dao_i       + EPSILON,
            core_i      + EPSILON,
            light_i     + EPSILON,
            mem_i       + EPSILON,
            refl_i      + EPSILON,
        ])
        recurrence = clamp01(0.55 * self.instability.pressure_live + 0.45 * instab_pressure)
        dominants  = {"dao": dao_i, "core": core_i, "light": light_i, "membrane": mem_i, "reflection": refl_i}
        route = max(dominants, key=dominants.get)
        sig = InstabilitySignature(
            iteration=self.iteration,
            instability_pressure=instab_pressure,
            residual_flux=residual,
            release_flux=release,
            latent_real_light_flux=self.latent_real_light_flux,
            capsule_flux=self.capsule_flux,
            coherent_release_flux=self.coherent_release_flux,
            dao_component=dao_i, core_component=core_i,
            light_component=light_i, membrane_component=mem_i,
            reflection_component=refl_i,
            recurrence_pressure=recurrence, release_route=route,
            dissolved=(instab_pressure < 0.12 and residual < 0.08 and self.capsule_flux < 0.10),
        )
        self.instability.register(sig)
        damping = self.instability.damping_factor()
        rb      = self.instability.release_boost()
        release = clamp01(release + rb * residual * 0.35)
        capture = clamp01(usable * damping * (0.72 + 0.28 * grav))
        field_core_phi = phi_ratio_score(field_conception_density + EPS, core_pair_score + EPS)
        self.field_recognition = lerp(
            self.field_recognition,
            safe_geomean([
                field_core_phi    + EPSILON,
                arc_balance       + EPSILON,
                (0.5 + 0.5 * coherence) + EPSILON,
                (0.5 + 0.5 * grav)      + EPSILON,
                (0.5 + 0.5 * sbs)       + EPSILON,
            ]),
            COUPLING_RATE,
        )
        light_feedback_base = clamp01(
            0.30 * light_score + 0.22 * light_identity
            + 0.20 * reflection_return + 0.20 * release + 0.08 * sbs
        )
        light_mod  = clamp01(1.0 + real_light_alignment_signal * LATENT_LIGHT_CORRECTION_RATE)
        eff_rate   = COHERENCE_RATE * (0.40 + 0.60 * capture)
        self.dao_feedback = lerp(
            self.dao_feedback,
            clamp01(0.38 * dao_score + 0.15 * core_pair_score + 0.12 * reflection_feedback_in
                    + 0.18 * release + 0.10 * grav + 0.07 * sbs),
            eff_rate,
        )
        self.core_feedback = lerp(
            self.core_feedback,
            clamp01(0.36 * core_pair_score + 0.16 * outer_cross + 0.15 * inward_pull
                    + 0.15 * reflection_feedback_in + 0.10 * grav + 0.08 * sbs),
            eff_rate,
        )
        self.light_feedback    = lerp(self.light_feedback, clamp01(light_feedback_base * light_mod), eff_rate)
        self.membrane_feedback = lerp(
            self.membrane_feedback,
            clamp01(0.28 * membrane_score + 0.22 * membrane_release + 0.18 * dao_score
                    + 0.16 * reflection_return + 0.10 * grav + 0.06 * sbs),
            eff_rate,
        )
        self.reflection_feedback = lerp(
            self.reflection_feedback,
            clamp01(0.30 * reflection_feedback_in + 0.20 * coherence + 0.17 * reflection_return
                    + 0.15 * outer_cross + 0.10 * grav + 0.08 * sbs),
            eff_rate,
        )
        self.residual_flux = residual
        self.release_flux  = release
        self.iteration    += 1
        return {
            "coherence":           coherence,
            "risk":                risk,
            "usable_fraction":     usable,
            "residual_flux":       residual,
            "release_flux":        release,
            "latent_real_light_flux": self.latent_real_light_flux,
            "capsule_flux":        self.capsule_flux,
            "coherent_release_flux": self.coherent_release_flux,
            "capture":             capture,
            "field_recognition":   self.field_recognition,
            "real_light_alignment_integrated": real_light_alignment_signal,
            "instability": {
                "pressure_live":   self.instability.pressure_live,
                "recurrence_live": self.instability.recurrence_live,
                "damping":         damping,
                "release_boost":   rb,
                "dissolved":       sig.dissolved,
                "route":           route,
            },
            "feedback_to_dao_next":        self.dao_feedback,
            "feedback_to_core_next":       self.core_feedback,
            "feedback_to_light_next":      self.light_feedback,
            "feedback_to_membrane_next":   self.membrane_feedback,
            "feedback_to_reflection_next": self.reflection_feedback,
        }


