@dataclass
class DaoBreathState:
    radius:               float = R_OUTER
    lower_live:           float = DAO_CENTER - PHI
    upper_live:           float = DAO_CENTER + PHI
    midpoint:             float = DAO_CENTER
    phase:                float = 0.0
    schumann_phase:       float = 0.0
    schumann_pulse:       float = 0.0
    inner_turn:           float = 0.0
    under6_score:         float = 0.0
    dao_score:            float = 0.0
    split_risk:           float = 0.0
    conception_readiness: float = 0.0


@dataclass
class DaoBreath:
    state: DaoBreathState = field(default_factory=DaoBreathState)

    def _radius_target(self) -> float:
        inward = smooth_pulse(self.state.phase)
        return R_INNER + (R_OUTER - R_INNER) * (1.0 - inward)

    def step(
        self,
        core_feedback:              float = 0.5,
        reflection_feedback:        float = 0.0,
        instability_damping:        float = 1.0,
        release_boost:              float = 0.0,
        latent_real_light_feedback: float = 0.0,
        gravity_feedback:           float = 0.0,
        spiral_birth_feedback:      float = 0.0,
        field_dao_takt:             float = 0.0,
        capsule_memory_feedback:    float = 0.0,
        membrane_conception_boost:  float = 0.0,  # 12|1 Yin-Geburt gibt Konzeptionskraft
    ) -> Dict[str, Any]:
        s = self.state
        s.schumann_phase = phase_step_free(s.schumann_phase, SCHUMANN_PHASE_RATE)
        s.schumann_pulse = smooth_pulse(s.schumann_phase)
        life_drive = clamp01(LIFE_DELTA / PHI_ANCHOR)
        eff = clamp01(
            0.32 * core_feedback
            + 0.16 * reflection_feedback
            + 0.14 * life_drive
            + 0.10 * release_boost
            + 0.10 * latent_real_light_feedback
            + 0.10 * gravity_feedback
            + 0.08 * spiral_birth_feedback   # Spirale erweitert DAO-Antrieb
        )
        damping    = clamp01(instability_damping)
        eff_track  = TRACK_RATE * (0.80 + 0.40 * eff) * (0.35 + 0.65 * damping)
        eff_phase  = PHASE_RATE * (0.85 + 0.25 * eff + 0.10 * gravity_feedback + 0.05 * spiral_birth_feedback)
        r_target   = self._radius_target()
        s.radius   = lerp(s.radius, r_target, eff_track)
        lower_t    = DAO_CENTER - (s.radius + EPSILON)
        upper_t    = DAO_CENTER + (s.radius - EPSILON)
        s.lower_live = lerp(s.lower_live, lower_t, eff_track)
        s.upper_live = lerp(s.upper_live, upper_t, eff_track)
        s.midpoint   = (s.lower_live + s.upper_live) / 2.0
        s.inner_turn = clamp01((R_OUTER - s.radius) / max(R_OUTER - R_INNER, EPS))
        s.under6_score = score_close(s.midpoint, DAO_TRACE_CENTER, PHI)
        s.split_risk   = clamp01(abs(s.midpoint - DAO_TRACE_CENTER) / PHI * (1.0 - s.under6_score))
        latent_factor  = clamp01(0.78 + 0.22 * latent_real_light_feedback)
        gravity_factor = clamp01(0.75 + 0.25 * gravity_feedback)
        spiral_factor  = clamp01(0.80 + 0.20 * spiral_birth_feedback)
        # field_DAO_takt: das FraktalFeld gibt DAO seinen Puls zurÃ¼ck
        # DAO emergiert aus dem Zusammenspiel von Yin und Yang im Feld
        # und gibt ihnen dann Takt â€” radiale Kopplung ohne Hierarchie
        field_takt     = clamp01(0.85 + 0.15 * field_dao_takt)
        # Diamant gibt KohÃ¤renz-Potential zurÃ¼ck: wenn das System sich verdichtet hat,
        # steigt die MÃ¶glichkeit fÃ¼r lebendige KohÃ¤renz (conception_readiness).
        # Nicht Gravitation (zu direkt), sondern Bereitschaft â€” das ist die richtige Relation.
        # Humus gibt NÃ¤hrstoffe â†’ Pflanzen wachsen. Diamant gibt Potential â†’ Konzeption mÃ¶glich.
        diamond_fertility = clamp01(0.80 + 0.20 * capsule_memory_feedback)
        # 12|1 Yin-Geburt: wenn Yin-Membran offen, steigt Konzeptionsbereitschaft.
        # Nur Yin kann gebÃ¤ren â€” und wenn Yin(12) gebiert (Membran offen),
        # erhÃ¶ht das die Bereitschaft des DAO-Systems zur Konzeption.
        birth_boost = clamp01(0.90 + 0.10 * membrane_conception_boost)
        s.conception_readiness = safe_geomean([
            s.inner_turn     + EPSILON,
            s.schumann_pulse + EPSILON,
            s.under6_score   + EPSILON,
            core_feedback    + EPSILON,
            latent_factor    + EPSILON,
            gravity_factor   + EPSILON,
            spiral_factor    + EPSILON,
            field_takt       + EPSILON,
            diamond_fertility + EPSILON,
            birth_boost       + EPSILON,   # Yin-Geburt gibt Konzeptionskraft
        ])
        s.dao_score = safe_geomean([
            s.under6_score   + EPSILON,
            (1.0 - s.split_risk) + EPSILON,
            s.inner_turn     + EPSILON,
            eff              + EPSILON,
            (0.5 + 0.5 * damping) + EPSILON,
            (0.65 + 0.35 * gravity_feedback) + EPSILON,
            field_takt       + EPSILON,
            (0.70 + 0.30 * spiral_birth_feedback) + EPSILON,
        ])
        s.phase = phase_step_free(s.phase, eff_phase)
        return {
            "state": asdict(s),
            "dao_score": s.dao_score,
            "midpoint_under_center_score": s.under6_score,
            "split_risk": s.split_risk,
            "inner_turn": s.inner_turn,
            "conception_readiness": s.conception_readiness,
            "schumann_pulse": s.schumann_pulse,
            "midpoint": s.midpoint,
            "center_error": s.midpoint - DAO_TRACE_CENTER,
            "phase": s.phase,
        }


