    pressure: float = 0.0
    micro_flicker: float = EPSILON
    schumann_membrane_pulse: float = 0.0
    trauma_loop_release: float = 0.0
    seam_anti_sync: float = 0.0


@dataclass
class MembranePair12_1_8_9:
    state: MembranePairState = field(default_factory=MembranePairState)
    seam_12_1: SeamBreather = field(
        default_factory=lambda: SeamBreather("12|1", phase=0.0))
    seam_8_9: SeamBreather = field(
        default_factory=lambda: SeamBreather("8|9", phase=0.5))

    def step(self, center_release: float, edge_braid: float,
             inward_pull: float, outward_pressure: float,
             lower_heart_return: float, upper_heart_return: float,
             conception_event: float = 0.0,
             schumann_pulse: float = 0.5,
             reflection_feedback: float = 0.0,
             dao_score: float = 0.5, core_score: float = 0.5,
             reflection_score: float = 0.0, coherence_score: float = 0.5,
             damping: float = 1.0, release_boost: float = 0.0) -> Dict[str, Any]:
        s = self.state
        s.schumann_membrane_pulse = safe_geomean([
            schumann_pulse + EPSILON, conception_event + EPSILON])
        flicker_phase = (self.seam_12_1.phase + self.seam_8_9.phase) / 2.0
        s.micro_flicker = EPSILON * (1.0 + 0.5 * signed_wave(flicker_phase))
        # GEBURTSPULS: Membran Ã¶ffnet wenn Zeugung geschieht.
        # Eichung: im Zeugungsmoment ist schumann=0.929, conception=0.714
        # protected allein = cce*braid*inward â‰ˆ 0.316 â†’ pulse â‰ˆ 0.248 (zu niedrig)
        # pulse_target = geomean(protected, conception, schumann) â‰ˆ 0.594
        # Das ist semantisch korrekt: die Membran antwortet auf den Zeugungsakt.
        protected_base = center_release * edge_braid * inward_pull
        pulse_target = safe_geomean([
            protected_base + EPSILON,
            conception_event + EPSILON,
            (0.5 + 0.5 * schumann_pulse) + EPSILON,
        ])
        s.pulse = lerp(s.pulse, pulse_target, MEMBRANE_RATE)
        s.trauma_loop_release = clamp01(
            s.pulse * edge_braid * (1.0 - outward_pressure) + s.micro_flicker)
        drive = safe_geomean([
            s.pulse + EPSILON,
            (0.5 + 0.5*edge_braid) + EPSILON,
            inward_pull + EPSILON,
        ])
        s12 = self.seam_12_1.step(
            drive=drive * (0.65 + 0.35*upper_heart_return),
            dao_score=dao_score, core_score=core_score,
            reflection_score=reflection_score, coherence_score=coherence_score,
            damping=damping, release_boost=release_boost,
            schumann_pulse=schumann_pulse, conception_event=conception_event,
            opposite_phase=self.seam_8_9.phase,
        )
        s89 = self.seam_8_9.step(
            drive=drive * (0.65 + 0.35*lower_heart_return),
            dao_score=dao_score, core_score=core_score,
            reflection_score=reflection_score, coherence_score=coherence_score,
            damping=damping, release_boost=release_boost,
            schumann_pulse=schumann_pulse, conception_event=conception_event,
            opposite_phase=self.seam_12_1.phase,
        )
        s.opening_12_1 = s12["permeability_live"]
        s.opening_8_9 = s89["permeability_live"]
        s.seam_anti_sync = safe_mean([s12["anti_sync"], s89["anti_sync"]])
        s.inversion_risk_12_1 = clamp01(
            s.opening_12_1 * outward_pressure * (1.0 - edge_braid))
        s.inversion_risk_8_9 = clamp01(
            s.opening_8_9 * outward_pressure * (1.0 - edge_braid))
        max_risk = max(s.inversion_risk_12_1, s.inversion_risk_8_9)
        s.release = safe_geomean([
            s.opening_12_1 + EPSILON, s.opening_8_9 + EPSILON,
            edge_braid + EPSILON, inward_pull + EPSILON,
        ])
        s.permeability_moment = clamp01(s.release * (1.0 - max_risk))
        s.pressure = clamp01(
            outward_pressure * (1.0 - s.release)
            + center_release * (1.0 - edge_braid)
        )
        s.membrane_score = safe_geomean([
            s.permeability_moment + EPSILON,
            (1.0 - s.inversion_risk_12_1) + EPSILON,
            (1.0 - s.inversion_risk_8_9) + EPSILON,
            s.release + EPSILON,
            s.trauma_loop_release + EPSILON,
            s.seam_anti_sync + EPSILON,
        ])
        return {
            "state": asdict(s),
            "membrane13_score": s.membrane_score,
            "outer_inversion_risk": max_risk,
            "trauma_loop_release": s.trauma_loop_release,
            "moment_as_permeability": s.permeability_moment,
            "seam_anti_sync": s.seam_anti_sync,
        }


