    def _dao_radius(self, phase: float, r_outer: float) -> float:
        """Atmender Radius: PHI bei phase=0, Îµ bei phase=0.5."""
        inward = 0.5 - 0.5 * math.cos(2.0 * math.pi * phase)
        return r_outer - (r_outer - R_INNER) * inward

    def _relational_targets(self, center: float, radius: float) -> Tuple[float, float, float]:
        """
        Zielrelationen zur Mitte.
        Asymmetrie: lower ist um 2Îµ weiter entfernt als upper.
        Daraus emergiert mid = center âˆ’ Îµ.
        """
        lower = center - (radius + EPSILON)
        upper = center + (radius - EPSILON)
        return lower, upper, (lower + upper) / 2.0

    def _inner_turn_proximity(self, radius: float, r_outer: float) -> float:
        """Wie nah ist der aktuelle Radius am inneren Turn (R=Îµ)?"""
        span = max(r_outer - R_INNER, EPS)
        return clamp01(1.0 - (radius - R_INNER) / span)

    def _upper_at_center_score(self, upper_live: float, center: float) -> float:
        """Score: wie nah ist upper_live am Zentrum?"""
