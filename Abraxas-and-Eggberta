@dataclass
class RelationalDiamond921:
    iteration: int = 0

    def __post_init__(self):
        self.lower_shells = [
            PairShellSpiral(9.0, (1.0, 8.0), "1|8"),
            PairShellSpiral(9.0, (2.0, 7.0), "2|7"),
            PairShellSpiral(9.0, (3.0, 6.0), "3|6"),
            PairShellSpiral(9.0, (4.0, 5.0), "4|5"),
        ]
        self.upper_shells = [
            PairShellSpiral(21.0, (9.0, 12.0), "9|12"),
            PairShellSpiral(21.0, (10.0, 11.0), "10|11"),
        ]
        self.structural_lift = 21.0/2.0 - 9.0/2.0 # 6.0 âœ“
        for i, sh in enumerate(self.lower_shells + self.upper_shells):
            sh.phase = (i * PHI) % 1.0

    def step(self, damping: float = 1.0,
             release_boost: float = 0.0) -> Dict[str, Any]:
        lower_states = [s.step(damping, release_boost) for s in self.lower_shells]
        upper_states = [s.step(damping, release_boost) for s in self.upper_shells]
        shell_10_11 = next(s for s in upper_states if s["name"] == "10|11")
        shell_4_5 = next(s for s in lower_states if s["name"] == "4|5")
        pivot_live = shell_10_11["midpoint_live"] - shell_4_5["midpoint_live"]
        dao_pivot_coherence = clamp01(
            1.0 - abs(pivot_live - self.structural_lift) /
            max(self.structural_lift, EPS)
        )
        avg_cc = safe_mean([s["center_coherence"] for s in lower_states + upper_states])
        self.iteration += 1
        return {
            "lower_states": lower_states,
            "upper_states": upper_states,
            "structural_lift": self.structural_lift,
            "pivot_live": pivot_live,
            "dao_pivot_coherence": dao_pivot_coherence,
            "avg_center_coherence": avg_cc,
            "static_pivot_coherence": dao_pivot_coherence,
        }


