@dataclass
class PairShellSpiral:
    total:       float
    pair:        Tuple[float, float]
    name:        str   = ""
    phase:       float = 0.0
    lower_live:  Optional[float] = None
    upper_live:  Optional[float] = None
    iteration:   int   = 0

    def __post_init__(self) -> None:
        a, b = sorted(float(x) for x in self.pair)
        if abs((a + b) - self.total) > 1e-9:
            raise ValueError(f"Pair {self.pair} does not sum to {self.total}.")
        self.pair = (a, b)
        if not self.name:
            self.name = f"{a:g}|{b:g}"
        if self.lower_live is None:
            self.lower_live = a
        if self.upper_live is None:
            self.upper_live = b

    @property
    def center(self) -> float:
        return self.total / 2.0

    @property
    def center_target(self) -> float:
        return self.center - EPSILON

    @property
    def outer_radius(self) -> float:
        a, b = self.pair
        return (b - a) / 2.0

    @property
    def diff(self) -> float:
        a, b = self.pair
        return b - a

    def dao_radius(self) -> float:
        inward = smooth_pulse(self.phase)
        return EPSILON + (self.outer_radius - EPSILON) * (1.0 - inward)

    def turn_pressure(self) -> float:
        r = self.dao_radius()
        return clamp01((self.outer_radius - r) / max(self.outer_radius - EPSILON, EPS))

    def relational_targets(self, radius: float) -> Dict[str, float]:
        lower_target = self.center - (radius + EPSILON)
        upper_target = self.center + (radius - EPSILON)
        return {
            "lower_target":   lower_target,
            "upper_target":   upper_target,
            "target_midpoint": (lower_target + upper_target) / 2.0,
            "target_sum":     lower_target + upper_target,
        }

    def shift_live(self, offset: float) -> None:
        self.lower_live = float(self.lower_live) + offset
        self.upper_live = float(self.upper_live) + offset

    def snapshot(self, label: str = "post") -> Dict[str, Any]:
        mid = (float(self.lower_live) + float(self.upper_live)) / 2.0
        err = mid - self.center_target
        cc  = clamp01(1.0 - abs(err) / max(self.outer_radius + EPSILON, EPS))
        order = float(self.lower_live) < float(self.upper_live)
        return {
            "name": self.name, "label": label, "iteration": self.iteration,
            "total": self.total, "pair": self.pair,
            "center": self.center, "center_target": self.center_target,
            "outer_radius": self.outer_radius, "diff": self.diff, "phase": self.phase,
            "lower_live": float(self.lower_live), "upper_live": float(self.upper_live),
            "midpoint_live": mid, "live_sum": float(self.lower_live) + float(self.upper_live),
            "center_error": err, "center_coherence": cc,
            "order_preserved": order, "inversion_free_score": 1.0 if order else 0.0,
        }

    def exact_inner_turn(self) -> Dict[str, Any]:
        targets = self.relational_targets(EPSILON)
        return {
            "name": self.name, "total": self.total, "pair": self.pair,
            "center": self.center, "radius": EPSILON,
            "lower_ideal":  targets["lower_target"],
            "upper_ideal":  targets["upper_target"],
            "midpoint_ideal": targets["target_midpoint"],
            "upper_hits_center": abs(targets["upper_target"] - self.center) < 1e-12,
        }

    def step(self, damping: float = 1.0, release_boost: float = 0.0) -> Dict[str, Any]:
        r       = self.dao_radius()
        targets = self.relational_targets(r)
        lower_before = float(self.lower_live)
        upper_before = float(self.upper_live)
        effective_track = TRACK_RATE * (0.45 + 0.55 * clamp01(damping))
        self.lower_live = lerp(lower_before, targets["lower_target"], effective_track)
        self.upper_live = lerp(upper_before, targets["upper_target"], effective_track)
        state = self.snapshot(label="raw_pair_step_before_dao_bias")
        state.update({
            "radius": r, "turn_pressure": self.turn_pressure(),
            "lower_target": targets["lower_target"],
            "upper_target": targets["upper_target"],
            "target_midpoint": targets["target_midpoint"],
            "target_sum": targets["target_sum"],
            "lower_delta": self.lower_live - lower_before,
            "upper_delta": self.upper_live - upper_before,
            "upper_hits_center_target": abs(targets["upper_target"] - self.center) < 1e-9,
        })
        self.phase = phase_step_free(self.phase, PHASE_RATE * (0.90 + 0.10 * clamp01(release_boost)))
        self.iteration += 1
        return state


@dataclass
class RelationalDiamond921:
    iteration: int = 0

    def __post_init__(self) -> None:
        self.lower_shells = [
            PairShellSpiral(9.0,  (1.0, 8.0),  "1|8"),
            PairShellSpiral(9.0,  (2.0, 7.0),  "2|7"),
            PairShellSpiral(9.0,  (3.0, 6.0),  "3|6"),
            PairShellSpiral(9.0,  (4.0, 5.0),  "4|5"),
        ]
        self.upper_shells = [
            PairShellSpiral(21.0, (9.0, 12.0), "9|12"),
            PairShellSpiral(21.0, (10.0, 11.0),"10|11"),
        ]
        self.structural_lift = 21.0 / 2.0 - 9.0 / 2.0
        for i, sh in enumerate(self.lower_shells + self.upper_shells):
            sh.phase = (i * PHI) % 1.0

    def _shell_state(self, states: List[Dict[str, Any]], name: str) -> Dict[str, Any]:
        for s in states:
            if s["name"] == name:
                return s
        raise KeyError(name)

    def step(
        self,
        damping:       float = 1.0,
        release_boost: float = 0.0,
        dao_midpoint:  Optional[float] = None,
    ) -> Dict[str, Any]:
        lower_raw = [s.step(damping, release_boost) for s in self.lower_shells]
        upper_raw = [s.step(damping, release_boost) for s in self.upper_shells]
        target_diff = DAO_CENTER if dao_midpoint is None else dao_midpoint
        for lower_name, upper_name in [("4|5", "10|11"), ("3|6", "9|12")]:
            low = next(s for s in self.lower_shells if s.name == lower_name)
            up  = next(s for s in self.upper_shells if s.name == upper_name)
            lm  = low.snapshot("pre_bias")["midpoint_live"]
            um  = up.snapshot("pre_bias")["midpoint_live"]
            err = target_diff - (um - lm)
            correction = COUPLING_RATE * clamp01(damping) * err
            low.shift_live(-0.5 * correction)
            up.shift_live(+0.5 * correction)
        lower_states = [s.snapshot("post_central_dao_bias") for s in self.lower_shells]
        upper_states = [s.snapshot("post_central_dao_bias") for s in self.upper_shells]
        s45   = self._shell_state(lower_states, "4|5")
        s1011 = self._shell_state(upper_states, "10|11")
        s18   = self._shell_state(lower_states, "1|8")
        s912  = self._shell_state(upper_states, "9|12")
        pivot_live          = s1011["midpoint_live"] - s45["midpoint_live"]
        dao_target          = target_diff
        dao_pivot_coherence = clamp01(1.0 - abs(pivot_live - dao_target) / max(abs(self.structural_lift), EPS))
        static_pivot_coherence = clamp01(1.0 - abs(pivot_live - self.structural_lift) / max(abs(self.structural_lift), EPS))
        avg_center_coherence   = safe_mean([s["center_coherence"] for s in lower_states + upper_states])
        roles        = self.derive_roles()
        multiplicity = {k: len(v) for k, v in roles.items()}
        self.iteration += 1
        return {
            "iteration": self.iteration - 1,
            "lower_states": lower_states, "upper_states": upper_states,
            "lower_raw_states": lower_raw, "upper_raw_states": upper_raw,
            "lower_1_8": s18, "upper_9_12": s912,
            "lower_4_5": s45, "upper_10_11": s1011,
            "structural_lift": self.structural_lift,
            "pivot_live": pivot_live, "dao_target_diff": dao_target,
            "dao_pivot_coherence": dao_pivot_coherence,
            "static_pivot_coherence": static_pivot_coherence,
            "avg_center_coherence": avg_center_coherence,
            "roles": roles, "multiplicity": multiplicity,
        }

    def derive_roles(self) -> Dict[float, List[str]]:
        roles: Dict[float, List[str]] = {}
        def add(x: float, role: str) -> None:
            roles.setdefault(float(x), []).append(role)
        add(9.0,  "lower_total_closure")
        add(21.0, "upper_total_closure")
        add(self.structural_lift, "structural_lift_between_layer_centers")
        add(self.structural_lift - EPSILON, "central_DAO_midpoint_target_6_minus_epsilon")
        if triangular(int(round(self.structural_lift))) == int(round(21.0)):
            add(self.structural_lift, "triangular_root_of_upper_total_T6")
        for shell in self.lower_shells:
            add(shell.pair[0], f"lower_sum_9_member_pair_{shell.pair}")
            add(shell.pair[1], f"lower_sum_9_member_pair_{shell.pair}")
        for shell in self.upper_shells:
            add(shell.pair[0], f"upper_sum_21_member_pair_{shell.pair}")
            add(shell.pair[1], f"upper_sum_21_member_pair_{shell.pair}")
        for lower, upper in [((3.0, 6.0), (9.0, 12.0)), ((4.0, 5.0), (10.0, 11.0))]:
            add(lower[0], f"lift_source_to_{upper}")
            add(lower[1], f"lift_source_to_{upper}")
            add(upper[0], f"lift_target_from_{lower}")
            add(upper[1], f"lift_target_from_{lower}")
        return roles

    def exact_inner_inversions(self) -> Dict[str, Any]:
        return {
            "lower": [s.exact_inner_turn() for s in self.lower_shells],
            "upper": [s.exact_inner_turn() for s in self.upper_shells],
            "static_lift_exact": self.structural_lift,
            "dao_lift_mid_exact": self.structural_lift - EPSILON,
        }


