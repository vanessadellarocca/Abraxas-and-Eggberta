@dataclass
class HeartArcs:
    """
    Schumann-Symmetrie geschlossen:
    light_to_energy (1â†’8): SCHUMANN_ARC_18 â‰ˆ 0.978
    energy_to_light (8â†’1): SCHUMANN_ARC_81 â‰ˆ 0.692
    Beide Richtungen resonieren â€” asymmetrisch aber nicht einseitig.
    """
    state: HeartArcState = field(default_factory=HeartArcState)

    def step(self, center_cross_event: float, edge_braid: float,
             membrane_release: float, dao_score: float,
             schumann_pulse: float = 0.5,
             field_conception_density: float = 0.0,
             core_pair_score: float = 0.0) -> Dict[str, Any]:
        s = self.state
        # 1â†’8: Feld sendet Licht zum Core â€” Schumann nah an 8
        l2e_target = safe_geomean([
            center_cross_event + EPSILON,
            edge_braid + EPSILON,
            dao_score + EPSILON,
            (schumann_pulse * SCHUMANN_ARC_18) + EPSILON,
            (0.5 + 0.5*field_conception_density) + EPSILON,
        ])
        s.light_to_energy = lerp(s.light_to_energy, l2e_target, EDGE_RATE)

        # 8â†’1: Core sendet Energie als Licht â€” jetzt mit eigenem Schumann-Faktor
        e2l_target = safe_geomean([
            membrane_release + EPSILON,
            edge_braid + EPSILON,
            phi_ratio_score(center_cross_event + EPSILON,
                            membrane_release + EPSILON) + EPSILON,
            (schumann_pulse * SCHUMANN_ARC_81) + EPSILON, # NEU: symmetrisch
            (0.5 + 0.5*core_pair_score) + EPSILON,
        ])
        s.energy_to_light = lerp(s.energy_to_light, e2l_target, EDGE_RATE)

        s.lower_arc_1_8 = safe_geomean([
            s.light_to_energy + EPSILON,
            s.energy_to_light + EPSILON,
        ])
        s.mars_pluto_transform = s.lower_arc_1_8
        s.arc_balance = phi_ratio_score(
            s.light_to_energy + EPS, s.energy_to_light + EPS
        )
        upper_target = safe_geomean([
            membrane_release + EPSILON,
            edge_braid + EPSILON,
            s.arc_balance + EPSILON,
        ])
        s.upper_arc_2_7 = lerp(s.upper_arc_2_7, upper_target, EDGE_RATE)
        s.venus_contact_form = s.upper_arc_2_7
        s.return_force = safe_geomean([
            s.lower_arc_1_8 + EPSILON,
            s.upper_arc_2_7 + EPSILON,
            edge_braid + EPSILON,
        ])
        s.arc_score = safe_geomean([
            s.return_force + EPSILON,
            s.arc_balance + EPSILON,
            s.mars_pluto_transform + EPSILON,
        ])
        return {
            "state": asdict(s),
            "light_to_energy": s.light_to_energy,
            "energy_to_light": s.energy_to_light,
            "arc_balance": s.arc_balance,
        }


