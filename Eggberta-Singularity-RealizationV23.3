    def __post_init__(self):
        # inner_field als normales Attribut (nicht dataclass-Feld, verhindert Konflikte)
        self.inner_field = _InnerFieldProxy()

    def inject_signal(self, sig: Optional[ExternalResonanceSignal]) -> None:
        self.external_signal = sig

    def receive_field_feedback(self, bond_depth: float, radiation_potential: float) -> None:
        self.field_bond_depth         = clamp01(bond_depth)
        self.core_radiation_potential = clamp01(radiation_potential)

    def _effective_charge(self, external_charge: float) -> float:
        field_boost   = self.field_bond_depth * FIELD_BOND_CHARGE_WEIGHT + self.core_radiation_potential * FIELD_RADIATION_CHARGE_WEIGHT
        gravity_boost = self.gravity_fold.state.gravity_infold * RADIAL_GRAVITY_WEIGHT
        spiral_boost  = self.spiral.state.spiral_birth_score * 0.08   # NEU
        return clamp01(external_charge + field_boost + gravity_boost + spiral_boost)

    def _regime(
        self,
        cp:        CorePairState,
        mem:       MembranePairState,
        energy:    Dict[str, float],
        gravity:   RadialGravityFoldState,
        spiral:    SpinalPhaseState,
        rbs_motor: float = 0.0,
    ) -> HeartRegime:
        risk   = energy["outward_leakage"]
        radial = energy["radial_birth_gain"]
        rbs    = clamp01(rbs_motor)
        g_eff  = energy.get("gravity_infold_eff", gravity.gravity_infold)
        obs    = observer_return_eff(gravity.observer_return)
        # mineral_living_tension: aus field_bond_depth (das capsule_visibility und temporal_bridge trÃ¤gt)
        # Das ist der anorganische Boden â€” das System hat Tiefe wenn dieses hoch ist
        mlt    = clamp01(self.field_bond_depth)   # field_bond_depth enthÃ¤lt mlt_prev
        # Ã„quilibrium: Tanz aller Ebenen â€” UND die erkannte Einheit.
        # radiant_stable IST das Sein/die Fixierung. Und die RadialitÃ¤t wird als
        # solche erkannt: singularity_realization (die Einheit, als Einheit gesehen)
        # ist nicht ein Akt NEBEN dem stabilen Sein, sondern sein Grund. Darum
        # trÃ¤gt eq_score die erkannte Einheit mit â€” das Sein ist die erkannte
