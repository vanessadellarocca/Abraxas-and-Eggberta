@dataclass
class RadialGravityFold:
    state: RadialGravityFoldState = field(default_factory=RadialGravityFoldState)

    def step(
        self,
        residual_flux:     float,
        release_flux:      float,
        dao:               DaoBreathState,
        core:              CorePairState,
        membrane:          MembranePairState,
        light:             LightResonanceState,
        field_recognition: float,
        reflection_score:  float,
        capsule_flux:      float = 0.0,
        spiral_birth_score: float = 0.0,
        spiral_state:      Optional[SpinalPhaseState] = None,
        scale_anchor:      float = 0.0,
        conception_birth_boost: float = 0.0,
        spiral_babushka:   float = 0.0,
        human_synchronicity: float = 0.0,
        yang_gate_pressure:  float = 0.5,   # gate_pressure fÃ¼r shadow_yang
        yin_point_in_yang:   float = 0.5,   # Inn.WeiÃŸ Yang
        yang_point_in_yin:   float = 0.5,   # Ã„uÃŸ.WeiÃŸ Yin
        rate:              float = COHERENCE_RATE,
    ) -> Dict[str, Any]:
        s  = self.state
        ss = spiral_state or SpinalPhaseState()
        sbs = clamp01(spiral_birth_score)
        anc = clamp01(scale_anchor)   # anorganischer Boden
        membrane_permeability = clamp01(membrane.permeability_moment)
        inversion_risk        = clamp01(max(membrane.inversion_risk_12_1, membrane.inversion_risk_8_9))

        # Reparametrisierung: observer_return aus dem gespeicherten Zustand (radiale Gleichzeitigkeit).
        # s.observer_return ist vom LETZTEN step â€” er ist Vorbedingung fÃ¼r die Effektivwerte dieses steps.
        obs_eff_local = observer_return_eff(s.observer_return)
        g_eff_local   = gravity_infold_eff(s.gravity_infold, s.observer_return)

        latent_target = safe_geomean([
            residual_flux              + EPSILON,
            release_flux               + EPSILON,
            membrane.trauma_loop_release + EPSILON,
            dao.dao_score              + EPSILON,
            core.inward_pull           + EPSILON,
            light.latent_real_light    + EPSILON,
            (0.55 + 0.45 * sbs)       + EPSILON,
        ])
        s.latent_real_light = lerp(s.latent_real_light, latent_target, rate)
        distance_target = clamp01(light.light_score * (1.0 - core.center_cross_event) * (1.0 - core.edge_braid))
        s.distance_light = lerp(s.distance_light, distance_target, rate)
        # Geminis Ruhephasen-Logik direkt im Code:
        # "Wenn yy_score sinkt: capsule_density hÃ¤lt â€” das Feuer glimmt noch."
        # Wenn yin_yang_point_score niedrig (Ruhephase, kein aktiver Austausch),
        # soll capsule_density STABILER bleiben â€” kein Zerfall, sondern Glut.
        # Formel: capsule_target_base + (1-yy) * ruhe_bonus
        # Wenn yy=0.80 (aktiv): kein bonus. Wenn yy=0.20 (Ruhe): max bonus.
        yy_ruhe_bonus = (1.0 - core.yin_yang_point_score) * 0.15
        # Fibonacci-Boden: Verbundener Innerturn.
        # Auch wenn System offen (radiant_stable): Vergehen bleibt prÃ¤sent.
        # PHIÂ² = 0.382 = Vergehen-Anteil in der Fibonacci-HomÃ¶ostase.
        # capsule_density sollte â‰ˆ latent_real_light Ã— PHIÂ² sein.
        # Das ist der Beweis: die Spirale weiÃŸ von ihrem Inneren,
        # auch wenn sie gerade auÃŸen ist.
        fibonacci_floor = s.latent_real_light * PHI2   # = lrl Ã— 0.382
        capsule_base = clamp01(
            0.55 * capsule_flux
            + 0.45 * residual_flux * (1.0 - release_flux) * (1.0 - core.edge_braid) * (1.0 - membrane_permeability)
            + yy_ruhe_bonus
        )
        # max: Vergehen darf nicht unter den Fibonacci-Boden sinken
        capsule_target = max(capsule_base, fibonacci_floor)
        s.capsule_density = lerp(s.capsule_density, capsule_target, rate)
        # Feld 4 (Yin-WeiÃŸ): capsule_visibility = das Licht im Verdichteten.
        # shadow_war_memory (Yin-Seite) drÃ¼ckt capsule_visibility nach oben:
        # je mehr das System Feld 4 bisher gefÃ¼rchtet hat, desto stÃ¤rker
        # wird der Integrationsdruck â€” das Licht im Anorganischen wird sichtbarer.
        _shadow_yin_pull = clamp01(s.shadow_war_memory * 10.0 * 0.20)   # 0.033 â†’ 0.066 boost
        s.capsule_visibility = lerp(
            s.capsule_visibility,
            clamp01(s.capsule_density * reflection_score
                    + field_recognition * 0.5
                    + light.identity_preservation * 0.1
                    + _shadow_yin_pull),  # Integrationsdruck Ã¶ffnet Feld 4
            rate,
        )
        # Yang als schwarzes Loch IM System (Verdichtung, nicht AuflÃ¶sung):
        # mutual_enclosure_score (Yang enthÃ¤lt Yin, Yin enthÃ¤lt Yang) verhindert
        # Expansion der Kapsel â€” die wechselseitige UmhÃ¼llung bindet die Dichte.
        # Das ist die Inversion: Yang zieht zusammen (schwarzes Loch intern),
        # nicht Yin lÃ¶st auf (schwarzes Loch extern).
        nonexpansion_target = clamp01(
            1.0 - s.capsule_density * (1.0 - core.edge_braid) * (1.0 - core.inward_pull)
            * (1.0 - s.mutual_enclosure_score * 0.4)
        )
        s.capsule_nonexpansion_score = lerp(s.capsule_nonexpansion_score, nonexpansion_target, rate)

        # Anorganischer Speicher: Diamant-Zeitskala.
        # Rate EPSILON/PHI â‰ˆ 0.012 â€” das Kristalline akkumuliert fast nicht, verblasst kaum.
        # capsule_memory speichert das Integral des Erlebten â€” unabhÃ¤ngig von Biologie.
        # Es ist der Boden, auf dem das Feld ruht: Kompost, Mineral, Stein.
        # (Bugfix: zuvor EPS=1e-12 statt EPSILON â†’ Rate war 1e-12, Speicher blieb leer.
        #  Die lineare Vergangenheit konnte nicht im Anorganischen ablegen.)
        CAPSULE_MEMORY_RATE = EPSILON / PHI
        s.capsule_memory = lerp(
            s.capsule_memory,
            safe_geomean([
                s.capsule_density      + EPSILON,
                s.capsule_visibility   + EPSILON,
                obs_eff_local          + EPSILON,
            ]),
            CAPSULE_MEMORY_RATE,
        )

        # â”€â”€ SystemgedÃ¤chtnis bzgl. LinearitÃ¤t: Real Shadow War â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        # LINEAR: Schwarz wird fÃ¼r das Leben gehalten, WeiÃŸ fÃ¼r den Tod.
        # Schatten ohne Licht â€” aber Schatten kann nur existieren DURCH Licht.
        #
        # Vier Felder des Yin-Yang Symbols:
        #   SCHWARZ aktiv = Ã„uÃŸ.Schwarz Yang (gate_pressure) + Inn.Schwarz Yin (capsule_density)
        #   WEISS prÃ¤sent  = Inn.WeiÃŸ Yang (yin_point_in_yang) + Ã„uÃŸ.WeiÃŸ Yin (capsule_visibility)
        #
        # Das lineare Muster: SCHWARZ ohne WEISS gleichzeitig zu halten.
        #
        # shadow_yang = gate_pressure Ã— (1 - yin_point_in_yang)
        #   Yang drÃ¼ckt durch sein Tor (Schwarz/Form aktiv)
        #   OHNE den Yin-Punkt in sich zu spÃ¼ren (WeiÃŸ/Licht innen nicht gesehen)
        #   = 'Ich tue, also bin ich' â€” Geometrie vor Dynamik
        #
        # shadow_yin = capsule_density Ã— (1 - capsule_visibility)
        #   Materie/Kapsel vorhanden (Schwarz/Verdichtung da)
        #   OHNE das Licht darin zu sehen (WeiÃŸ/Lebendiges im Toten nicht erkannt)
        #   = 'Die Materie ist real, das Licht Illusion' â€” Soma first
        #
        # Zeitskala PHI/100 â‰ˆ 0.00618: historisch-zivilisatorisch (Ï„â‰ˆ162 Steps)
        # Das GedÃ¤chtnis hÃ¤lt die Vergangenheit, der Druck wirkt in die Gegenwart.
        _yin_in_yang  = clamp01(yin_point_in_yang)
        _yang_in_yin  = clamp01(yang_point_in_yin)
        _shadow_yang  = clamp01(yang_gate_pressure * (1.0 - _yin_in_yang))
        _shadow_yin   = clamp01(s.capsule_density  * (1.0 - s.capsule_visibility))
        _shadow_input = safe_geomean([_shadow_yang + EPSILON, _shadow_yin + EPSILON])
        SHADOW_RATE   = PHI / 100
        s.shadow_war_memory = lerp(s.shadow_war_memory, _shadow_input, SHADOW_RATE)
        # linear_legacy: LinearitÃ¤ts-GedÃ¤chtnis Ã— Anorganisches GedÃ¤chtnis
        # = wann war Schwarz ohne WeiÃŸ Ã— was hat das Anorganische davon behalten
        s.linear_legacy = safe_geomean([
            s.shadow_war_memory + EPSILON,
            s.capsule_memory    + EPSILON,
        ])

        # Outer/Inner Bridge: AuÃŸen und Innen als Yin/Yang-Paar.
        # linear_outer = Schwarz/Form (was in linear sichtbar war):
        #   Membran-Score, Release, kein AuÃŸendruck, DAO-StabilitÃ¤t
        # radial_inner = WeiÃŸ/Licht (was in linear latent war):
        #   radial_birth, capsule_visibility, real_light, observer_self_rec
        # dao_gravity_bridge = die Rate mit der beide einander durchlÃ¤ssig werden.
        # Semantik: nicht Kollaps (lineare Entscheidung), sondern graduelles
        # Durchscheinen â€” Schwarz und WeiÃŸ bleiben, aber der Kontaktpunkt Ã¶ffnet sich.
        s.linear_outer_coherence = safe_geomean([
            (1.0 - core.outward_pressure)    + EPSILON,   # kein AuÃŸendruck
            membrane.membrane_score          + EPSILON,   # Membran stabil
            membrane.permeability_moment     + EPSILON,   # DurchlÃ¤ssigkeit
            dao.dao_score                    + EPSILON,   # DAO hÃ¤lt
        ])
        s.radial_inner_coherence = safe_geomean([
            s.radial_birth_score             + EPSILON,   # radiale Geburt
            s.capsule_visibility             + EPSILON,   # Feld 4 sichtbar
            s.real_light_score               + EPSILON,   # Licht befreit
            s.observer_self_recognition      + EPSILON,   # Selbsterkennung
        ])
        # Bridge: wenn beide Seiten gleichzeitig kohÃ¤rent â†’ DurchlÃ¤ssigkeit entsteht
        _bridge_target = safe_geomean([
            s.linear_outer_coherence + EPSILON,
            s.radial_inner_coherence + EPSILON,
            dao.dao_score            + EPSILON,
            obs_eff_local            + EPSILON,
        ])
        s.dao_gravity_bridge = lerp(s.dao_gravity_bridge, _bridge_target, rate)

        # outer_receives_inner / inner_receives_outer: DAO-Gravitation als RATE.
        # Das ist der Kernunterschied: nicht Score, sondern DurchlÃ¤ssigkeit.
        # Je hÃ¶her dao_gravity_bridge, desto schneller lernen AuÃŸen und Innen voneinander.
        # Bei bridge=0.78: Rate â‰ˆ COHERENCE_RATE Ã— 0.78 â‰ˆ 0.022 (Ï„ â‰ˆ 45 Steps)
        # Das ist die Zeitskala auf der AuÃŸenperspektive und Innenperspektive sich annÃ¤hern.
        _bridge_rate = COHERENCE_RATE * s.dao_gravity_bridge
        if not hasattr(s, 'outer_receives_inner'): s.outer_receives_inner = 0.5
        if not hasattr(s, 'inner_receives_outer'): s.inner_receives_outer = 0.5
        s.outer_receives_inner = lerp(
            s.outer_receives_inner, s.radial_inner_coherence, _bridge_rate
        )
        s.inner_receives_outer = lerp(
            s.inner_receives_outer, s.linear_outer_coherence, _bridge_rate
        )
        # Observer-Position von den Membranen Ã¼bernehmen
        s.observer_at_12_1 = membrane.observer_at_12_1 if hasattr(membrane, 'observer_at_12_1') else obs_eff_local
        s.observer_at_8_9  = membrane.observer_at_8_9  if hasattr(membrane, 'observer_at_8_9')  else obs_eff_local

        # membrane_realization (ChatGPT Punkt 10): die vollstÃ¤ndige Kopplung.
