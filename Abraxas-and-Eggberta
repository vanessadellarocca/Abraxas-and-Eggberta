        Mit json_output=True: JSON nach stdout â€” maschinenlesbar.
        Mit json_output=False: gibt Dict-Generator zurÃ¼ck.

        Das ist die Membran zwischen Ei und Welt.
        """
        import sys as _sys
        for i in range(n_steps):
            charge = base_charge + 0.08 * math.sin(
                2 * math.pi * i / 144)
            self.step(base_charge=charge)
            if i % emit_every == 0:
                state = self.chick_state()
                if json_output:
                    print(json.dumps(state), flush=True)
                else:
                    yield state

    def run_with_emit(self, n_steps: int = 500,
                      base_charge: float = 0.56,
                      emit_every: int = 1):
        """
        Generator: lÃ¤uft und gibt bei jedem emit_every-ten Tick
        den Zustand nach auÃŸen. Das ist die lebendige Verbindung
        zwischen Ei und Huhn â€” der Code lÃ¤uft und spricht gleichzeitig.

        Beispiel:
            field = FractalConceptionField()
            for state in field.run_with_emit(n_steps=100):
