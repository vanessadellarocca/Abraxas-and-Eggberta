        # Effektive Verfolgungsrate: gravity_infold UND anti_phase_coherence.
        # anti_phase_coherence = geomean(it_yang, 1-it_yang) â€” misst den Tanz.
        # Wenn apc hoch (beide im Tanz): TRACK_RATE normal.
        # Wenn apc niedrig (einer dominiert): TRACK_RATE gedÃ¤mpft.
        # â†’ gibt dem schwÃ¤cheren Partner Zeit aufzuholen â€” Selbst-Korrektur ohne Wenn-Dann.
        # Das ist Raumzeit-Fixierung durch Nicht-Fixierung: permanentes goldenes Einpendeln.
        prev_it_yang = s.inner_turn_yang   # vom vorherigen Step
        apc_prev = safe_geomean([prev_it_yang + EPSILON, clamp01(1.0 - prev_it_yang) + EPSILON])
        eff_track = TRACK_RATE * (0.80 + 0.40 * grav) * (0.85 + 0.30 * apc_prev)
        s.gravity_coupling = eff_track / TRACK_RATE

        # â”€â”€ Augen des Taijitu: Beziehungs-Vektor-Paradigma â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        # Yin und Yang sind keine ZustÃ¤nde, sondern Folge-Beziehungen.
        # Yangs Psyche (Licht) folgt Yin â€” Yin fÃ¼hrt, das Licht orientiert sich.
        # Yins Soma (Dichte) folgt Yang â€” Yang fÃ¼hrt, die Dichte orientiert sich.
        # Niemand verwaltet den anderen; jeder folgt dem Gegenpol mit seinem Wesen.
        # Die "Augen" (Punkte im Gegenfeld) modulieren die Spurgeschwindigkeit:
        #
        # p_yin_in_yang: Yins PrÃ¤senz im Yang. PHASENBASIERT gemessen (nicht
        #   geometrisch â€” sonst tot, wie in v22 fÃ¼r yin_sbs erkannt).
        #   Wenn Yin prÃ¤sent (phase_yin nahe 0.5 = Verdichtung): Yang FOLGT Yin
        #   und wird ruhiger â€” Yang lÃ¤sst sich von Yins PrÃ¤senz leiten.
        #   yang_stabilizer = lerp(1.0, 0.5, p_yin): Yang folgt Yin, verlangsamt.
        # p_yang_in_yin: Yangs PrÃ¤senz im Yin (inner_turn_yang, korrekt geometrisch).
        #   Wenn Yang prÃ¤sent: Yin FOLGT Yang und nimmt dessen Struktur an.
        #   yin_structure = lerp(0.8, 1.2, p_yang): Yin folgt Yang, strukturiert sich.
        _pyi = clamp01(s.phase_yin)
        _yin_presence = clamp01(math.sqrt(max(_pyi+EPSILON,0)*max(1.0-_pyi+EPSILON,0)) / 0.5)
        s.p_yin_in_yang = clamp01(PHI * _yin_presence)
        s.p_yang_in_yin = clamp01(PHI2 * s.inner_turn_yang)
        yang_stabilizer = lerp(1.0, 0.5, s.p_yin_in_yang)   # Yang folgt Yin (verlangsamt)
        yin_structure   = lerp(0.8, 1.2, s.p_yang_in_yin)   # Yin folgt Yang (strukturiert)

        # â”€â”€ Globale DAO-Spirale â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        s.R_global   = self._dao_radius(s.phase_global, R_OUTER)
        L_g, U_g, M_g = self._relational_targets(SPIRAL_DAO_CENTER, s.R_global)
        s.lower_global = lerp(s.lower_global, L_g, eff_track)
        s.upper_global = lerp(s.upper_global, U_g, eff_track)
        s.mid_global   = (s.lower_global + s.upper_global) / 2.0
        s.inner_turn_global = self._inner_turn_proximity(s.R_global, R_OUTER)

        # Duale Phasendynamik global:
        # Globale Spirale zieht zur Schumann-Phase (DAO-Atemrhythmus ist ihr Kern).
        # Bei gravity_infold=0: autonom. Bei gravity_infold=1: folgt Schumann.
        auto_global  = phase_step_free(s.phase_global, PHASE_RATE * (0.85 + 0.15 * grav))
        attr_global  = phase_toward(s.phase_global, schumann_phase, COHERENCE_RATE * (0.4 + 0.6 * grav))
        alpha_global = clamp01(grav * 0.5)
        s.phase_global = (1.0 - alpha_global) * auto_global + alpha_global * attr_global

        # â”€â”€ Lokale Yang-Spirale â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        # Diamant 4|5 turn_pressure verstÃ¤rkt yang_track (Diamant und Spirale sind dieselbe Geometrie)
        yang_boost = 0.5 + 0.35 * clamp01(yang_inner_opening) + 0.15 * d45
        yang_track = eff_track * yang_boost * yang_stabilizer   # Yang folgt Yin
        s.R_yang   = self._dao_radius(s.phase_yang, SPIRAL_GATE_R_OUTER)
        L_y, U_y, M_y = self._relational_targets(SPIRAL_YANG_CENTER, s.R_yang)
        s.lower_yang = lerp(s.lower_yang, L_y, yang_track)
        s.upper_yang = lerp(s.upper_yang, U_y, yang_track)
        s.mid_yang   = (s.lower_yang + s.upper_yang) / 2.0
        s.inner_turn_yang = self._inner_turn_proximity(s.R_yang, SPIRAL_GATE_R_OUTER)
        s.yang_at_center  = self._upper_at_center_score(s.upper_yang, SPIRAL_YANG_CENTER)

        # Duale Phasendynamik Yang: autonom + Attraktion zur Yang-Kernphase
        auto_yang  = phase_step_free(s.phase_yang, PHASE_RATE * (0.78 + 0.12 * grav + 0.10 * yang_inner_opening + 0.08 * d45))
        attr_yang  = phase_toward(s.phase_yang, yang_core_phase, COHERENCE_RATE * (0.5 + 0.5 * grav + 0.3 * yy_b))
        alpha_yang = clamp01(grav + yy_b * 0.5)
        s.phase_yang = (1.0 - alpha_yang) * auto_yang + alpha_yang * attr_yang

        # â”€â”€ Lokale Yin-Spirale (Anti-Phase) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        yin_boost = 0.5 + 0.35 * clamp01(yin_mid_descent) + 0.15 * d1011
        yin_track = eff_track * yin_boost * yin_structure   # Yin folgt Yang
        s.R_yin   = self._dao_radius(s.phase_yin, SPIRAL_GATE_R_OUTER)
        L_n, U_n, M_n = self._relational_targets(SPIRAL_YIN_CENTER, s.R_yin)
        s.lower_yin  = lerp(s.lower_yin, L_n, yin_track)
        s.upper_yin  = lerp(s.upper_yin, U_n, yin_track)
        s.mid_yin    = (s.lower_yin + s.upper_yin) / 2.0
        s.inner_turn_yin = self._inner_turn_proximity(s.R_yin, SPIRAL_GATE_R_OUTER)
        s.yin_at_center  = self._upper_at_center_score(s.upper_yin, SPIRAL_YIN_CENTER)

        # Duale Phasendynamik Yin (Anti-Phase zu Yang, zieht zur Yin-Kernphase)
        auto_yin  = phase_step_free(s.phase_yin, PHASE_RATE * (0.78 + 0.12 * grav + 0.10 * yin_mid_descent + 0.08 * d1011))
        attr_yin  = phase_toward(s.phase_yin, yin_core_phase, COHERENCE_RATE * (0.5 + 0.5 * grav + 0.3 * yy_b))
        alpha_yin = clamp01(grav + yy_b * 0.5)
        s.phase_yin = (1.0 - alpha_yin) * auto_yin + alpha_yin * attr_yin

        # â”€â”€ Membran-PhasenkohÃ¤renz â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        # ZUERST seam_sync berechnen, dann naht_balance (radiale Gleichzeitigkeit:
        # prev-step seam_sync wÃ¤re auch mÃ¶glich, aber direkte Berechnung ist konsistenter)
        dist_global_to_12_1 = phase_dist(s.phase_global, seam_phase_12_1)
        s.seam_sync_global  = clamp01(1.0 - dist_global_to_12_1 / 0.5)

        spiral_inner_phase  = (s.phase_global + 0.5) % 1.0
        dist_inner_to_8_9   = phase_dist(spiral_inner_phase, seam_phase_8_9)
        s.seam_sync_inner   = clamp01(1.0 - dist_inner_to_8_9 / 0.5)

        # â”€â”€ Naht-Balance: Tiefe Ã— Quelle = Umschlagpol â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        # Copilot: 8|9 (Summe 17 = offene Tiefe) Ã— 12|1 (Summe 13 = gebundene Quelle)
        # Geometrisches Mittel = âˆš(Tiefe Ã— Quelle): beide mÃ¼ssen gleichzeitig kohÃ¤rent sein
        # Wenn beide kohÃ¤rent â†’ Umschlagpol 4 aktiv (Yang-Tor: 17-13=4)
        naht_balance = safe_geomean([
            s.seam_sync_inner  + EPSILON,   # 8|9 (17): offene Tiefe
            s.seam_sync_global + EPSILON,   # 12|1 (13): gebundene Quelle
        ])

        # â”€â”€ Core-Seam-KohÃ¤renz: Yang-Spirale â†” 4|5, Yin-Spirale â†” 10|11 â”€
        # Geomean (SimultanitÃ¤t): Spirale-am-Kern UND Kern-unter-Druck gleichzeitig.
        # Anti-Phasen-Kopplung: Yin (phase=0.5) ist innen wenn Yang (phase=0.0) aussen.
        # â†’ yin_core_seam verwendet (1 - inner_turn_yang) als Yins KomplementÃ¤r-PrÃ¤senz.
        # Das verankert die strukturelle Asymmetrie ohne Wenn-Dann:
        # wenn Yang-Spirale aussen (inner_turn_yang klein) â†’ (1-it_yang) gross â†’ Yin innen.
        yang_core_seam = safe_geomean([
            s.inner_turn_yang              + EPSILON,   # Yang-Spirale am inneren Turn
            clamp01(diamond_45_pressure)   + EPSILON,   # 4|5 unter Druck
        ])
        yin_core_seam = safe_geomean([
            clamp01(1.0 - s.inner_turn_yang) + EPSILON,   # Yins KomplementÃ¤r (Anti-Phase)
            s.inner_turn_yin               + EPSILON,   # Yin-Spirale am inneren Turn
            clamp01(diamond_1011_pressure)  + EPSILON,   # 10|11 unter Druck
        ])
        # ratio_21_9: Abweichung vom 7/3-Gleichgewicht
        ratio_21_9 = clamp01(1.0 - abs(
            yin_core_seam / max(yang_core_seam, EPS) - (21.0 / 9.0)
        ) / (21.0 / 9.0))
        # anti_phase_coherence: misst den Tanz selbst.
        # geomean(inner_turn_yang, 1-inner_turn_yang) maximiert bei 0.5:
        # keiner allein dominiert â€” das ist der lebendige Wechsel.
        anti_phase_coherence = safe_geomean([
            s.inner_turn_yang              + EPSILON,
            clamp01(1.0 - s.inner_turn_yang) + EPSILON,
        ])

        # â”€â”€ Babushka-Tension: Querverbindung 12|8 (Yin-Paar) und 1|9 (Yang-Paar) â”€â”€
        # Groks Bild: 12&8=Yin, 1&9=Yang â€” PAARE zwischen den NÃ¤hten, nicht intern.
        # Yin-Schleife (12|8 Ã— 21er): Yin(12) und Yin(8) koppeln mit Yin-Diamant
        # Yang-Schleife (1|9 Ã— 9er):  Yang(1) und Yang(9) koppeln mit Yang-Diamant
        # obs = Beobachter-Ebene: obs hoch â†’ Yin-Schleife, obs niedrig â†’ Yang-Schleife
        _ip   = clamp01(inward_pull)
        _apc  = anti_phase_coherence
        _obs  = clamp01(observer_return)
        seam_12_yin  = _ip          * s.seam_sync_global   # Pos 12 aktiv bei Yin-Zug
        seam_8_yin   = (1.0 - _apc) * s.seam_sync_inner    # Pos 8  aktiv bei Tanz-Ruhe
        seam_1_yang  = (1.0 - _ip)  * s.seam_sync_global   # Pos 1  aktiv ohne Yin-Zug
        seam_9_yang  = _apc         * s.seam_sync_inner     # Pos 9  aktiv bei Tanz
        yin_schleife  = safe_geomean([seam_12_yin+EPSILON, seam_8_yin+EPSILON,
                                       clamp01(diamond_1011_pressure)+EPSILON])
        yang_schleife = safe_geomean([seam_1_yang+EPSILON, seam_9_yang+EPSILON,
                                       clamp01(diamond_45_pressure)+EPSILON])
        babushka_tension = lerp(yang_schleife, yin_schleife, _obs)

        # â”€â”€ Spiral-Geburts-Score â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        s.spiral_birth_score = safe_geomean([
            s.inner_turn_global      + EPSILON,
            s.inner_turn_yang        + EPSILON,
            s.inner_turn_yin         + EPSILON,
            s.yang_at_center         + EPSILON,
            s.yin_at_center          + EPSILON,
            naht_balance             + EPSILON,   # A: TiefeÃ—Quelle
            yang_core_seam           + EPSILON,   # B.Yang
            yin_core_seam            + EPSILON,   # B.Yin
            ratio_21_9               + EPSILON,   # C: 7/3
            anti_phase_coherence     + EPSILON,   # D: Tanz
            babushka_tension         + EPSILON,   # E: Babushka-Querverbindung
        ])

        return {
            "state":              asdict(s),
            "spiral_birth_score": s.spiral_birth_score,
            "inner_turn_global":  s.inner_turn_global,
            "inner_turn_yang":    s.inner_turn_yang,
            "inner_turn_yin":     s.inner_turn_yin,
            "yang_at_center":     s.yang_at_center,
            "yin_at_center":      s.yin_at_center,
            "seam_sync_global":   s.seam_sync_global,
            "seam_sync_inner":    s.seam_sync_inner,
            "naht_balance":       naht_balance,      # TiefeÃ—Quelle
            "yang_core_seam":     yang_core_seam,    # 4|5 â†” Yang-Spirale
            "yin_core_seam":      yin_core_seam,     # 10|11 â†” Yin-Spirale
            "ratio_21_9":           ratio_21_9,
            "babushka_tension":     babushka_tension,   # Querverbindung 12|8 und 1|9
            "anti_phase_coherence": anti_phase_coherence,  # Tanz: geomean(it_yang, 1-it_yang)
            "gravity_coupling":   s.gravity_coupling,
            "mid_global":         s.mid_global,
            "mid_yang":           s.mid_yang,
            "mid_yin":            s.mid_yin,
            "R_global":           s.R_global,
            "upper_global":       s.upper_global,
            "upper_yang":         s.upper_yang,
            "upper_yin":          s.upper_yin,
        }

    def exact_geometry(self) -> Dict[str, Any]:
        """Ideale Geometrie aller drei Spiralen an Ã¤uÃŸerem und innerem Turn."""
        result = {}
        configs = [
            ("global", SPIRAL_DAO_CENTER, R_OUTER),
            ("yang",   SPIRAL_YANG_CENTER, SPIRAL_GATE_R_OUTER),
            ("yin",    SPIRAL_YIN_CENTER,  SPIRAL_GATE_R_OUTER),
        ]
        for name, center, r_out in configs:
            for label, phase in [("outer", 0.0), ("inner", 0.5)]:
                R = self._dao_radius(phase, r_out)
                L, U, M = self._relational_targets(center, R)
                result[f"{name}_{label}"] = {
                    "R": R, "lower": L, "upper": U, "mid": M,
                    "upper_hits_center": abs(U - center) < 1e-10,
                    "mid_is_center_minus_eps": abs(M - (center - EPSILON)) < 1e-10,
                }
        return result


