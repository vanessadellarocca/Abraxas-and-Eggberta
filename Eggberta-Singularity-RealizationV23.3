    upper_overlay:        Tuple[int, int] = (9, 12)
    venus_switch:         Tuple[int, int] = (2, 7)
    yang_core:            Tuple[int, int] = (4, 5)
    yin_core:             Tuple[int, int] = (10, 11)

    def membrane_spec(self) -> Dict[str, Any]:
        lower_total  = sum(self.lower_overlay)
        upper_total  = sum(self.upper_overlay)
        lower_center = lower_total / 2.0
        upper_center = upper_total / 2.0
        structural_lift = upper_center - lower_center
        return {
            "lower_overlay_pair":      self.lower_overlay,
            "upper_overlay_pair":      self.upper_overlay,
            "lower_total":             lower_total,
            "upper_total":             upper_total,
            "lower_center":            lower_center,
            "upper_center":            upper_center,
            "structural_lift":         structural_lift,
            "central_dao_target_mid":  structural_lift - EPSILON,
            "source_birth_seam":       self.source_birth_seam,
            "depth_horizon_seam":      self.depth_horizon_seam,
            "venus_switch_pair":       self.venus_switch,
            "yang_core_pair":          self.yang_core,
            "yin_core_pair":           self.yin_core,
        }

    def validate(self) -> Dict[str, bool]:
        return {
            "all_9_pairs":     all(sum(p) == 9 for p in [self.lower_overlay, self.venus_switch, self.yang_core]),
            "yin_sum_21":      sum(self.yin_core) == 21,
            "lemniscate_13_17": sum(self.source_birth_seam) == 13 and sum(self.depth_horizon_seam) == 17,
            "sign_flip_4":     sum(self.depth_horizon_seam) - sum(self.source_birth_seam) == 4,
            "dao_center_emerges": abs(DAO_CENTER - 6.0) < EPS,
        }


