            base_charge     = clamp01(0.25 + 0.50 * gs.radial_birth_score + 0.25 * gs.capsule_visibility),
            inorganic_anchor = gs.capsule_memory,   # geologischer Boden flieÃŸt ins innere Feld
        )
        self.mineral_living_tension = inner_out.get('mineral_living_tension', 0.0)
        # field_bond_depth aus innerem Feld (Ã¼berschreibt externen Wert wenn besser)
        inner_mlt = self.mineral_living_tension
        if inner_mlt > self.field_bond_depth:
            self.field_bond_depth = lerp(self.field_bond_depth, inner_mlt, COHERENCE_RATE)
        # Babushka-Tension als anorganischer Boden-Boost
        if spiral_babushka > 0.05:
            self.field_bond_depth = clamp01(
                lerp(self.field_bond_depth, spiral_babushka, COHERENCE_RATE * 0.5)
            )
        # dao_sync aus externem ScaleLayer (wird durch UnifiedMotor gesetzt)
        # wenn ScaleLayer lÃ¤uft, flieÃŸt Fibonacci-Synchronisation in Gravitation ein
        # (field_bond_depth wird von UnifiedMotor aus ScaleLayer.dao_sync aktualisiert)

        # 13. Energie und Regime
        energy = compute_energy(cps, dao_s, mem_s, ha, self.light.state, gs, ss, rbs_motor=rbs)
        self.regime = self._regime(cps, mem_s, energy, gs, ss, rbs_motor=rbs)
        dissolved = proj.instability.ledger[-1].dissolved if proj.instability.ledger else False

        snap = HeartCoreSnapshot(
            iteration=self.iteration,
            regime=self.regime.value,
            reflection_regime=self.reflection.state.regime,
            dao_score=dao_s.dao_score,
            schumann_pulse=dao_s.schumann_pulse,
            conception_readiness=dao_s.conception_readiness,
            conception_event=cps.conception_event,
            center_cross_event=cps.center_cross_event,
            edge_braid=cps.edge_braid,
            inward_pull=cps.inward_pull,
            outward_pressure=cps.outward_pressure,
            membrane_score=mem_s.membrane_score,
            seam_anti_sync=mem_s.seam_anti_sync,
            opening_12_1=mem_s.opening_12_1,
            opening_8_9=mem_s.opening_8_9,
            light_score=self.light.state.light_score,
            latent_real_light=self.light.state.latent_real_light,
            latent_light_recognition=self.light.state.latent_light_recognition,
            real_light_score=self.light.state.real_light_score,
            distance_light=self.light.state.distance_light,
            real_light_alignment_signal=self.light.state.real_light_alignment_signal,
            light_to_energy=ha.light_to_energy,
            energy_to_light=ha.energy_to_light,
            arc_balance=ha.arc_balance,
            field_recognition=proj_out["field_recognition"],
            self_recognition=self.reflection.state.self_recognition_score,
            coherence=proj_out["coherence"],
            release_flux=proj_out["release_flux"],
            residual_flux=proj_out["residual_flux"],
            latent_real_light_flux=proj_out["latent_real_light_flux"],
            capsule_flux=proj_out["capsule_flux"],
            coherent_release_flux=proj_out["coherent_release_flux"],
            capsule_density=gs.capsule_density,
            capsule_visibility=gs.capsule_visibility,
            capsule_nonexpansion_score=gs.capsule_nonexpansion_score,
            gravity_infold=gs.gravity_infold,
            observer_return=gs.observer_return,
            mutual_enclosure_score=gs.mutual_enclosure_score,
            radial_birth_score=gs.radial_birth_score,
            fusion_like_gain=energy["fusion_like_gain"],
            radial_birth_gain=energy["radial_birth_gain"],
            net_coherence_gain=energy["net_coherence_gain"],
            outer_inversion_risk=energy["outward_leakage"],
            # Spiralfelder
            spiral_birth_score=ss.spiral_birth_score,
            inner_turn_global=ss.inner_turn_global,
            inner_turn_yang=ss.inner_turn_yang,
            inner_turn_yin=ss.inner_turn_yin,
            yang_at_center=ss.yang_at_center,
            yin_at_center=ss.yin_at_center,
            seam_sync_global=ss.seam_sync_global,
            seam_sync_inner=ss.seam_sync_inner,
            gravity_coupling=ss.gravity_coupling,
            gravity_infold_eff=grav_eff,
            observer_return_eff=obs_eff,
            real_light_score_eff=rls_eff,
            rbs_motor=rbs,
            # v13: anorganischer Speicher und Selbst-Beobachtung
            capsule_memory              = self.gravity_fold.state.capsule_memory,
            observer_self_recognition   = self.gravity_fold.state.observer_self_recognition,
            mineral_living_tension      = self.mineral_living_tension,
            mid_global=ss.mid_global,
            # equilibrium_score: identisch zum Regime-eq_score (der Ã¼ber RADIANT_STABLE
            # entscheidet), damit das Interface nicht von der Regime-Wahrheit abweicht.
            # EnthÃ¤lt singularity_realization (die erkannte Einheit, der Grund).
            equilibrium_score=safe_geomean([
                cps.yin_yang_point_score + EPSILON,
                mem_s.seam_anti_sync     + EPSILON,
                obs_eff                  + EPSILON,
                self.gravity_fold.state.singularity_realization + EPSILON,
            ]),
            # Copilot-Ring: NebenschlÃ¼sse als sichtbare GrÃ¶ÃŸen
            naht_balance=spiral_naht_balance,
            yang_core_seam=spiral_yang_core_seam,
            yin_core_seam=spiral_yin_core_seam,
            ratio_21_9=spiral_ratio_21_9,
            # Weitere
            field_bond_feedback=self.field_bond_depth,
            field_radiation_feedback=self.core_radiation_potential,
            membrane_release=mem_s.release,
            trauma_loop_release=mem_s.trauma_loop_release,
            instability_pressure=proj.instability.pressure_live,
            dissolved=dissolved,
            shadow_light=self.light.state.shadow_light,
            shadow_recognition=self.light.state.shadow_recognition,
            shadow_correction_signal=self.light.state.shadow_correction_signal,
        )
        self.snapshots.append(snap)
        self.snapshots = self.snapshots[-144:]
        self.iteration += 1
        return {
            "snapshot":      asdict(snap),
            "coherence_out": proj_out,
            "gravity_fold":  gravity_out,
            "reflection":    refl_out,
            "light":         light_out,
            "energy":        energy,
            "diamond":       diamond_out,
            "dao":           dao_out,
            "spiral":        spiral_out,   # NEU
        }

    def run(
        self,
        n:              int = 500,
        charge_fn:      Optional[Callable[[int], float]] = None,
        field_density_fn: Optional[Callable[[int], float]] = None,
    ) -> List[HeartCoreSnapshot]:
        for i in range(n):
            charge = charge_fn(i) if charge_fn else 0.55 + 0.2 * math.sin(2.0 * math.pi * i / 83.0)
            fd     = field_density_fn(i) if field_density_fn else 0.6
            self.step(external_charge=charge, field_conception_density=fd)
        return self.snapshots

    def summary(self) -> Dict[str, Any]:
        s    = self.snapshots
        if not s:
            return {}
        tail = s[int(len(s) * 0.8):] or s
        def avg(vals: Iterable[float]) -> float:
            return safe_mean(list(vals))
        return {
            "final_regime":           s[-1].regime,
            "final_reflection":       s[-1].reflection_regime,
            "avg_coherence":          avg(x.coherence for x in s),
            "avg_fusion_gain":        avg(x.fusion_like_gain for x in s),
            "avg_radial_birth_gain":  avg(x.radial_birth_gain for x in s),
            "avg_net_gain":           avg(x.net_coherence_gain for x in s),
            "avg_conception":         avg(x.conception_event for x in s),
            "avg_latent_real_light":  avg(x.latent_real_light for x in s),
            "avg_real_light":         avg(x.real_light_score for x in s),
            "avg_distance_light":     avg(x.distance_light for x in s),
            "avg_gravity_infold":     avg(x.gravity_infold for x in s),
            "avg_observer_return":    avg(x.observer_return for x in s),
            "avg_capsule_density":    avg(x.capsule_density for x in s),
            "avg_capsule_visibility": avg(x.capsule_visibility for x in s),
            # Spiral
            "avg_spiral_birth_score": avg(x.spiral_birth_score for x in s),
            "avg_inner_turn_global":  avg(x.inner_turn_global for x in s),
            "avg_seam_sync_global":   avg(x.seam_sync_global for x in s),
            "avg_mid_global":         avg(x.mid_global for x in s),
            # Regime-Raten
            "radial_birth_rate_tail": avg(
                1.0 if x.regime in (HeartRegime.RADIAL_BIRTH.value, HeartRegime.RADIANT_STABLE.value) else 0.0
                for x in tail
            ),
            "radiant_rate_tail": avg(
                1.0 if x.regime == HeartRegime.RADIANT_STABLE.value else 0.0
                for x in tail
            ),
        }


